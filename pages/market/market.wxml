<view class="page">

<!-- 顶部 -->
<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content">
    <text class="nav-title">二手市场</text>
    <view class="nav-right"></view>
  </view>
</view>

<!-- 搜索 -->
<view class="search-row">
  <view class="search-box">
    <input
      class="search-input"
      value="{{keyword}}"
      placeholder="搜索您喜欢的商品"
      placeholder-class="ph"
      bindinput="onKeywordInput"
      confirm-type="search"
      bindconfirm="onSearch"
    />
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>
</view>

<!-- 顶部筛选条：区域/分类放左侧，右侧接「我的商品」 -->
<view class="filter-row">
  <view class="filter-left-group">
    <text class="filter-left">分类</text>
    <text class="filter-arrow">▶</text>

    <!-- 区域 -->
    <view class="filter-pill" bindtap="onTapRegion">
      <text class="pill-text">{{activeRegion==='全部'?'区域':activeRegion}}</text>
      <text class="pill-caret">▼</text>
    </view>

    <!-- 价格（改成和区域一样的框） -->
    <view class="filter-pill" bindtap="onTogglePriceSort">
      <text class="pill-text"> {{priceSortOrder === 'asc' ? '价格↑' : (priceSortOrder === 'desc' ? '价格↓' : '价格')}}
      </text>
    </view>

  </view>

  <view class="my-btn" bindtap="onMyGoods">我的商品</view>
</view>

<!-- 主体：左分类（窄） + 右商品（滚动） -->
<view class="main">

  <!-- 左侧分类 -->
  <view class="left">
    <scroll-view class="cat-scroll" scroll-y>
      <view
        class="cat-item {{activeCategory===item?'active':''}}"
        wx:for="{{categories}}"
        wx:key="*this"
        data-cat="{{item}}"
        bindtap="onSelectCat"
      >
        {{item}}
      </view>

      <view class="line-placeholder" wx:for="{{10}}" wx:key="*this"></view>
    </scroll-view>
  </view>

  <!-- 右侧商品：唯一滚动区域 -->
  <view class="right">
    <scroll-view class="goods-scroll" scroll-y lower-threshold="120" bindscrolltolower="onGoodsScrollToLower">
      <view class="grid">
        <view
          class="card"
          wx:for="{{displayGoods}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onTapItem"
        >
          <view class="card-img">
            <image
              wx:if="{{item.hasImage}}"
              class="thumb"
              lazy-load="true"
              src="{{item.thumbUrl || item.thumbFileID || item.imageFileID || '/images/market.png'}}"
              mode="aspectFill"
            />
            <view wx:else class="thumb text-thumb">
              <text>{{item.title}}</text>
            </view>
            <view class="goods-label">
              {{item.title}}: ${{item.price}}
            </view>
          </view>
        </view>
      </view>

      <view class="view-more" wx:if="{{canViewMore}}" bindtap="onViewMore">
        查看更多<text class="caret">▼</text>
      </view>

      <view class="bottom-spacer"></view>
    </scroll-view>
  </view>

</view>

<!-- 底部固定：只保留「卖闲置」 -->
<view class="bottom-fixed">
  <view class="sell-btn" bindtap="onSellIdle">卖闲置</view>
</view>

<!-- 地区三列滚动选择器 -->
<view wx:if="{{regionPickerVisible}}">
  <view class="rp-mask" bindtap="onRegionPickerCancel"></view>

  <view class="rp-panel" catchtouchmove="stopTouchMove">
    <view class="rp-header">
      <text class="rp-btn" bindtap="onRegionPickerCancel">取消</text>
      <text class="rp-title">选择地区</text>
      <text class="rp-btn ok" bindtap="onRegionPickerConfirm">确定</text>
    </view>

    <picker-view
      class="rp-picker"
      indicator-style="height: 44px;"
      value="{{regionPickerValue}}"
      bindchange="onRegionPickerChange"
    >
      <picker-view-column>
        <view class="rp-item" wx:for="{{regionCol1}}" wx:key="*this">{{item}}</view>
      </picker-view-column>

      <picker-view-column>
        <view class="rp-item" wx:for="{{regionCol2}}" wx:key="*this">{{item}}</view>
      </picker-view-column>

      <picker-view-column>
        <view class="rp-item" wx:for="{{regionCol3}}" wx:key="*this">{{item}}</view>
      </picker-view-column>
    </picker-view>
  </view>
</view>

</view>
