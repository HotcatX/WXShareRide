<view class="ride-shell feedback-page">
  <view class="ride-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar ride-topbar--center">
      <view class="ride-back" bindtap="goBack" hover-class="ride-pressed">
        <image class="ride-back-icon" src="/images/back.png" mode="aspectFit" />
      </view>
      <text class="ride-nav-title">{{pageTitle}}</text>
    </view>
  </view>

  <view wx:if="{{toastVisible}}" class="toast-bar {{toastType}}">
    <text class="toast-icon">{{toastIcon}}</text>
    <text class="toast-text">{{toastText}}</text>
  </view>

  <scroll-view class="ride-scroll feedback-scroll" scroll-y enable-flex>
    <view class="ride-card ride-card-pad feedback-card">
      <view class="feedback-form">
        <view class="ride-field feedback-field">
          <text class="ride-field-label">邮箱</text>
          <input class="ride-input feedback-input"
                 type="text"
                 value="{{email}}"
                 bindinput="onEmailInput"
                 placeholder="请输入邮箱地址"
                 placeholder-class="ride-placeholder" />
        </view>

        <view class="ride-field feedback-field">
          <text class="ride-field-label">手机号</text>
          <view class="phone-row">
            <picker class="phone-picker"
                    mode="selector"
                    range="{{regionOptions}}"
                    bindchange="onRegionChange">
              <view class="phone-picker-value">{{regionLabel}}</view>
            </picker>

            <input class="ride-input feedback-input phone-input"
                   type="number"
                   value="{{phone}}"
                   bindinput="onPhoneInput"
                   placeholder="请输入手机号"
                   placeholder-class="ride-placeholder" />
          </view>
        </view>

        <view class="ride-field ride-field--full feedback-field feedback-field--textarea">
          <text class="ride-field-label">反馈内容</text>
          <textarea class="ride-textarea feedback-textarea"
                    value="{{content}}"
                    bindinput="onContentInput"
                    placeholder="请输入您的意见或建议"
                    placeholder-class="ride-placeholder" />
        </view>

        <button class="ride-btn ride-primary ride-btn--primary feedback-submit" bindtap="submitFeedback" hover-class="ride-pressed">提交反馈</button>
      </view>
    </view>
  </scroll-view>
</view>
