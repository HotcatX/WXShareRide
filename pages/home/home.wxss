page{
  background: #f7efe9;
}

.content{
  padding: 14rpx 24rpx calc(env(safe-area-inset-bottom) + 140rpx);
  background: #f7efe9;
  box-sizing: border-box;
}

.nav-bar{
  width: 100%;
  background: #fff;
}

.nav-content{
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
  box-sizing: border-box;
}

.nav-left{
  width: 260rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  z-index: 2;                    }

.nav-right{
  width: 260rpx;
  height: 1px;
}

.nav-title{
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
  max-width: 70%;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  z-index: 1;
}

.nav-login-btn{
  height: 64rpx;
  line-height: 56rpx;
  font-size: 26rpx;
  padding: 0 18rpx;              min-width: 190rpx;             border-radius: 999rpx;
  background: #179E16;
  color: #fff;
  margin: 0;
  box-sizing: border-box;
}

.nav-login-btn::after{
  border: none;
}

.nav-login-btn.disabled{
  background: #cfcfcf;
  color: #666;
}

.hero-grid{
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin: 32rpx 0 22rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
}

.hero-btn{
  width: 280rpx;
  height: 280rpx;
  border-radius: 44rpx;
  overflow: hidden;
}

.hero-img{
  width: 100%;
  height: 100%;
  display: block;
}

.trip-canvas{
  width: 95%;
  margin: 0 auto;
}

.section-box{
  background: #fff;
  border-radius: 26rpx;
  padding: 10rpx 12rpx;          margin-top: 18rpx;             box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
  box-sizing: border-box;
}

.section-head{
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sub-title{
  font-size: 28rpx;
  font-weight: 800;
  color: #111;
}

.section-action{
  display: flex;
  align-items: center;
  padding: 4rpx 8rpx;            color: #999;
}

.action-text{
  font-size: 26rpx;
}

.section-bar{
  padding-bottom: 0 !important;
}

.section-bar .trip-fixed{
  display: none;
}

.trip-fixed{
  overflow: hidden;
  margin-top: 10rpx;             }

.trip-fixed--collapse{
  height: 116rpx;                }

.trip-fixed--expand{
  height: 348rpx;                }

.trip-empty-slot{
  height: 116rpx;                display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 26rpx;
}

.trip-item{
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 10rpx;
}

.trip-badge{
  width: 78rpx;
  height: 78rpx;
  flex: 0 0 78rpx;
  display: block;
}

.trip-card{
  flex: 1;
  background: #dfe8d2;
  border-radius: 22rpx;
  padding: 10rpx 12rpx;
  box-sizing: border-box;
}

.trip-row1{
  display: flex;
  align-items: center;
  line-height: 1.15;
}

.trip-place{
  font-size: 28rpx;
  font-weight: 700;
  color: #111;
  max-width: 44%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.trip-arrow{
  margin: 0 10rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #111;
}

.trip-row2{
  margin-top: 6rpx;
  line-height: 1.15;
}

.trip-time{
  font-size: 24rpx;
  color: #222;
  opacity: 0.9;
}

.community-stats-section{
  margin-top: 30rpx;
}

.community-stats-head{
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin: 6rpx 4rpx 12rpx;
}

.community-stats-title{
  font-size: 30rpx;
  font-weight: 800;
  color: #111;
}

.community-stats-card{
  min-height: 238rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f8fbf2 100%);
  box-sizing: border-box;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(0,0,0,0.08);
}

.community-stats-main{
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.community-stats-label{
  font-size: 24rpx;
  color: #5d6948;
  font-weight: 700;
}

.community-stats-number-row{
  margin-top: 6rpx;
  display: flex;
  align-items: flex-end;
  gap: 10rpx;
}

.community-stats-number{
  font-size: 62rpx;
  line-height: 1;
  font-weight: 900;
  color: #111;
}

.community-stats-unit{
  margin-bottom: 6rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #6f7e52;
}

.community-stats-subtitle{
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7a7a7a;
  line-height: 1.35;
}

.community-stats-grid{
  width: 268rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.community-stat-chip{
  width: 100%;
  min-height: 84rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  background: rgba(159, 183, 106, 0.13);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.community-stat-chip--wide{
  width: 100%;
}

.community-stat-value{
  font-size: 22rpx;
  font-weight: 800;
  color: #253018;
  line-height: 1.2;
}

.community-stat-name{
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #7d8568;
  line-height: 1.2;
}

.home-refresh-tip{
  display: block;
  margin: 10rpx 0 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(0,0,0,0.36);
  line-height: 1.4;
}

.home-platform-note{
  display: block;
  margin: 24rpx 20rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: rgba(0,0,0,0.46);
  line-height: 1.45;
}

.global-loading{
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  background: rgba(255,255,255,0.0);
}

.global-loading__box{
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  background: rgba(0,0,0,0.06);
}

.global-loading__text{
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.login-row{
  width: 100%;
  display: flex;
  align-items: center;
  padding: 14rpx 0 16rpx;
  box-sizing: border-box;
}

.login-btn{
  margin-left: auto;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 28rpx;
  padding: 0 26rpx;
  border-radius: 30rpx;
  background: #179e16;
  color: #fff;
  box-shadow: 0 10rpx 18rpx rgba(0,0,0,0.10);
}

.login-btn.disabled{
  background: #cfcfcf;
  color: #fff;
  opacity: 0.9;
  box-shadow: none;
}
