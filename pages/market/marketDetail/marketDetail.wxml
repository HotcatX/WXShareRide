<view class="market-detail-page {{item.detailPageClass}}">
  <view class="detail-top ride-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar ride-topbar--center">
      <view class="ride-back ride-back-text" bindtap="onBack" hover-class="ride-pressed" hover-stay-time="80">
        <text>‹</text>
      </view>
      <text class="ride-nav-title">{{detailNavTitle}}</text>
    </view>
  </view>

  <scroll-view class="detail-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <block wx:if="{{showDetailState}}">
      <view class="detail-content">
        <view class="state-card">
          <text class="section-title">{{detailStateTitle}}</text>
          <text class="desc-text">{{detailStateDesc}}</text>
        </view>

        <view class="state-actions">
          <view class="state-btn pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onBack">
            返回
          </view>
          <view
            wx:if="{{detailCanRetry}}"
            class="state-btn pressable"
            hover-class="is-pressed"
            hover-stay-time="80"
            bindtap="onRetryLoad"
          >
            重试
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="detail-hero">
        <swiper
          class="photo-swiper"
          indicator-dots="{{hasMultipleImages}}"
          autoplay="{{hasMultipleImages}}"
          circular="{{hasMultipleImages}}"
          interval="3600"
          duration="450"
        >
          <block wx:if="{{hasImageUrls}}">
            <swiper-item wx:for="{{imgUrls}}" wx:key="*this">
              <image class="hero-img" src="{{item}}" mode="aspectFill" />
            </swiper-item>
          </block>

          <block wx:else>
            <swiper-item>
              <image wx:if="{{item.hasImage}}" class="hero-img" src="{{item.fallbackImageSrc}}" mode="aspectFill" />
              <view wx:else class="hero-no-img">
                <text>{{item.fallbackImageTitle}}</text>
              </view>
            </swiper-item>
          </block>
        </swiper>
        <view wx:if="{{hasMultipleImages}}" class="hero-count">{{imgUrls.length}} 张</view>
      </view>

      <view class="detail-content">
        <view class="info-card">
          <view class="seller-price-row">
            <view class="seller-profile pressable" hover-class="is-pressed" hover-stay-time="80" catchtap="onViewSellerProfile">
              <image class="seller-avatar" src="{{seller.avatarDisplay}}" mode="aspectFill" fade-in="{{false}}" />
              <view class="seller-copy">
                <view class="seller-name-row">
                  <text class="seller-name">{{seller.nameDisplay}}</text>
                </view>
                <text class="seller-region">{{seller.regionDisplay}}</text>
              </view>
            </view>
            <text class="detail-price">$ {{item.priceDisplay}}</text>
          </view>

          <view class="info-divider"></view>

          <text class="detail-title">{{item.titleDisplay}}</text>

          <view wx:if="{{item.pickupText}}" class="detail-line">
            <text class="detail-label">{{item.pickupLabel}}：</text>
            <text class="detail-value">{{item.pickupText}}</text>
          </view>

          <text class="desc-text">{{item.descDisplay}}</text>

          <view class="location-section">
            <text class="section-title">{{item.locationLabel}}</text>
            <text class="location-text">{{item.locationText}}</text>
          </view>

          <view wx:if="{{item.hasSubletMeta}}" class="meta-grid">
            <view class="meta-cell" wx:for="{{item.subletMetaList}}" wx:key="label">
              <text class="meta-label">{{item.label}}</text>
              <text class="meta-value">{{item.value}}</text>
            </view>
          </view>
        </view>

        <view class="detail-action-bar {{dockVisibleClass}}">
          <block wx:if="{{isOwner}}">
            <view class="owner-actions">
              <view class="action-btn secondary pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onEditItem">编辑</view>
              <view class="action-btn danger pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onDeleteItem">删除</view>
            </view>
          </block>

          <block wx:else>
            <view class="side-action pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onDetailQuickAction">
              {{item.locationActionText}}
            </view>
            <view class="action-btn primary pressable" hover-class="dock-pressed" hover-stay-time="80" bindtap="onContactSeller">
              {{item.contactText}}
            </view>
          </block>
        </view>

        <view class="bottom-space"></view>
      </view>
    </block>
  </scroll-view>
</view>
