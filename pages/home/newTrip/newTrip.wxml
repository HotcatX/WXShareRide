<timeline-preview wx:if="{{isTimelinePreview}}" id="timeline-preview" context="{{timelineContext}}" />
<block wx:elif="{{timelinePageReady}}">
<import src="../../../templates/ride-calendar.wxml" />
<view class="ride-shell create-ride">
  <view class="ride-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar ride-topbar--center">
      <view
        class="ride-back ride-back-text"
        bindtap="goBack"
        hover-class="ride-pressed"
        hover-stay-time="80"
      >
        <text>‹</text>
      </view>
      <text class="ride-nav-title">{{publishedDriverTrip ? '发布成功' : pageTitle}}</text>
    </view>

    <view wx:if="{{!publishedDriverTrip}}" class="ride-segment">
      <view
        class="ride-segment-item {{mode==='driver' ? 'active' : ''}}"
        bindtap="setMode"
        data-mode="driver"
      >司机发车</view>
      <view
        class="ride-segment-item {{mode==='passenger' ? 'active' : ''}}"
        bindtap="setMode"
        data-mode="passenger"
      >乘客求车</view>
    </view>
  </view>

  <scroll-view class="ride-scroll create-scroll" scroll-y="{{!calendarVisible && !timePickerVisible && !placePickerVisible}}" enhanced="true" show-scrollbar="{{false}}">
    <view wx:if="{{publishedDriverTrip}}" class="create-published">
      <view class="create-success-icon">✓</view>
      <text class="create-success-title">路线已发布</text>
      <text class="create-success-subtitle">乘客现在可以查看和加入你的路线</text>
      <view class="ride-card ride-card-pad create-published-card">
        <text class="create-published-date">{{publishedDriverTrip.departureDate}} · {{publishedDriverTrip.departureTime}}</text>
        <view class="create-published-route">
          <text>{{publishedDriverTrip.departureAddress}}</text>
          <text class="create-published-arrow">→</text>
          <text>{{publishedDriverTrip.destinationAddress}}</text>
        </view>
        <text class="create-published-meta">{{publishedDriverTrip.passengerCount}} 个座位 · {{publishedDriverTrip.referencePrice}} $/人</text>
      </view>
    </view>

    <block wx:if="{{mode==='driver' && !publishedDriverTrip}}">
      <view class="create-shortcut-section">
        <view class="create-section-heading">
          <view class="create-section-labels">
            <text class="create-section-title">每周固定路线</text>
            <text class="create-section-caption">纽约时间</text>
          </view>
          <view class="create-manage-link" bindtap="onManageTemplates" role="button" aria-label="管理出行模板">模板管理 ›</view>
        </view>
        <scroll-view wx:if="{{templates.length}}" class="create-shortcut-scroll" scroll-x enhanced="true" show-scrollbar="{{false}}">
          <view class="create-shortcut-track">
            <view wx:for="{{templates}}" wx:key="_id" class="create-shortcut-card create-saved-template" data-id="{{item._id}}" bindtap="onTemplateTap" hover-class="create-shortcut-pressed" role="button" aria-label="{{item.weeklyLabel}} {{item.departureTime}} {{item.departureAddress}}到{{item.destinationAddress}}，填写{{item.nextDepartureLabel}}">
              <view class="create-shortcut-top"><text class="create-shortcut-title">{{item.weeklyLabel}}</text><text class="create-shortcut-time">{{item.departureTime}}</text></view>
              <view class="create-shortcut-route"><text>{{item.departureAddress}}</text><text class="create-shortcut-arrow">→</text><text>{{item.destinationAddress}}</text></view>
              <view class="create-shortcut-bottom"><text>{{item.nextDepartureLabel}}</text><text class="create-shortcut-use">填入 ↗</text></view>
            </view>
          </view>
        </scroll-view>
        <view wx:elif="{{loadingTemplates}}" class="create-template-placeholder">正在读取每周模板…</view>
        <view wx:else class="create-template-placeholder">在模板管理中设置每周固定的星期、时间和路线</view>
      </view>
      <view wx:if="{{preparingReturn}}" class="create-return-hint"><text class="create-return-icon">↩</text><text>方向已反转，请确认返程日期和时间</text></view>
      <view class="ride-card ride-card-pad create-route-card">
        <view class="create-card-head">
          <text class="ride-section-title">{{preparingReturn ? '返程信息' : '发车信息'}}</text>
        </view>

        <view class="ride-form-grid">
          <view class="create-place-trigger" data-type="departure" bindtap="onOpenPlacePicker" role="button" aria-label="选择出发地">
          <view class="ride-field ride-field-inline">
            <text class="ride-field-label">出发地</text>

            <view class="ride-field-value ride-field-inline-value {{departureAddress ? '' : 'ride-placeholder'}}">
              {{ loadingDepartureAddrs ? '加载中' : (departureAddress || '选择出发地') }}
            </view>
          </view>
          </view>

          <view class="create-place-trigger" data-type="destination" bindtap="onOpenPlacePicker" role="button" aria-label="选择目的地">
          <view class="ride-field ride-field-inline">
            <text class="ride-field-label">目的地</text>
              <view class="ride-field-value ride-field-inline-value {{destinationAddress ? '' : 'ride-placeholder'}}">
                {{ loadingArrivalAddrs ? '加载中' : (destinationAddress || '选择目的地') }}
              </view>
          </view>
          </view>

          <view class="create-date-trigger" bindtap="onOpenDatePicker" role="button" aria-label="选择出发日期">
            <view class="ride-field ride-field-inline">
              <text class="ride-field-label">日期</text>
              <view class="ride-field-value ride-field-inline-value {{departureDate ? '' : 'ride-placeholder'}}">
                {{departureDate || '选择日期'}}
              </view>
            </view>
          </view>

          <view class="create-time-trigger" bindtap="onOpenTimePicker" role="button" aria-label="选择出发时间">
            <view class="ride-field ride-field-inline">
              <text class="ride-field-label">时间</text>
                <view class="ride-field-value ride-field-inline-value {{departureTime ? '' : 'ride-placeholder'}}">
                  {{departureTime || '选择时间'}}
                </view>
            </view>
          </view>

          <view class="ride-field ride-field-inline">
            <text class="ride-field-label">可乘人数</text>
            <input class="ride-input ride-input-inline" type="number" value="{{passengerCountInput}}" bindinput="onPassengerInput" placeholder="1-7" placeholder-class="ride-placeholder" />
          </view>
          <view class="ride-field ride-field-inline">
            <text class="ride-field-label">价格</text>
            <view class="ride-price-input-wrap">
              <input class="ride-input ride-input-inline create-price-input" type="digit" value="{{referencePrice}}" bindinput="onReferencePriceInput" placeholder="请填写" placeholder-class="ride-placeholder" />
              <text class="ride-input-suffix">$/人</text>
            </view>
          </view>
        </view>

        <view class="create-profile-summary" bindtap="onEditDriverProfile" role="button" aria-label="修改司机资料">
          <text class="create-profile-text">{{loadingUserInfo ? '正在读取司机资料' : (driverProfileReady ? carBrand + ' ' + carModel + ' · ' + carNumber : '请完善司机资料')}}</text>
          <text class="create-profile-link">{{driverProfileReady ? '修改' : '去填写'}} ›</text>
        </view>
        <view class="create-optional-row" bindtap="onToggleComment" role="button" aria-label="添加或收起备注">
          <text>{{commentExpanded ? '备注（选填）' : (comment ? '查看备注' : '添加备注（选填）')}}</text>
          <text class="create-optional-arrow">{{commentExpanded ? '−' : '＋'}}</text>
        </view>
          <view wx:if="{{commentExpanded}}" class="ride-field create-textarea-field">
            <textarea
              class="ride-textarea"
              value="{{comment}}"
              bindinput="onCommentInput"
              placeholder="选填，例如可等5分钟 / 可送到门口"
              placeholder-class="ride-placeholder"
              auto-height="true"
              maxlength="100"
            />
          </view>
      </view>

    </block>

    <block wx:if="{{mode==='passenger'}}">
      <view class="ride-card ride-card-pad create-route-card">
        <view class="create-card-head">
          <text class="ride-section-title">求车信息</text>
          <text class="ride-section-subtitle">发布后司机可接单，乘客也可加入</text>
        </view>

        <view class="ride-form-grid">
          <view class="create-place-trigger" data-type="departure" bindtap="onOpenPlacePicker" role="button" aria-label="选择出发地">
            <view class="ride-field ride-field-inline">
              <text class="ride-field-label">出发地</text>
                <view class="ride-field-value ride-field-inline-value {{departureAddress ? '' : 'ride-placeholder'}}">
                  {{ loadingDepartureAddrs ? '加载中' : (departureAddress || '选择出发地') }}
                </view>
            </view>
          </view>

          <view class="create-place-trigger" data-type="destination" bindtap="onOpenPlacePicker" role="button" aria-label="选择目的地">
            <view class="ride-field ride-field-inline">
              <text class="ride-field-label">目的地</text>
                <view class="ride-field-value ride-field-inline-value {{destinationAddress ? '' : 'ride-placeholder'}}">
                  {{ loadingArrivalAddrs ? '加载中' : (destinationAddress || '选择目的地') }}
                </view>
            </view>
          </view>

          <view class="create-date-trigger" bindtap="onOpenDatePicker" role="button" aria-label="选择出发日期">
            <view class="ride-field ride-field-inline">
              <text class="ride-field-label">日期</text>
              <view class="ride-field-value ride-field-inline-value {{departureDate ? '' : 'ride-placeholder'}}">
                {{departureDate || '选择日期'}}
              </view>
            </view>
          </view>

          <view class="create-time-trigger" bindtap="onOpenTimePicker" role="button" aria-label="选择出发时间">
            <view class="ride-field ride-field-inline">
              <text class="ride-field-label">时间</text>
                <view class="ride-field-value ride-field-inline-value {{departureTime ? '' : 'ride-placeholder'}}">
                  {{departureTime || '选择时间'}}
                </view>
            </view>
          </view>

          <view class="ride-field ride-field-inline">
            <text class="ride-field-label">乘车人数</text>
              <input
                class="ride-input ride-input-inline"
                type="number"
                value="{{passengerCount}}"
                bindinput="onPassengerInputPassenger"
                placeholder="1-4"
                placeholder-class="ride-placeholder"
              />
          </view>

          <view class="ride-field ride-field-inline">
            <text class="ride-field-label">价格</text>
            <view class="ride-price-input-wrap">
              <input
                class="ride-input ride-input-inline create-price-input"
                value="{{referencePrice || ''}}"
                disabled
                placeholder="自动计算"
                placeholder-class="ride-placeholder"
              />
              <text wx:if="{{referencePrice && referencePriceHasNumber}}" class="ride-input-suffix">$/人</text>
            </view>
          </view>
        </view>
      </view>

      <view class="ride-card ride-notice">
        <text class="ride-notice-title">求车费用</text>
        <text class="ride-notice-text">请参考 Uber/Lyft 费用；加入乘客的平摊出行费用。</text>
      </view>

      <!-- <view class="ride-card ride-notice create-notice-muted">
        <text class="ride-notice-title">发布建议</text>
        <text class="ride-notice-text">短距离优先自行打车，长距离求车发布后可等待司机接单。</text>
      </view> -->
    </block>

    <view class="ride-bottom-space"></view>
  </scroll-view>

  <view class="ride-bottom">
    <view wx:if="{{publishedDriverTrip}}" class="create-success-actions">
      <button class="ride-btn create-return-home" bindtap="onReturnHome">返回首页</button>
      <button class="ride-btn ride-btn--primary" bindtap="onPrepareReturnTrip">发布返程</button>
    </view>
    <block wx:else>
    <button
      wx:if="{{mode==='driver'}}"
      class="ride-btn ride-btn--primary {{submitting ? 'ride-btn--disabled' : ''}}"
      bindtap="confirmTrip"
      disabled="{{submitting}}"
      loading="{{submitting}}"
    >
      {{ submitting ? '提交中' : (preparingReturn ? '确认发布返程' : '发布司机路线') }}
    </button>

    <button
      wx:else
      class="ride-btn ride-btn--primary {{submitting ? 'ride-btn--disabled' : ''}}"
      bindtap="confirmTrip"
      disabled="{{submitting}}"
      loading="{{submitting}}"
    >
      {{ submitting ? '提交中' : '发布求车' }}
    </button>
    </block>
  </view>
  <template is="ride-calendar" data="{{calendarVisible, calendarMonthTitle, calendarDays, calendarCanPrev, calendarCanConfirm, calendarSelectionLabel, calendarLoading, calendarError, calendarConfirmText}}" />
  <ride-time-picker id="departure-time-picker" visible="{{timePickerVisible}}" value="{{departureTime}}" bindcancel="onCloseTimePicker" bindconfirm="onTimeChange" />
  <ride-place-picker id="departure-place-picker" visible="{{placePickerVisible}}" title="{{placePickerTitle}}" value="{{placePickerValue}}" options="{{placePickerOptions}}" fixed-options="{{placePickerFixedOptions}}" loading="{{placePickerLoading}}" error="{{placePickerError}}" bindcancel="onClosePlacePicker" bindconfirm="onConfirmPlace" bindretry="onRetryPlaceSuggestions" bindpresentation="onPlacePresentation" bindcustomcancel="onPlaceCustomCancelled" />
</view>
</block>
