.market-page{
  height: 100vh;
  overflow: hidden;
  background: #f4f6f8;
  color: #14171a;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.market-top{
  background: #f4f6f8;
  border-bottom: 1rpx solid rgba(20,23,26,0.06);
  box-shadow: 0 10rpx 30rpx rgba(20,23,26,0.04);
  z-index: 2;
}

.topbar{
  min-height: 112rpx;
  padding: 16rpx 188rpx 12rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.brand{
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
  flex: 1;
}

.brand-kicker{
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 800;
  color: #0f9b95;
  letter-spacing: 0;
  text-transform: uppercase;
}

.brand-title{
  font-size: 42rpx;
  line-height: 50rpx;
  font-weight: 900;
  color: #111418;
  letter-spacing: 0;
}

.brand-title-row{
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.topbar-actions{
  flex: none;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.topbar-action{
  min-width: 80rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.topbar-action.secondary{
  background: #ffffff;
  color: #111418;
}

.topbar-action.primary{
  background: #111418;
  color: #ffffff;
}

.market-segment{
  flex: none;
  width: 190rpx;
  height: 50rpx;
  padding: 4rpx;
  border-radius: 14rpx;
  background: rgba(255,255,255,0.82);
  border: 1rpx solid rgba(20,23,26,0.06);
  box-shadow: 0 6rpx 16rpx rgba(20,23,26,0.05);
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 4rpx;
  box-sizing: border-box;
}

.market-segment-item{
  min-width: 0;
  height: 40rpx;
  border-radius: 11rpx;
  color: #69727d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  line-height: 28rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.market-segment-item.active{
  background: #111418;
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(20,23,26,0.12);
}

.search-card{
  margin: 4rpx 24rpx 0;
  padding: 18rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(20,23,26,0.07);
  box-sizing: border-box;
}

.search-box{
  height: 76rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  padding: 0 10rpx 0 18rpx;
  box-sizing: border-box;
}

.search-symbol{
  width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  color: #69727d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.search-input{
  flex: 1;
  min-width: 0;
  height: 76rpx;
  color: #111418;
  font-size: 28rpx;
  font-weight: 700;
}

.search-placeholder{
  color: #9aa3ad;
  font-weight: 600;
}

.clear-keyword{
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: rgba(20,23,26,0.08);
  color: #69727d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 48rpx;
}

.search-submit{
  min-width: 92rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 14rpx;
  background: #111418;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.control-row{
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr) minmax(0, 1fr);
  gap: 12rpx;
}

.control-chip{
  min-width: 0;
  height: 66rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  border: 1rpx solid rgba(20,23,26,0.06);
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 14rpx;
  box-sizing: border-box;
}

.control-chip.active{
  background: rgba(15,155,149,0.12);
  border-color: rgba(15,155,149,0.22);
}

.control-label{
  flex: none;
  font-size: 22rpx;
  line-height: 28rpx;
  color: #69727d;
  font-weight: 800;
}

.control-value{
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 24rpx;
  line-height: 30rpx;
  color: #111418;
  font-weight: 900;
}

.category-scroll{
  width: 100%;
  height: 72rpx;
  white-space: nowrap;
  box-sizing: border-box;
}

.category-track{
  height: 72rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}

.category-pill{
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: rgba(255,255,255,0.72);
  color: #59636f;
  border: 1rpx solid rgba(20,23,26,0.06);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  white-space: nowrap;
}

.category-pill.active{
  background: #0f9b95;
  color: #ffffff;
  border-color: #0f9b95;
  box-shadow: 0 8rpx 18rpx rgba(15,155,149,0.22);
}

.goods-scroll{
  flex: 1;
  min-height: 0;
  padding: 10rpx 20rpx 0;
  box-sizing: border-box;
}

.result-row{
  height: 46rpx;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-title{
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
  color: #111418;
}

.result-count{
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 800;
  color: #69727d;
}

.goods-grid{
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  align-items: start;
}

.goods-card{
  min-width: 0;
  align-self: start;
  overflow: hidden;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(20,23,26,0.07);
  border: 1rpx solid rgba(20,23,26,0.05);
  box-sizing: border-box;
}

.photo-wrap{
  width: 100%;
  height: 190rpx;
  position: relative;
  overflow: hidden;
  background: #e9edf1;
}

.goods-photo{
  width: 100%;
  height: 100%;
  display: block;
}

.no-photo{
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #e8f4f2 0%, #f2f0ea 100%);
  color: #111418;
  text-align: center;
}

.no-photo text{
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
  word-break: break-all;
}

.category-badge{
  position: absolute;
  left: 12rpx;
  top: 12rpx;
  max-width: 128rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  background: rgba(17,20,24,0.72);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.corner-stack{
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.price-badge,
.condition-badge{
  max-width: 148rpx;
  height: 38rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.price-badge{
  background: rgba(240,93,79,0.94);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 30rpx;
}

.condition-badge{
  background: rgba(255,255,255,0.92);
  color: #111418;
  max-width: 172rpx;
  font-size: 19rpx;
  line-height: 28rpx;
}

.goods-body{
  min-height: 0;
  padding: 8rpx 12rpx;
  box-sizing: border-box;
}

.goods-title-row{
  min-width: 0;
  min-height: 32rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 8rpx;
}

.goods-title{
  color: #111418;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  word-break: break-all;
}

.distance{
  max-width: 72rpx;
  color: #69727d;
  font-size: 20rpx;
  line-height: 28rpx;
  font-weight: 900;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.price-line{
  margin-top: auto;
  min-height: 40rpx;
  display: flex;
  align-items: flex-end;
}

.price{
  color: #f05d4f;
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.skeleton-grid{
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.skeleton-card{
  height: 298rpx;
  border-radius: 16rpx;
  background: #ffffff;
  padding: 14rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(20,23,26,0.06);
}

.skeleton-img,
.skeleton-line{
  background: #e8edf2;
  border-radius: 12rpx;
}

.skeleton-img{
  height: 190rpx;
}

.skeleton-line{
  height: 26rpx;
  margin-top: 18rpx;
}

.skeleton-line.wide{
  width: 88%;
}

.skeleton-line.short{
  width: 48%;
}

.empty-state{
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 50rpx 28rpx;
  box-sizing: border-box;
}

.empty-mark{
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #0f9b95;
  box-shadow: 0 8rpx 24rpx rgba(20,23,26,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 96rpx;
}

.empty-title{
  margin-top: 24rpx;
  color: #111418;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.empty-subtitle{
  margin-top: 8rpx;
  color: #69727d;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.empty-action{
  margin-top: 28rpx;
  min-width: 176rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #111418;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.loading-more,
.view-more{
  height: 72rpx;
  margin: 20rpx 0 0;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #69727d;
  font-size: 26rpx;
  font-weight: 800;
}

.view-more{
  background: #ffffff;
  color: #111418;
  box-shadow: 0 6rpx 18rpx rgba(20,23,26,0.06);
}

.bottom-spacer{
  height: calc(188rpx + env(safe-area-inset-bottom));
}

.market-float-actions{
  position: fixed;
  right: 28rpx;
  bottom: calc(148rpx + env(safe-area-inset-bottom));
  z-index: 9998;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  pointer-events: none;
}

.float-action{
  min-width: 92rpx;
  height: 64rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  box-shadow: 0 12rpx 30rpx rgba(20,23,26,0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 900;
  box-sizing: border-box;
  pointer-events: auto;
}

.float-action.secondary{
  background: rgba(255,255,255,0.96);
  color: #111418;
  border: 1rpx solid rgba(20,23,26,0.08);
}

.float-action.primary{
  background: #111418;
  color: #ffffff;
}

.pressable{
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 120ms;
}

.is-pressed{
  opacity: 0.82;
  transform: scale(0.97);
}

.card-pressed{
  opacity: 0.9;
  transform: scale(0.985);
}

.rp-mask{
  position: fixed;
  left:0;
  right:0;
  top:0;
  bottom:0;
  background: rgba(17,20,24,0.38);
  z-index: 10000;
}

.rp-panel{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top-left-radius: 22rpx;
  border-top-right-radius: 22rpx;
  z-index: 10001;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -18rpx 40rpx rgba(17,20,24,0.14);
}

.rp-header{
  height: 96rpx;
  display:flex;
  align-items:center;
  justify-content: space-between;
  padding: 0 26rpx;
  border-bottom: 1rpx solid rgba(20,23,26,0.08);
  box-sizing: border-box;
}

.rp-title{
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
  color:#111418;
}

.rp-btn{
  min-width: 96rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  color: #69727d;
}

.rp-btn.ok{
  color:#0f9b95;
}

.rp-picker{
  height: 520rpx;
}

.rp-item{
  height: 88rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 800;
  color:#111418;
}
