<view class="seller-page">
  <view class="seller-top ride-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar ride-topbar--center">
      <view class="ride-back ride-back-text" bindtap="onBack" hover-class="ride-pressed" hover-stay-time="80">
        <text>‹</text>
      </view>
      <text class="ride-nav-title">{{navTitle}}</text>
    </view>
  </view>

  <scroll-view class="seller-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="seller-hero">
      <view class="seller-avatar-wrap">
        <image wx:if="{{seller.avatarDisplay}}" class="seller-avatar-img" src="{{seller.avatarDisplay}}" mode="aspectFill" />
        <view wx:else class="seller-avatar-fallback">{{seller.avatarInitialDisplay}}</view>
      </view>

      <view class="seller-main">
        <view class="seller-name-row">
          <text class="seller-name">{{seller.nameDisplay}}</text>
        </view>
        <view class="seller-tags">
          <text wx:if="{{seller.apartmentDisplay}}">{{seller.apartmentDisplay}}</text>
          <text>{{seller.regionDisplay}}</text>
        </view>
        <text class="seller-bio">{{seller.bioDisplay}}</text>
      </view>
    </view>

    <view class="seller-summary">
      <view class="summary-item">
        <text class="summary-value">{{goodsCountText}}</text>
        <text class="summary-label">{{goodsTitleMain}}</text>
      </view>
      <view class="summary-item">
        <text class="summary-value">{{activeListingType === 'sublet' ? '转租' : '二手'}}</text>
        <text class="summary-label">当前分类</text>
      </view>
    </view>

    <view class="listing-segment">
      <view
        class="listing-segment-item {{item.selectedClass}} pressable"
        wx:for="{{listingTypeTabs}}"
        wx:key="type"
        data-type="{{item.type}}"
        hover-class="is-pressed"
        hover-stay-time="80"
        bindtap="onSelectListingType"
      >
        {{item.label}}
      </view>
    </view>

    <view class="goods-head">
      <text class="goods-title-main">{{goodsTitleMain}}</text>
      <text class="goods-count">{{goodsCountText}}</text>
    </view>

    <view class="seller-grid" wx:if="{{hasGoods}}">
      <view
        class="seller-listing {{item.cardClass}} pressable"
        wx:for="{{goods}}"
        wx:key="id"
        hover-class="card-pressed"
        hover-stay-time="80"
        bindtap="onOpenGood"
        data-id="{{item.id}}"
      >
        <view class="listing-media">
          <image
            wx:if="{{item.hasImage}}"
            class="listing-img"
            src="{{item.imageSrc}}"
            mode="aspectFill"
            lazy-load="true"
          />
          <view wx:else class="listing-img text-thumb">
            <text>{{item.title}}</text>
          </view>
        </view>

        <view class="listing-body">
          <text class="listing-title">{{item.title}}</text>
          <text class="listing-desc">{{item.descText}}</text>
          <view class="listing-bottom">
            <text class="listing-price">$ {{item.priceDisplay}}</text>
            <text class="listing-meta">{{item.metaText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:else>
      <view class="empty-mark">⌕</view>
      <view class="empty-title">{{emptyTitle}}</view>
      <view class="empty-subtitle">{{emptySubtitle}}</view>
    </view>

    <view class="contact-dock {{dockVisibleClass}}">
      <view class="contact-btn pressable" hover-class="dock-pressed" hover-stay-time="80" bindtap="onCopyContact">
        {{contactText}}
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>
</view>
