<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content">
    <view class="nav-left">
      <button
        class="nav-login-btn {{isLoggedIn ? 'disabled' : ''}}"
        disabled="{{isLoggedIn}}"
        bindtap="onTapLoginBtn"
      >
        {{isLoggedIn ? '已登录' : '一键登录'}}
      </button>
    </view>

    <text class="nav-title">{{pageTitle}}</text>
  </view>
</view>

<view class="content">

  <view class="hero-grid">
    <view class="hero-btn" bindtap="goNewTrip">
      <image class="hero-img" src="/images/fache.png" mode="aspectFit" />
    </view>

    <view class="hero-btn" bindtap="goCarpoolList">
      <image class="hero-img" src="/images/jieren.png" mode="aspectFit" />
    </view>
  </view>

  <view class="trip-canvas">

    <view class="section-box trip-section {{expandedSection && expandedSection !== 'create' ? 'section-bar' : ''}}">
      <view class="section-head">
        <text class="sub-title">创建路线</text>
        <view class="section-action"
              wx:if="{{createTrips.length > 0}}"
              bindtap="onToggleSection"
              data-key="create">
          <text class="action-text">{{expandedSection === 'create' ? '收回全部' : '查看全部'}}</text>
        </view>
      </view>

      <block wx:if="{{!(expandedSection && expandedSection !== 'create')}}">
        <scroll-view
          class="trip-fixed {{expandedSection === 'create' ? 'trip-fixed--expand' : 'trip-fixed--collapse'}}"
          scroll-y="{{expandedSection === 'create' && createScrollable}}"
          show-scrollbar="{{false}}"
        >
          <block wx:if="{{createTrips.length === 0}}">
            <view class="trip-empty-slot">{{loading ? '正在同步路线' : '暂无行程'}}</view>
          </block>

          <block wx:else>
            <block wx:for="{{createShow}}" wx:key="_id">
              <view
                class="trip-item"
                bindtap="goUnifiedTripDetail"
                data-tripid="{{item._id}}"
                data-role="{{item.role}}"
                data-from="{{item.from}}"
              >
                <image class="trip-badge" src="{{item._statusBadge}}" mode="aspectFit" />
                <view class="trip-card">
                  <view class="trip-row1">
                    <text class="trip-place">{{item._fromAddress}}</text>
                    <text class="trip-arrow">→</text>
                    <text class="trip-place">{{item._toAddress}}</text>
                  </view>
                  <view class="trip-row2">
                    <text class="trip-time">{{item._timeLabel}}</text>
                  </view>
                </view>
              </view>
            </block>
          </block>
        </scroll-view>
      </block>
    </view>

    <view class="section-box trip-section {{expandedSection && expandedSection !== 'join' ? 'section-bar' : ''}}">
      <view class="section-head">
        <text class="sub-title">加入路线</text>
        <view class="section-action"
              wx:if="{{joinTrips.length > 0}}"
              bindtap="onToggleSection"
              data-key="join">
          <text class="action-text">{{expandedSection === 'join' ? '收回全部' : '查看全部'}}</text>
        </view>
      </view>

      <block wx:if="{{!(expandedSection && expandedSection !== 'join')}}">
        <scroll-view
          class="trip-fixed {{expandedSection === 'join' ? 'trip-fixed--expand' : 'trip-fixed--collapse'}}"
          scroll-y="{{expandedSection === 'join' && joinScrollable}}"
          show-scrollbar="{{false}}"
        >
          <block wx:if="{{joinTrips.length === 0}}">
            <view class="trip-empty-slot">{{loading ? '正在同步路线' : '暂无行程'}}</view>
          </block>

          <block wx:else>
            <block wx:for="{{joinShow}}" wx:key="_id">
              <view
                class="trip-item"
                bindtap="goUnifiedTripDetail"
                data-tripid="{{item._id}}"
                data-role="{{item.role}}"
                data-from="{{item.from}}"
              >
                <image class="trip-badge" src="{{item._statusBadge}}" mode="aspectFit" />
                <view class="trip-card">
                  <view class="trip-row1">
                    <text class="trip-place">{{item._fromAddress}}</text>
                    <text class="trip-arrow">→</text>
                    <text class="trip-place">{{item._toAddress}}</text>
                  </view>
                  <view class="trip-row2">
                    <text class="trip-time">{{item._timeLabel}}</text>
                  </view>
                </view>
              </view>
            </block>
          </block>
        </scroll-view>
      </block>
    </view>

  </view>

  <view class="community-stats-section">
    <view class="community-stats-head">
      <text class="community-stats-title">社区数据</text>
    </view>

    <view class="community-stats-card">
      <view class="community-stats-main">
        <text class="community-stats-label">累计已服务</text>
        <view class="community-stats-number-row">
          <text class="community-stats-number">{{publicStats.servedTripsText}}</text>
          <text wx:if="{{publicStats.hasServedTrips}}" class="community-stats-unit">人次</text>
        </view>
        <text class="community-stats-subtitle">成功拼车</text>
      </view>
      <view class="community-stats-grid">
        <view class="community-stat-chip community-stat-chip--wide">
          <text class="community-stat-value">{{publicStats.coverageText}}</text>
          <text class="community-stat-name">当前覆盖地区</text>
        </view>
        <view class="community-stat-chip community-stat-chip--wide">
          <text class="community-stat-value">{{publicStats.lastSyncText}}</text>
          <text class="community-stat-name">上一次同步时间</text>
        </view>
      </view>
    </view>
  </view>
  <text class="home-refresh-tip">下拉同步路线</text>
</view>
