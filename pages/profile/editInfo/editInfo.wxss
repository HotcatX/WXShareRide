page{
  background: #f4f6f8;
}

.edit-info{
  background: #f4f6f8;
}

.edit-scroll{
  flex: 1;
  min-height: 0;
  height: 0;
  padding-top: 14rpx;
}

.edit-profile-card{
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr);
  align-items: center;
  gap: 16rpx;
  padding: 14rpx;
}

.avatar-btn{
  position: relative;
  width: 112rpx;
  height: 112rpx;
  padding: 0;
  margin: 0;
  border-radius: 16rpx;
  background: #eef1f4;
  line-height: 1;
  overflow: hidden;
}

.avatar-btn::after{
  border: none;
}

.avatar{
  width: 112rpx;
  height: 112rpx;
  border-radius: 16rpx;
  background: #eef1f4;
  display: block;
}

.avatar-chip{
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  height: 34rpx;
  padding: 0 6rpx;
  border-radius: 10rpx;
  background: rgba(255,255,255,0.92);
  color: #111418;
  font-size: 18rpx;
  line-height: 24rpx;
  box-shadow: 0 6rpx 16rpx rgba(20,23,26,0.10);
}

.profile-name-field{
  min-height: 72rpx;
  padding: 10rpx 14rpx;
}

.section-head{
  margin: 16rpx 4rpx 8rpx;
}

.section-head .ride-section-subtitle{
  display: block;
  margin-top: 2rpx;
}

.edit-form-card{
  padding: 10rpx;
}

.edit-form-card .ride-field + .ride-field,
.edit-picker + .ride-field,
.edit-form-card .ride-field + .edit-picker{
  margin-top: 6rpx;
}

.car-card{
  margin-top: 12rpx;
}

.driver-form-card{
  padding: 8rpx 10rpx;
}

.driver-form-card .edit-field{
  min-height: 58rpx;
  padding-top: 6rpx;
  padding-bottom: 6rpx;
}

.edit-field{
  min-height: 70rpx;
  display: grid;
  grid-template-columns: 172rpx minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
}

.edit-field-label{
  font-size: 24rpx;
  line-height: 30rpx;
  white-space: nowrap;
}

.edit-input,
.edit-value-text{
  margin-top: 0;
  height: 38rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 900;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-input-disabled{
  color: #111418;
  opacity: 1;
}

.edit-address-control{
  min-width: 0;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  align-items: center;
}

.edit-address-control .edit-input{
  min-width: 0;
}

.edit-inline-action{
  height: 52rpx;
  border-radius: 12rpx;
  background: #eef1f4;
  color: #111418;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.edit-value-action{
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
}

.edit-value-action .edit-input,
.edit-value-action .edit-value-text{
  min-width: 0;
  flex: 1;
}

.edit-chevron{
  flex: none;
  font-size: 34rpx;
  line-height: 34rpx;
  font-weight: 900;
  color: #9aa3ad;
}

.edit-picker{
  display: block;
}

.edit-bottom-space{
  height: calc(28rpx + env(safe-area-inset-bottom));
}

.rp-mask{
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17,20,24,0.38);
  z-index: 10000;
}

.city-panel{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10001;
  height: min(76vh, 980rpx);
  border-top-left-radius: 22rpx;
  border-top-right-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 -18rpx 40rpx rgba(17,20,24,0.14);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.city-header{
  height: 96rpx;
  padding: 0 24rpx;
  border-bottom: 1rpx solid rgba(20,23,26,0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.city-title{
  color: #111418;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.city-close{
  min-width: 96rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #69727d;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.city-search-wrap{
  padding: 16rpx 24rpx 18rpx;
  border-bottom: 1rpx solid rgba(20,23,26,0.08);
  box-sizing: border-box;
}

.city-search-input{
  width: 100%;
  height: 70rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f4f6f8;
  color: #111418;
  font-size: 26rpx;
  line-height: 70rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.city-search-placeholder{
  color: #9aa4af;
  font-weight: 700;
}

.city-body{
  min-height: 0;
  flex: 1;
  display: grid;
  grid-template-columns: 168rpx minmax(0, 1fr);
}

.city-country-tabs{
  padding: 18rpx 0;
  background: #f4f6f8;
}

.city-country{
  height: 82rpx;
  padding-left: 24rpx;
  border-left: 8rpx solid transparent;
  color: #59636f;
  display: flex;
  align-items: center;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.city-country.active{
  color: #0f9b95;
  border-left-color: #0f9b95;
  background: #ffffff;
  font-weight: 900;
}

.city-group-scroll{
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.city-group{
  padding: 24rpx 22rpx 8rpx;
}

.city-group-title{
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #111418;
  font-size: 29rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.city-hot-badge{
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #ff6a3d;
  color: #ffffff;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  line-height: 34rpx;
  font-style: italic;
  font-weight: 900;
}

.city-grid{
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.city-option{
  min-width: 0;
  height: 66rpx;
  padding: 0 12rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  color: #59636f;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 25rpx;
  line-height: 32rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.city-option.active{
  background: #0f9b95;
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(15,155,149,0.22);
}

.city-empty{
  padding: 72rpx 28rpx 24rpx;
  color: #8b95a1;
  text-align: center;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.city-picker-hint{
  margin: 18rpx 22rpx 28rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f4f8f7;
  color: #66717d;
  font-size: 23rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.area-panel{
  height: min(48vh, 620rpx);
}

.area-scroll{
  flex: 1;
  min-height: 0;
  padding: 24rpx 22rpx calc(20rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.area-grid{
  padding-bottom: 4rpx;
}

.area-option{
  height: 68rpx;
}

.rp-panel{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top-left-radius: 22rpx;
  border-top-right-radius: 22rpx;
  z-index: 10001;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -18rpx 40rpx rgba(17,20,24,0.14);
}

.rp-header{
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 26rpx;
  border-bottom: 1rpx solid rgba(20,23,26,0.08);
  box-sizing: border-box;
}

.rp-title{
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
  color: #111418;
}

.rp-btn{
  min-width: 96rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 900;
  color: #69727d;
}

.rp-btn.ok{
  color: #0f9b95;
}

.rp-picker{
  height: 520rpx;
}

.rp-item{
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 800;
  color: #111418;
}
