.page{
  height: 100vh;
  overflow: hidden;
  background: #F6EFE8; display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.nav-bar{
  width: 100%;
  background-color: #EE9C73; }

.nav-content{
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  position: relative;
  box-sizing: border-box;
}

.back-icon{
  width: 50rpx;
  height: 50rpx;
}

.nav-title{
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 900;
  color: #111;
}

.content-scroll{
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

.card{
  background: #fff;
  border-radius: 26rpx;
  padding: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 14rpx 30rpx rgba(0,0,0,0.06);
  margin-top: 18rpx;
}

.inline-loading{
  margin: 18rpx 22rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.78);
  color: rgba(0,0,0,0.54);
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.top-block{
  padding-bottom: 10rpx;
}

.img-uploader{
  width: 220rpx;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #F2F2F2;
  border-radius: 18rpx;
  position: relative;
}

.img{
  width: 100%;
  height: 100%;
}

.img-placeholder{
  text-align: center;
  color: rgba(0,0,0,0.28);
  font-weight: 800;
}

.image-upload-mask{
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2;
  background: rgba(0,0,0,0.42);
  backdrop-filter: blur(6px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.upload-progress-ring{
  width: 108rpx;
  height: 108rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(0,0,0,0.22);
}

.upload-progress-core{
  width: 78rpx;
  height: 78rpx;
  border-radius: 999rpx;
  background: rgba(19,22,26,0.78);
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-progress-text{
  color: rgba(255,255,255,0.92);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.ph1{ font-size: 26rpx; display: block; }
.ph2{ font-size: 24rpx; display: block; margin-top: 6rpx; }

.title-input{
  margin-top: 18rpx;
  height: 70rpx;
  border-bottom: 2rpx solid rgba(0,0,0,0.10);
  font-size: 30rpx;
  font-weight: 900;
  color: #111;
}

.title-ph{ color: rgba(0,0,0,0.30); font-weight: 700; }

.desc{
  margin-top: 14rpx;
  min-height: 100rpx;
  font-size: 28rpx;
  color: rgba(0,0,0,0.75);
}

.desc-ph{ color: rgba(0,0,0,0.30); }

.quick-wrap{
  margin-top: 10rpx;
}

.quick-title{
  color: #E54B3B; font-size: 28rpx;
  font-weight: 900;
  margin: 6rpx 0 10rpx 0;
}

.chips{
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip{
  border: 2rpx solid rgba(0,0,0,0.12);
  border-radius: 999rpx;
  padding: 10rpx 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(0,0,0,0.70);
  background: #fff;
}

.form{
  margin-top: 0;
}

.row{
  border-bottom: none;
}

.form .row{
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid rgba(0,0,0,0.08);
}
.form .row.no-border{
  border-bottom: none;
}

.row.no-border{
  border-bottom: none;
}

.label{
  font-size: 32rpx;
  font-weight: 900;
  color: #111;
}

.right{
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.value{
  font-size: 30rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.45);
}

.arrow{
  font-size: 44rpx;
  color: rgba(0,0,0,0.30);
  line-height: 1;
}

.price-row .value{ display: none; }

.yuan{
  font-size: 34rpx;
  font-weight: 900;
  color: #EE9C73;
}

.price-input{
  width: 180rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #EE9C73;
  text-align: right;
}

.price-ph{ color: rgba(217,100,74,0.60); }

.expire-hint{
  padding: 14rpx 0 18rpx 0;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1.45;
  color: rgba(0,0,0,0.42);
  border-bottom: 2rpx solid rgba(0,0,0,0.08);
}

.location-row{
  min-height: 104rpx;
}

.location-right{
  min-width: 0;
  flex: 1;
  margin-left: 24rpx;
  justify-content: flex-end;
}

.location-value{
  max-width: 420rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #111;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: right;
}

.location-value.is-placeholder{
  color: rgba(0,0,0,0.30);
  font-weight: 700;
}

.bottom-space{
  height: calc(140rpx + env(safe-area-inset-bottom));
}

.bottom-fixed{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

.bottom-bar{
  background: #fff;
  height: 160rpx; box-sizing: border-box;
  border-top: 2rpx solid rgba(0,0,0,0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit{
  width: 93%;
  height: 96rpx;
  border-radius: 999rpx;
  background: #EE9C73;
  color: #fff;
  font-size: 36rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 3rpx 6rpx 2rpx 0 rgba(0,0,0,0.25);
}


.content{
  padding: 22rpx 24rpx 0;
  box-sizing: border-box;
}

.bottom-space{
  height: calc(160rpx + env(safe-area-inset-bottom));
}

.submit--hover{
  opacity: .92;
}

.submit--disabled{
  opacity: .55;
  filter: grayscale(20%);
  pointer-events: none;   }

.img-uploader-multi{ width: 320rpx; }
.img-grid{
  position: relative;
  width: 320rpx;
  min-height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f6f6f6;
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
}
.img-item{
  width: 106.66rpx;
  height: 106.66rpx;
  flex: 0 0 106.66rpx;
}
.img-count{
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
}
.img-tip{
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}

.thumb-canvas{
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 300px;
  height: 300px;
}
