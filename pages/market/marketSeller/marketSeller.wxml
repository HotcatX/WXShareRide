<view class="seller-page">
  <view class="seller-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="seller-nav">
      <view class="nav-back pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onBack">‹</view>
      <text class="nav-title">{{navTitle}}</text>
      <view class="nav-spacer"></view>
    </view>
  </view>

  <scroll-view class="seller-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="seller-card">
      <view class="avatar-wrap">
        <image wx:if="{{seller.avatarDisplay}}" class="avatar-img" src="{{seller.avatarDisplay}}" mode="aspectFill" />
        <view wx:else class="avatar-fallback">{{seller.avatarInitialDisplay}}</view>
      </view>

      <view class="seller-info">
        <text class="seller-name">{{seller.nameDisplay}}</text>
        <view class="seller-tags">
          <text>{{seller.apartmentDisplay}}</text>
          <text>{{seller.regionDisplay}}</text>
        </view>
      </view>
    </view>

    <view class="bio-card">
      <text class="section-title">{{bioTitle}}</text>
      <text class="bio-text">{{seller.bioDisplay}}</text>
    </view>

    <view class="goods-head">
      <view>
        <text class="section-kicker">Listings</text>
        <text class="goods-title-main">{{goodsTitleMain}}</text>
      </view>
      <text class="goods-count">{{goodsCountText}}</text>
    </view>

    <view class="listing-segment">
      <view
        class="listing-segment-item {{item.selectedClass}} pressable"
        wx:for="{{listingTypeTabs}}"
        wx:key="type"
        data-type="{{item.type}}"
        hover-class="is-pressed"
        hover-stay-time="80"
        bindtap="onSelectListingType"
      >
        {{item.label}}
      </view>
    </view>

    <view class="goods-grid" wx:if="{{hasGoods}}">
      <view
        class="goods-card pressable"
        wx:for="{{goods}}"
        wx:key="id"
        hover-class="card-pressed"
        hover-stay-time="80"
        bindtap="onOpenGood"
        data-id="{{item.id}}"
      >
        <view class="photo-wrap">
          <image
            wx:if="{{item.hasImage}}"
            class="thumb"
            src="{{item.imageSrc}}"
            mode="aspectFill"
            lazy-load="true"
          />
          <view wx:else class="thumb text-thumb">
            <text>{{item.title}}</text>
          </view>
        </view>

        <view class="goods-body">
          <text class="goods-title">{{item.title}}</text>
          <text class="goods-meta">{{item.metaText}}</text>
          <text class="goods-price">$ {{item.priceDisplay}}</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:else>
      <view class="empty-mark">⌕</view>
      <view class="empty-title">{{emptyTitle}}</view>
      <view class="empty-subtitle">{{emptySubtitle}}</view>
    </view>

    <view class="contact-dock {{dockVisibleClass}}">
      <view class="contact-btn pressable" hover-class="dock-pressed" hover-stay-time="80" bindtap="onCopyContact">
        {{contactText}}
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>
</view>
