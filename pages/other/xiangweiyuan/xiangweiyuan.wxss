.page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

/* 顶部导航栏 */
.nav-bar {
  width: 100%;
  background-color: #ffffff;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
}

.back-icon {
  width: 50rpx;
  height: 50rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}

.container {
  padding: 24rpx;
}

/* 宣传照头图卡片 */
.hero-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.hero-img {
  width: 100%;
  display: block;
}

/* 图二风格：文字头部 */
.header-card {
  margin-top: 18rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.header-top {
  font-size: 24rpx;
  color: #9a9a9a;
  display: block;
  margin-bottom: 6rpx;
}

.header-title-row {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 16rpx;
}

.header-title-en {
  font-size: 46rpx;
  font-weight: 800;
  color: #111;
}

.header-title-cn {
  font-size: 40rpx;
  font-weight: 800;
  color: #111;
}

.header-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #6b6b6b;
  line-height: 1.6;
}

/* 通用卡片 */
.card {
  margin-top: 18rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 22rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 10rpx;
}

.card-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
}

/* ✅ 详细信息：绿色对勾列表 */
.detail-list {
  margin-top: 6rpx;
}

.detail-item {
  display: flex;
  align-items: flex-start;
  margin-top: 10rpx;
}

.check {
  color: #16b83f;
  font-size: 28rpx;
  font-weight: 700;
  margin-right: 12rpx;
  line-height: 1.6;
}

.detail-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
}

.info-row {
  margin-top: 8rpx;
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  align-items: center;
}

.info-label {
  font-size: 26rpx;
  color: #888;
  flex: 0 0 auto;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  text-align: right;
  flex: 1 1 auto;
}

/* 地址行：右侧含地址 + 复制按钮 */
.address-row {
  align-items: flex-start;
}

.address-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  justify-content: flex-end;
}

.address-text {
  max-width: 520rpx;
  text-align: right;
  line-height: 1.5;
  word-break: break-word;
}

.copy-mini {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e8e8e8;
  font-size: 24rpx;
  color: #111;
  background: #fff;
}

.copy-mini:active {
  opacity: 0.85;
}

/* 优惠券图片展示 */
.coupon-img-box {
  margin-top: 18rpx;
  border-radius: 18rpx;
  overflow: visible;         /* ✅ 不裁剪图片 */
  background: #f8f8f8;
  padding: 12rpx;            /* ✅ 给图片留白，避免贴边看起来像被切 */
  box-sizing: border-box;
}

.coupon-img {
  width: 100%;
  display: block;
}

.coupon-placeholder {
  margin-top: 18rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #f8f8f8;
  text-align: center;
}

.placeholder-text {
  font-size: 26rpx;
  color: #999;
}

/* 按钮区域 */
.btn-row {
  margin-top: 18rpx;
  display: flex;
  gap: 16rpx;
}

.btn {
  flex: 1;
  border-radius: 18rpx;
  font-size: 28rpx;
}

.primary {
  background: #16b83f;
  color: #fff;
}

.danger {
  margin-top: 12rpx;
  background: #ff4d4f;
  color: #fff;
}

/* 细则说明 */
.fine-print {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

/* 离屏 Canvas：放到屏幕外（仍可正常 draw + 导出图片） */
.coupon-canvas {
  position: absolute;
  left: -9999rpx;
  top: -9999rpx;
  width: 750rpx;
  height: 420rpx;
}
