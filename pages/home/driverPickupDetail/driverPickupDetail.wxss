/* pages/home/driverPickupDetail/driverPickupDetail.wxss */

/* 页面同款米色背景 */
page{
  background: #F6EFE8;
}

/* 页面骨架 */
.ui-page{
  height: 100vh;
  overflow: hidden;
  background: #F6EFE8;
  display: flex;
  flex-direction: column;
}

/* 加载态居中 */
.state-text{
  flex: 1;
  text-align: center;
  margin-top: 80rpx;
  font-size: 26rpx;
  color: rgba(0,0,0,0.45);
}
.state-card{
  margin: 80rpx 22rpx 0 22rpx;
  padding: 40rpx 28rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 14rpx 30rpx rgba(0,0,0,0.06);
  text-align: center;
}
.state-title{
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.5;
  color: rgba(0,0,0,0.68);
}
.state-action-btn{
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin-top: 28rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #9CB06A;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
}
.state-action-btn::after{ border: none; }

/* 中间滚动：同款 padding */
.ui-scroll{
  flex: 1;
  min-height: 0;
  padding: 22rpx 22rpx 0 22rpx;
  box-sizing: border-box;
}

/* 白色卡片：同款圆角 + 阴影 */
.ui-card{
  background: #fff;
  border-radius: 26rpx;
  padding: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 14rpx 30rpx rgba(0,0,0,0.06);
  margin-top: 18rpx;
}

/* 给底部按钮留空间 */
.ui-bottom-space{
  height: calc(140rpx + env(safe-area-inset-bottom));
}

/* 底部固定：同款白框 */
.ui-bottom-fixed{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

.ui-bottom-bar{
  background: #fff;
  height: 160rpx;
  box-sizing: border-box;
  border-top: 2rpx solid rgba(0,0,0,0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 同款主按钮（button 版） */
.ui-primary-btn{
  width: 93%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  background: #EE9C73;
  color: #fff;
  font-size: 36rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 3rpx 6rpx 2rpx 0 rgba(0,0,0,0.25);
}

/* 去掉 button 默认边框 */
.ui-primary-btn::after{ border: none; }

/* 禁用态：内凹阴影，表达“系统限制” */
.ui-primary-btn--disabled{
  background: #f0f0f0 !important;
  color: #9a9a9a !important;

  /* 关键：内置阴影（inset） */
  box-shadow:
    inset 0 4rpx 6rpx rgba(0,0,0,0.12),
    inset 0 -4rpx 6rpx rgba(255,255,255,0.8) !important;
}


/* =========================
   卡片内排版（保留你原设计，只微调颜色统一）
   ========================= */

/* 卡片标题（你原来是蓝色，这里给你保留“强调色”，但不抢主按钮） */
.card-title{
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.75);
  margin-bottom: 16rpx;
}

/* 第一行：出发地 → 目的地 */
.route-row{
  display: flex;
  align-items: center;
}

.route-text-left,
.route-text-right{
  flex: 1;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 40rpx;
  color: rgba(0,0,0,0.78);
}
.route-text-left{ text-align: left; }
.route-text-right{ text-align: right; }

.route-arrow{
  width: 80rpx;
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
  line-height: 40rpx;
  color: rgba(0,0,0,0.45);
}

/* 第二行：时间 + 人数 */
.time-seat-row{
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.time-text,
.seat-text{
  font-size: 30rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.60);
}

/* 第三行：参考价格 */
.price-row{
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
}

.price-text-combined{
  font-size: 34rpx;
  line-height: 40rpx;
  color: #FE814B;          /* 与二手交易“红标题”同一体系 */
  font-weight: 900;
  white-space: nowrap;
}

/* =========================
   顶部导航栏（结构保留）
   ========================= */
.nav-bar{
  width: 100%;
  background-color: #ffffff;
}

.nav-content{
  display: flex;
  align-items: center;
  height: 44px;
  padding: 0 20rpx;
  position: relative;
}

.back-icon{
  width: 50rpx;
  height: 50rpx;
}

.nav-title{
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}
