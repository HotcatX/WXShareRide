<view class="ride-shell my-ride">
  <view class="ride-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar ride-topbar--center">
      <view
        class="ride-back ride-back-text"
        bindtap="goBack"
        hover-class="ride-pressed"
        hover-stay-time="80"
      >
        <text>‹</text>
      </view>
      <text class="ride-nav-title">{{pageTitle}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="ride-state">正在加载路线</view>

  <view wx:elif="{{loadError}}" class="ride-state">
    <text class="ride-state-title">{{loadError}}</text>
    <button class="ride-state-action" bindtap="goBack">返回</button>
  </view>

  <scroll-view
    wx:else
    class="ride-scroll my-scroll"
    scroll-y
    enhanced="true"
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refresherTriggered}}"
    bindrefresherrefresh="onDetailRefresherRefresh"
  >
    <view class="ride-card ride-card-pad">
      <view class="ride-row-between my-hero-head">
        <text class="ride-list-kind">{{sourceType === 'request' ? '已加入求车' : '已加入拼车'}}</text>
        <text wx:if="{{sourceType === 'carpool'}}" class="ride-chip {{isTripCompleted ? 'ride-chip--warn' : 'ride-chip--accent'}}">{{isTripCompleted ? '已结束' : ('余位 ' + (trip.availSeatNum || 0))}}</text>
        <text wx:else class="ride-chip {{isTripCompleted ? 'ride-chip--warn' : 'ride-chip--accent'}}">{{isTripCompleted ? '已结束' : ('已加入 ' + (trip.passengerCount || 0) + ' 人')}}</text>
      </view>

      <view class="ride-route">
        <view class="ride-route-rail">
          <view class="ride-dot"></view>
          <view class="ride-line"></view>
          <view class="ride-dot ride-dot--accent"></view>
        </view>
        <view class="ride-route-body">
          <view class="ride-route-point">
            <text class="ride-route-label">出发</text>
            <text class="ride-route-name">{{fromText || '出发地未设置'}}</text>
          </view>
          <view class="ride-route-point">
            <text class="ride-route-label">到达</text>
            <text class="ride-route-name">{{toText || '目的地未设置'}}</text>
          </view>
        </view>
      </view>

      <view class="ride-meta">
        <text class="ride-chip ride-chip--dark">{{dateText}} {{weekdayText}} {{timeText}}</text>
        <text wx:if="{{trip.referencePriceText}}" class="ride-chip ride-chip--warn">价格：{{trip.referencePriceText}}</text>
      </view>
    </view>

    <view class="ride-card ride-card-pad">
      <text class="ride-section-title">司机信息</text>

      <view wx:if="{{driverInfo}}" class="ride-person my-driver">
        <image class="ride-avatar" src="{{driverInfo.avatarUrl || defaultAvatarUrl}}" mode="aspectFill" />
        <view class="ride-person-main">
          <text class="ride-person-name">{{driverInfo.name || '未设置昵称'}}</text>
          <text class="ride-social-line">{{driverInfo.rideStatsText || '暂无拼车记录'}}</text>
          <view class="ride-info-grid">
            <view wx:if="{{driverInfo.carNumber}}" class="ride-info-row">
              <text class="ride-info-label">车牌</text>
              <text class="ride-info-value">{{driverInfo.carNumber}}</text>
              <view></view>
            </view>
            <view class="ride-info-row">
              <text class="ride-info-label">微信</text>
              <text class="ride-info-value">{{driverInfo.wechatID || '未填写'}}</text>
              <view wx:if="{{driverInfo.wechatID}}" class="ride-copy" data-text="{{driverInfo.wechatID}}" bindtap="onCopyText">复制</view>
            </view>
            <view class="ride-info-row">
              <text class="ride-info-label">手机</text>
              <text class="ride-info-value">{{driverInfo.phone || '未填写'}}</text>
              <view wx:if="{{driverInfo.phone}}" class="ride-copy" data-text="{{driverInfo.phone}}" bindtap="onCopyText">复制</view>
            </view>
            <view wx:if="{{driverInfo.zelleName}}" class="ride-info-row">
              <text class="ride-info-label">Zelle</text>
              <text class="ride-info-value">{{driverInfo.zelleName}}</text>
              <view></view>
            </view>
            <view wx:if="{{driverInfo.zelleAccount}}" class="ride-info-row">
              <text class="ride-info-label">账号</text>
              <text class="ride-info-value">{{driverInfo.zelleAccount}}</text>
              <view class="ride-copy" data-text="{{driverInfo.zelleAccount}}" bindtap="onCopyText">复制</view>
            </view>
          </view>
          <view class="ride-person-actions">
            <view wx:if="{{isTripCompleted && !driverInfo.hasRated}}" class="ride-mini-btn ride-mini-btn--accent" data-openid="{{driverInfo._openid}}" data-name="{{driverInfo.name || '司机'}}" bindtap="onRateDriver">评价</view>
            <view wx:if="{{isTripCompleted && driverInfo.hasRated}}" class="ride-mini-btn ride-mini-btn--disabled" data-openid="{{driverInfo._openid}}" data-name="{{driverInfo.name || '司机'}}" bindtap="onRateDriver">已评价</view>
            <view class="ride-mini-btn ride-mini-btn--danger" data-openid="{{driverInfo._openid}}" data-name="{{driverInfo.name || '该用户'}}" bindtap="onBlockUser">拉黑</view>
          </view>
        </view>
      </view>

      <view wx:else class="my-empty">暂未获取到司机信息</view>
    </view>

    <view wx:if="{{sourceType === 'request'}}" class="ride-card ride-card-pad">
      <view class="ride-row-between my-section-head">
        <text class="ride-section-title">已加入乘客</text>
        <text class="ride-section-subtitle">{{passengerList.length || 0}} 人</text>
      </view>

      <view wx:if="{{!passengerList || passengerList.length === 0}}" class="my-empty">
        暂无其他乘客加入
      </view>

      <block wx:else>
        <view class="ride-person" wx:for="{{passengerList}}" wx:key="_openid" wx:for-item="p">
          <image class="ride-avatar" src="{{p.avatarUrl || defaultAvatarUrl}}" mode="aspectFill" />
          <view class="ride-person-main">
            <text class="ride-person-name">{{p.name || p.nickName || '未设置昵称'}}</text>
            <text class="ride-social-line">{{p.rideStatsText || '暂无拼车记录'}}</text>
            <view class="ride-info-grid">
              <view class="ride-info-row">
                <text class="ride-info-label">地址</text>
                <text class="ride-info-value">{{p.address || '未填写'}}</text>
                <view></view>
              </view>
              <view class="ride-info-row">
                <text class="ride-info-label">微信</text>
                <text class="ride-info-value">{{p.wechatID || '未填写'}}</text>
                <view wx:if="{{p.wechatID}}" class="ride-copy" data-text="{{p.wechatID}}" bindtap="onCopyText">复制</view>
              </view>
              <view class="ride-info-row">
                <text class="ride-info-label">手机</text>
                <text class="ride-info-value">{{p.phone || '未填写'}}</text>
                <view wx:if="{{p.phone}}" class="ride-copy" data-text="{{p.phone}}" bindtap="onCopyText">复制</view>
              </view>
            </view>
            <view class="ride-person-actions">
              <view class="ride-mini-btn ride-mini-btn--danger" data-openid="{{p._openid}}" data-name="{{p.name || p.nickName || '该用户'}}" bindtap="onBlockUser">拉黑</view>
            </view>
          </view>
        </view>
      </block>
    </view>

    <view wx:if="{{showFortLeeCoreTip}}" class="ride-card ride-notice">
      <text class="ride-notice-title">Fort Lee 核心区</text>
      <text class="ride-notice-text">仅包含 Fiat House、Modern、2050 和 Hudson Lights 四个公寓。</text>
    </view>

    <text class="ride-refresh-hint">{{refreshHintText}}</text>
    <view class="ride-bottom-space"></view>
  </scroll-view>

  <view wx:if="{{!isTripCompleted && !loading && !loadError}}" class="ride-bottom">
    <button class="ride-btn ride-btn--danger" bindtap="onDeleteOrQuit">
      退出路线
    </button>
  </view>
</view>
