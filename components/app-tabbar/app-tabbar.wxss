.app-tabbar-wrap{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  z-index: 9999;
  padding: 12rpx 42rpx calc(14rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
}

.app-tabbar{
  height: 112rpx;
  border-radius: 32rpx;
  background: rgba(255,255,255,0.98);
  border: 1rpx solid rgba(20,23,26,0.08);
  box-shadow: 0 18rpx 44rpx rgba(20,23,26,0.16);
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  align-items: center;
  box-sizing: border-box;
  pointer-events: auto;
}

.tab-item{
  height: 96rpx;
  margin: 8rpx;
  border-radius: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  color: #69727d;
  box-sizing: border-box;
}

.tab-item.active{
  background: #f4f6f8;
  color: #111418;
}

.tab-pressed{
  opacity: 0.72;
  transform: scale(0.98);
}

.tab-icon-wrap{
  position: relative;
  width: 42rpx;
  height: 42rpx;
}

.tab-icon{
  width: 42rpx;
  height: 42rpx;
  display: block;
}

.tab-text{
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.tab-badge{
  position: absolute;
  right: -20rpx;
  top: -12rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border-radius: 999rpx;
  background: #e64c3c;
  color: #fff;
  border: 3rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  line-height: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
}
