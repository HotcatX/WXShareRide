page {
  background: #f4f6f8;
}

.feedback-page {
  background: #f4f6f8;
}

.feedback-scroll {
  padding: 18rpx 20rpx calc(env(safe-area-inset-bottom) + 32rpx);
}

.feedback-card {
  width: 100%;
}

.feedback-form {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.feedback-field {
  min-height: 92rpx;
  padding: 12rpx 16rpx;
}

.feedback-input {
  height: 48rpx;
  line-height: 48rpx;
  font-weight: 800;
}

.phone-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.phone-picker {
  flex: 0 0 214rpx;
  min-width: 0;
}

.phone-picker-value {
  height: 48rpx;
  line-height: 48rpx;
  padding-right: 12rpx;
  border-right: 1rpx solid rgba(20,23,26,0.12);
  color: #111418;
  font-size: 26rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.phone-input {
  flex: 1;
  min-width: 0;
}

.feedback-field--textarea {
  min-height: 226rpx;
  justify-content: flex-start;
}

.feedback-textarea {
  height: 164rpx;
  min-height: 164rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.feedback-submit {
  width: 100%;
  height: 84rpx;
  line-height: 84rpx;
  margin: 6rpx 0 0;
  padding: 0;
  border-radius: 14rpx;
  font-size: 29rpx;
  font-weight: 900;
  text-align: center;
}

.feedback-submit::after {
  border: 0;
}

.toast-bar {
  position: fixed;
  top: 148rpx;
  left: 24rpx;
  right: 24rpx;
  min-height: 72rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #111418;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 12rpx;
  z-index: 99;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 28rpx rgba(20,23,26,0.14);
  box-sizing: border-box;
}

.toast-bar.success {
  background: #123f35;
}

.toast-bar.error {
  background: #471f24;
}

.toast-bar.warn {
  background: #4a3614;
}

.toast-icon {
  flex: none;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.16);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.toast-text {
  flex: 1;
  min-width: 0;
  word-break: break-word;
}
