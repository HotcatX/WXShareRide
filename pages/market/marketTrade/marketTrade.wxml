<view class="trade-page">
  <view class="trade-top ride-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar ride-topbar--center">
      <view class="ride-back ride-back-text" bindtap="onBack" hover-class="ride-pressed" hover-stay-time="80">
        <text>‹</text>
      </view>
      <text class="ride-nav-title">{{pageTitle}}</text>
    </view>
  </view>

  <scroll-view class="trade-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="summary-card">
      <view class="summary-copy">
        <text class="summary-title">{{summaryTitle}}</text>
        <text class="summary-subtitle">{{listCountText}}</text>
      </view>
      <view
        wx:if="{{isAdmin && type === 'sold'}}"
        class="admin-entry pressable"
        hover-class="is-pressed"
        hover-stay-time="80"
        bindtap="onToggleAdminPanel"
      >
        {{adminPanelVisible ? '收起代发' : '批量代发'}}
      </view>
    </view>

    <view wx:if="{{isAdmin && adminPanelVisible}}" class="admin-panel">
      <view class="admin-header">
        <view class="admin-header-copy">
          <text class="admin-title">批量代发</text>
          <text class="admin-count">{{adminSummaryText || '草稿 0 条'}}</text>
        </view>
        <view class="admin-header-actions">
          <view class="admin-pill-btn pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onAdminAddDraft">新增</view>
          <view class="admin-pill-btn dark pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onAdminPublishDrafts">{{adminLoading ? '发布中' : '发布'}}</view>
        </view>
      </view>

      <view class="admin-tool-card">
        <view class="admin-tool-row">
          <textarea
            class="admin-import"
            value="{{adminImportText}}"
            placeholder="可粘贴 JSON 数组或表格数据"
            placeholder-class="admin-placeholder"
            bindinput="onAdminImportInput"
          />
          <view class="admin-tool-actions">
            <view class="admin-tool-btn pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onParseAdminImport">识别</view>
            <view class="admin-tool-btn pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onAdminSaveDraft">存草稿</view>
          </view>
        </view>

        <view class="template-row">
          <input
            class="template-name-input"
            value="{{adminTemplateName}}"
            placeholder="模板名"
            placeholder-class="admin-placeholder"
            bindinput="onAdminTemplateNameInput"
          />
          <picker wx:if="{{adminTemplates.length}}" range="{{adminTemplates}}" range-key="name" value="{{adminTemplateIndex}}" bindchange="onAdminTemplateChange">
            <view class="template-btn pressable" hover-class="is-pressed" hover-stay-time="80">套用模板</view>
          </picker>
          <view wx:else class="template-btn disabled">暂无模板</view>
          <view class="template-btn pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onAdminSaveTemplate">保存模板</view>
          <view class="template-btn danger pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onAdminDeleteTemplate">删除</view>
        </view>
      </view>

      <view class="section-card media-section">
        <view class="section-head">
          <view>
            <text class="section-kicker">Photo</text>
            <text class="section-title">{{adminForm.listingType === 'sublet' ? '房源图片' : '商品图片'}}</text>
          </view>
          <text class="section-note">{{adminImageCountText}}</text>
        </view>

        <view class="image-grid">
          <view
            wx:for="{{adminForm.images}}"
            wx:key="*this"
            wx:for-index="index"
            class="image-tile image-preview-tile pressable"
            hover-class="is-pressed"
            hover-stay-time="80"
            data-index="{{index}}"
            bindtap="onAdminPreviewImage"
          >
            <image class="preview-img" src="{{item}}" mode="aspectFill" />
            <view class="image-remove" catchtap="onAdminRemoveImage" data-index="{{index}}">×</view>
          </view>

          <view
            wx:if="{{adminCanAddImage}}"
            class="image-tile image-uploader {{adminForm.images.length ? '' : 'large'}} pressable"
            hover-class="is-pressed"
            hover-stay-time="80"
            bindtap="onAdminChooseImage"
          >
            <text class="image-plus">＋</text>
            <text class="image-title">添加图片</text>
            <text class="image-subtitle">可多选上传</text>
          </view>

          <view wx:if="{{adminForm.imageUploading}}" class="image-upload-mask" catchtap="noop">
            <view class="upload-progress-card">
              <text class="upload-progress-percent">{{adminForm.imageUploadProgress}}%</text>
              <text class="upload-progress-text">{{adminForm.imageUploadText}}</text>
            </view>
          </view>
        </view>

        <input
          class="title-input"
          value="{{adminForm.title}}"
          data-field="title"
          placeholder="{{adminForm.listingType === 'sublet' ? '房源标题（必填）' : '商品名称（必填）'}}"
          placeholder-class="input-placeholder"
          bindinput="onAdminFormInput"
        />

        <textarea
          class="desc-input"
          value="{{adminForm.desc}}"
          data-field="desc"
          placeholder="{{adminForm.listingType === 'sublet' ? '描述房型、交通、租期和费用等' : '描述品牌、状态、瑕疵等'}}"
          placeholder-class="input-placeholder"
          maxlength="500"
          bindinput="onAdminFormInput"
        />
      </view>

      <view class="section-card">
        <view class="section-head compact">
          <view>
            <text class="section-kicker">Details</text>
            <text class="section-title">{{adminForm.listingType === 'sublet' ? '房源信息' : '商品信息'}}</text>
          </view>
        </view>

        <view class="form-list">
          <picker range="{{listingTypeOptions}}" range-key="label" value="{{adminListingTypeIndex}}" bindchange="onAdminListingTypeChange">
            <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80">
              <view class="row-label">类型</view>
              <view class="row-value">
                <text>{{listingTypeOptions[adminListingTypeIndex].label}}</text>
                <text class="row-arrow">›</text>
              </view>
            </view>
          </picker>

          <picker range="{{adminCategoryOptions}}" value="{{adminCategoryIndex}}" bindchange="onAdminCategoryChange">
            <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80">
              <view class="row-label">{{adminForm.listingType === 'sublet' ? '房型' : '类型'}}</view>
              <view class="row-value">
                <text>{{adminForm.category}}</text>
                <text class="row-arrow">›</text>
              </view>
            </view>
          </picker>

          <view class="form-row">
            <view class="row-label">{{adminForm.listingType === 'sublet' ? '月租' : '价格'}}</view>
            <view class="price-control">
              <text class="currency">$</text>
              <input class="price-input" type="digit" value="{{adminForm.price}}" data-field="price" placeholder="0.00" placeholder-class="price-placeholder" bindinput="onAdminFormInput" />
            </view>
          </view>

          <view class="form-row">
            <view class="row-label">状态</view>
            <view class="row-value">
              <input class="small-number-input" value="{{adminForm.condition}}" data-field="condition" placeholder="99新/转租" placeholder-class="price-placeholder" bindinput="onAdminFormInput" />
            </view>
          </view>

          <view class="form-row">
            <view class="row-label">显示名字</view>
            <view class="row-value">
              <input class="small-number-input" value="{{adminForm.sellerName}}" data-field="sellerName" placeholder="联系人" placeholder-class="price-placeholder" bindinput="onAdminFormInput" />
            </view>
          </view>

          <view class="form-row">
            <view class="row-label">微信号</view>
            <view class="row-value">
              <input class="small-number-input" value="{{adminForm.sellerWechat}}" data-field="sellerWechat" placeholder="微信号" placeholder-class="price-placeholder" bindinput="onAdminFormInput" />
            </view>
          </view>

          <view class="form-row">
            <view class="row-label">手机号</view>
            <view class="row-value">
              <input class="small-number-input" value="{{adminForm.sellerPhone}}" data-field="sellerPhone" placeholder="选填" placeholder-class="price-placeholder" bindinput="onAdminFormInput" />
            </view>
          </view>

          <picker range="{{cityOptions}}" range-key="label" value="{{adminCityIndex}}" bindchange="onAdminCityChange">
            <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80">
              <view class="row-label">城市</view>
              <view class="row-value">
                <text>{{adminForm.cityLabel}}</text>
                <text class="row-arrow">›</text>
              </view>
            </view>
          </picker>

          <picker range="{{adminAreaOptions}}" range-key="label" value="{{adminAreaIndex}}" bindchange="onAdminAreaChange">
            <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80">
              <view class="row-label">区域</view>
              <view class="row-value">
                <text>{{adminForm.regionArea}}</text>
                <text class="row-arrow">›</text>
              </view>
            </view>
          </picker>

          <view class="form-row">
            <view class="row-label">大楼名称</view>
            <view class="row-value">
              <input class="small-number-input" value="{{adminForm.buildingName}}" data-field="buildingName" placeholder="例如 The Modern" placeholder-class="price-placeholder" bindinput="onAdminFormInput" />
            </view>
          </view>

          <view class="form-row">
            <view class="row-label">导入ID</view>
            <view class="row-value">
              <input class="small-number-input" value="{{adminForm.externalId}}" data-field="externalId" placeholder="选填" placeholder-class="price-placeholder" bindinput="onAdminFormInput" />
            </view>
          </view>

          <picker mode="date" value="{{adminForm.pickupStartDate}}" data-field="pickupStartDate" bindchange="onAdminDateChange">
            <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80">
              <view class="row-label">{{adminForm.listingType === 'sublet' ? '入住时间' : '可取开始'}}</view>
              <view class="row-value">
                <text>{{adminForm.pickupStartDate}}</text>
                <text class="row-arrow">›</text>
              </view>
            </view>
          </picker>

          <picker mode="date" value="{{adminForm.pickupEndDate}}" data-field="pickupEndDate" bindchange="onAdminDateChange">
            <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80">
              <view class="row-label">{{adminForm.listingType === 'sublet' ? '租期结束' : '可取结束'}}</view>
              <view class="row-value">
                <text>{{adminForm.pickupEndDate}}</text>
                <text class="row-arrow">›</text>
              </view>
            </view>
          </picker>

          <block wx:if="{{adminShowSubletFields}}">
            <view class="form-row">
              <view class="row-label">押金</view>
              <view class="price-control">
                <text class="currency">$</text>
                <input class="price-input" type="digit" value="{{adminForm.deposit}}" data-field="deposit" placeholder="可不填" placeholder-class="price-placeholder" bindinput="onAdminFormInput" />
              </view>
            </view>

            <view class="form-row">
              <view class="row-label">房源类型</view>
              <view class="row-value">
                <input class="small-number-input" value="{{adminForm.housingType}}" data-field="housingType" placeholder="公寓/Condo" placeholder-class="price-placeholder" bindinput="onAdminFormInput" />
              </view>
            </view>

            <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80" data-field="furnished" bindtap="onAdminSwitchTap">
              <view class="row-label">带家具</view>
              <view class="row-value toggle-value">
                <text>{{adminForm.furnished ? '带家具' : '未标注'}}</text>
                <view class="mini-toggle {{adminForm.furnished ? 'on' : ''}}">
                  <view class="mini-toggle-knob"></view>
                </view>
              </view>
            </view>

            <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80" data-field="utilitiesIncluded" bindtap="onAdminSwitchTap">
              <view class="row-label">水电网</view>
              <view class="row-value toggle-value">
                <text>{{adminForm.utilitiesIncluded ? '已包含' : '未包含'}}</text>
                <view class="mini-toggle {{adminForm.utilitiesIncluded ? 'on' : ''}}">
                  <view class="mini-toggle-knob"></view>
                </view>
              </view>
            </view>

            <view class="form-row">
              <view class="row-label">室友要求</view>
              <view class="row-value">
                <input class="small-number-input" value="{{adminForm.genderPreference}}" data-field="genderPreference" placeholder="不限" placeholder-class="price-placeholder" bindinput="onAdminFormInput" />
              </view>
            </view>

            <view class="form-row">
              <view class="row-label">室友数</view>
              <view class="row-value">
                <input class="small-number-input" type="number" value="{{adminForm.roommateCount}}" data-field="roommateCount" placeholder="可不填" placeholder-class="price-placeholder" bindinput="onAdminFormInput" />
              </view>
            </view>
          </block>

          <view class="form-row location-row">
            <view class="row-label">区域大楼</view>
            <view class="row-value location-value">
              <text>{{adminRegionDisplay}}</text>
            </view>
          </view>

          <view class="form-row location-row pressable" hover-class="row-pressed" hover-stay-time="80" bindtap="onAdminChooseLocation">
            <view class="row-label">详细地址</view>
            <view class="row-value location-value">
              <text class="{{adminDetailAddressMutedClass}}">{{adminDetailAddressDisplay}}</text>
              <text class="row-arrow">›</text>
            </view>
          </view>
        </view>
      </view>

      <view class="admin-submit-row">
        <view class="admin-submit-btn secondary pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onAdminSaveDraft">保存草稿</view>
        <view class="admin-submit-btn template pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onAdminSaveTemplate">保存模板</view>
        <view class="admin-submit-btn primary pressable" hover-class="submit-pressed" hover-stay-time="80" bindtap="onAdminPublishDrafts">{{adminLoading ? '发布中...' : '批量发布'}}</view>
      </view>

      <view wx:if="{{adminDrafts.length}}" class="admin-list">
        <view class="admin-list-title">草稿</view>
        <view class="admin-draft-row" wx:for="{{adminDrafts}}" wx:key="draftKey" wx:for-index="index">
          <view class="admin-draft-main">
            <text class="admin-draft-title">{{index + 1}}. {{item.title || '未命名'}}</text>
            <text class="admin-draft-meta">{{item.cityLabel}} / {{item.regionArea}} / {{item.sellerWechat}}</text>
          </view>
          <view class="admin-row-btn" data-index="{{index}}" bindtap="onAdminEditDraft">编辑</view>
          <view class="admin-row-btn danger" data-index="{{index}}" bindtap="onAdminRemoveDraft">删除</view>
        </view>
      </view>

      <view wx:if="{{adminResults.length || adminFailures.length}}" class="admin-list">
        <view class="admin-list-title">发布结果</view>
        <view class="admin-draft-row" wx:for="{{adminResults}}" wx:key="id">
          <view class="admin-draft-main">
            <text class="admin-draft-title">{{item.title}}</text>
            <text class="admin-draft-meta">{{item.id}}</text>
          </view>
          <view class="admin-row-btn" data-id="{{item.id}}" bindtap="onOpenPublished">打开</view>
          <view class="admin-row-btn" data-id="{{item.id}}" data-type="{{item.listingType}}" bindtap="onEditPublished">编辑</view>
        </view>
        <view class="admin-failure-row" wx:for="{{adminFailures}}" wx:key="index">
          第{{item.index + 1}}条失败：{{item.error}}
        </view>
      </view>
    </view>

    <view wx:if="{{listEmpty}}" class="empty-state">
      <view class="empty-mark">⌕</view>
      <view class="empty-title">暂无记录</view>
      <view class="empty-subtitle">有交易后会显示在这里</view>
    </view>

    <view
      class="trade-card pressable"
      wx:for="{{list}}"
      wx:key="id"
      hover-class="card-pressed"
      hover-stay-time="80"
      bindtap="onOpenDetail"
      data-id="{{item.id}}"
    >
      <image
        wx:if="{{item.hasImage}}"
        class="thumb"
        src="{{item.imageSrc}}"
        mode="aspectFill"
        lazy-load="true"
      />
      <view wx:else class="thumb text-thumb">
        <text>{{item.title}}</text>
      </view>

      <view class="trade-main">
        <text class="item-title">{{item.title}}</text>
        <text class="item-meta">{{item.metaText}}</text>
        <text class="price">$ {{item.priceDisplay}}</text>
      </view>

      <view
        class="contact-chip pressable"
        catchtap="onCopyWechat"
        hover-class="is-pressed"
        hover-stay-time="80"
        data-wx="{{item.contactWechat}}"
      >
        {{contactRoleText}}
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>
</view>
