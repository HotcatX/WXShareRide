<timeline-preview wx:if="{{isTimelinePreview}}" id="timeline-preview" context="{{timelineContext}}" />
<block wx:elif="{{timelinePageReady}}">
<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content">
    <text class="nav-title">{{pageTitle}}</text>
  </view>
</view>

<view class="container">

  <view class="avatar-section">
    <button
      class="avatar-wrapper"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
    >
      <view class="avatar-border">
        <image class="avatar" src="{{avatarUrl}}" mode="aspectFill"/>
      </view>
    </button>
    <text class="avatar-tip">点击可更换头像</text>
  </view>

  <view class="form-card">

    <view class="form-item">
      <text class="label">昵称</text>
      <view class="field-column">
        <input
          class="input"
          type="nickname"
          placeholder="选填"
          data-field="name"
          bindinput="onInput"
          value="{{name}}"
        />
      </view>
    </view>

    <view class="form-item">
      <text class="label">微信号</text>
      <view class="field-column">
        <input
          class="input"
          placeholder="请输入微信号"
          data-field="wechat"
          bindinput="onInput"
          value="{{wechat}}"
        />
      </view>
    </view>

    <view class="form-item">
      <text class="label">手机号</text>
      <view class="field-row">
        <picker
          class="picker"
          mode="selector"
          range="{{regions}}"
          value="{{regionIndex}}"
          bindchange="onRegionChange"
        >
          <view class="picker-inner">
            {{ regions[regionIndex] }}
          </view>
        </picker>
        <input
          class="input"
          placeholder="选填，建议填美国号码"
          data-field="phone"
          bindinput="onInput"
          value="{{phone}}"
        />
      </view>
    </view>

    <view class="form-item">
      <text class="label">Zelle名字</text>
      <view class="field-column">
        <input
          class="input"
          placeholder="选填，用于收款姓名"
          data-field="zelleName"
          bindinput="onInput"
          value="{{zelleName}}"
        />
      </view>
    </view>

    <view class="form-item">
      <text class="label">Zelle账号</text>
      <view class="field-column">
        <input
          class="input"
          placeholder="选填，邮箱或手机号"
          data-field="zelleAccount"
          bindinput="onInput"
          value="{{zelleAccount}}"
        />
      </view>
    </view>

  </view>

  <view class="buttons">
    <button class="btn main-btn" type="primary" bindtap="onComplete">
      完成信息
    </button>
  </view>
</view>
</block>
