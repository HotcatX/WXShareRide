.market-page{
  height: 100vh;
  overflow: hidden;
  background: #f4f6f8;
  color: #14171a;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.market-top{
  background: #f4f6f8;
  border-bottom: 1rpx solid rgba(20,23,26,0.06);
  box-shadow: 0 8rpx 28rpx rgba(20,23,26,0.04);
  z-index: 2;
}

.market-search-row{
  min-height: 88rpx;
  padding: 12rpx 24rpx 8rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.region-entry{
  width: 178rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #111418;
  box-sizing: border-box;
}

.region-text{
  max-width: 136rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 31rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.region-caret,
.filter-caret{
  color: #69727d;
  font-size: 28rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.search-box{
  min-width: 0;
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid rgba(20,23,26,0.06);
  padding: 0 8rpx 0 18rpx;
  box-shadow: 0 8rpx 24rpx rgba(20,23,26,0.06);
  box-sizing: border-box;
}

.search-symbol{
  flex: none;
  color: #0f9b95;
  font-size: 34rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.search-input{
  flex: 1;
  min-width: 0;
  height: 64rpx;
  color: #111418;
  font-size: 25rpx;
  font-weight: 800;
}

.search-placeholder{
  color: #9aa3ad;
  font-weight: 700;
}

.clear-keyword{
  flex: none;
  width: 42rpx;
  height: 42rpx;
  border-radius: 999rpx;
  background: rgba(20,23,26,0.08);
  color: #69727d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 42rpx;
}

.search-submit{
  flex: none;
  min-width: 78rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #111418;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.filter-row{
  min-height: 64rpx;
  padding: 4rpx 20rpx 12rpx;
  display: grid;
  grid-template-columns: 1.25fr 0.9fr 0.9fr 0.9fr;
  gap: 8rpx;
  box-sizing: border-box;
}

.filter-chip{
  min-width: 0;
  height: 54rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  border-radius: 12rpx;
  color: #59636f;
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.filter-chip.active{
  color: #0f817c;
  background: rgba(15,155,149,0.10);
}

.filter-chip text:first-child{
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-scroll{
  flex: 1;
  min-height: 0;
  padding: 14rpx 20rpx 0;
  box-sizing: border-box;
}

.result-row{
  height: 42rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.result-title{
  font-size: 29rpx;
  line-height: 36rpx;
  font-weight: 900;
  color: #111418;
}

.result-count{
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
  color: #69727d;
}

.market-grid,
.skeleton-grid{
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  align-items: start;
}

.market-card{
  position: relative;
  min-width: 0;
  overflow: hidden;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(20,23,26,0.07);
  border: 1rpx solid rgba(20,23,26,0.05);
  box-sizing: border-box;
}

.card-media{
  width: 100%;
  height: 270rpx;
  position: relative;
  overflow: hidden;
  background: #e9edf1;
}

.market-card--goods .card-media{
  height: 218rpx;
}

.market-card--sublet .card-media{
  height: 300rpx;
}

.card-photo{
  width: 100%;
  height: 100%;
}

.card-photo{
  display: block;
}

.no-photo{
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 26rpx;
  background: linear-gradient(135deg, #e8f4f2 0%, #f2f0ea 100%);
  color: #111418;
  text-align: center;
  box-sizing: border-box;
}

.no-photo text{
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
  word-break: break-all;
}

.card-badge{
  position: absolute;
  right: 10rpx;
  top: 10rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: rgba(255,255,255,0.92);
  color: #111418;
  font-size: 19rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.card-body{
  min-height: 188rpx;
  padding: 14rpx 16rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-sizing: border-box;
}

.market-card--goods .card-body{
  min-height: 112rpx;
  padding: 12rpx 14rpx 14rpx;
  gap: 10rpx;
}

.market-card--sublet .card-body{
  min-height: 224rpx;
}

.card-title{
  color: #111418;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 900;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.card-desc{
  min-height: 30rpx;
  color: #59636f;
  font-size: 21rpx;
  line-height: 30rpx;
  font-weight: 700;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-word;
}

.card-price{
  color: #f05d4f;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.goods-title-price-row{
  min-width: 0;
  height: 40rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.goods-card-title{
  min-width: 0;
  flex: 1;
  color: #111418;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-card-price{
  flex: none;
  max-width: 120rpx;
  color: #f05d4f;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-meta-row{
  min-width: 0;
  height: 36rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
}

.goods-seller-touch{
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.goods-seller-avatar{
  width: 32rpx;
  height: 32rpx;
}

.goods-seller-name{
  font-size: 20rpx;
  line-height: 28rpx;
}

.goods-distance,
.goods-views{
  flex: none;
  color: #69727d;
  font-size: 18rpx;
  line-height: 26rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.goods-distance{
  max-width: 72rpx;
}

.goods-views{
  color: #9aa3ad;
}

.card-seller-row{
  min-width: 0;
  margin-top: auto;
  height: 44rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.seller-touch{
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.seller-avatar{
  width: 38rpx;
  height: 38rpx;
  flex: none;
  border-radius: 999rpx;
  background: #e9edf1;
}

.seller-name{
  min-width: 0;
  display: block;
  color: #30363d;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-location{
  max-width: 84rpx;
  flex: none;
  color: #69727d;
  font-size: 19rpx;
  line-height: 28rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-views{
  flex: none;
  color: #9aa3ad;
  font-size: 18rpx;
  line-height: 26rpx;
  font-weight: 800;
}

.ad-card-row{
  margin-top: auto;
  color: #69727d;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 800;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ad-compact-title-row{
  min-width: 0;
  height: 40rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ad-compact-title{
  min-width: 0;
  flex: 1;
  color: #111418;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ad-compact-cta{
  flex: none;
  max-width: 88rpx;
  color: #0f9b95;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ad-compact-desc{
  color: #69727d;
  font-size: 20rpx;
  line-height: 28rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ad-card-title{
  color: #111418;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 900;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  word-break: break-all;
}

.ad-card-desc{
  color: #59636f;
  font-size: 21rpx;
  line-height: 30rpx;
  font-weight: 700;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.ad-contact-trigger{
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 5;
  width: 100%;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 18rpx;
  background: transparent;
  opacity: 0;
}

.ad-contact-trigger::after{
  border: 0;
}

.skeleton-card{
  height: 448rpx;
  border-radius: 18rpx;
  background: #ffffff;
  padding: 14rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(20,23,26,0.06);
}

.skeleton-img,
.skeleton-line{
  background: #e8edf2;
  border-radius: 12rpx;
}

.skeleton-img{
  height: 270rpx;
}

.skeleton-line{
  height: 26rpx;
  margin-top: 18rpx;
}

.skeleton-line.wide{
  width: 88%;
}

.skeleton-line.short{
  width: 48%;
}

.empty-state{
  min-height: 520rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 50rpx 28rpx;
  box-sizing: border-box;
}

.empty-mark{
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #ffffff;
  color: #0f9b95;
  box-shadow: 0 8rpx 24rpx rgba(20,23,26,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 900;
  line-height: 96rpx;
}

.empty-title{
  margin-top: 24rpx;
  color: #111418;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.empty-subtitle{
  margin-top: 8rpx;
  color: #69727d;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.empty-action{
  margin-top: 28rpx;
  min-width: 176rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: #111418;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.loading-more,
.view-more{
  height: 72rpx;
  margin: 20rpx 0 0;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #69727d;
  font-size: 26rpx;
  font-weight: 800;
}

.view-more{
  background: #ffffff;
  color: #111418;
  box-shadow: 0 6rpx 18rpx rgba(20,23,26,0.06);
}

.bottom-spacer{
  height: calc(196rpx + env(safe-area-inset-bottom));
}

.market-float-actions{
  position: fixed;
  right: 34rpx;
  bottom: calc(158rpx + env(safe-area-inset-bottom));
  z-index: 9998;
  display: flex;
  pointer-events: none;
  transition-property: opacity, transform;
  transition-duration: 120ms;
}

.market-float-actions.fab-hidden{
  opacity: 0;
  transform: translateY(28rpx) scale(0.92);
  pointer-events: none;
}

.float-action{
  width: 118rpx;
  height: 118rpx;
  padding: 0;
  border-radius: 999rpx;
  box-shadow: 0 18rpx 44rpx rgba(17,20,24,0.24);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
  box-sizing: border-box;
  pointer-events: auto;
}

.float-action.primary{
  background: #0f9b95;
  color: #ffffff;
  border: 1rpx solid rgba(255,255,255,0.20);
  box-shadow: 0 18rpx 44rpx rgba(15,155,149,0.26);
}

.float-action-plus{
  height: 42rpx;
  color: #ffffff;
  font-size: 46rpx;
  line-height: 42rpx;
  font-weight: 800;
}

.float-action-text{
  color: #ffffff;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 900;
}

.rp-mask{
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17,20,24,0.38);
  z-index: 10000;
}

.rp-panel{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-top-left-radius: 22rpx;
  border-top-right-radius: 22rpx;
  z-index: 10001;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -18rpx 40rpx rgba(17,20,24,0.14);
}

.rp-header{
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 26rpx;
  border-bottom: 1rpx solid rgba(20,23,26,0.08);
  box-sizing: border-box;
}

.rp-title{
  color: #111418;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.rp-btn{
  min-width: 96rpx;
  height: 64rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #69727d;
  font-size: 28rpx;
  font-weight: 900;
}

.rp-btn.ok{
  color: #0f9b95;
}

.rp-picker{
  height: 520rpx;
}

.rp-item{
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #111418;
  font-size: 32rpx;
  line-height: 40rpx;
  font-weight: 800;
}

.city-panel{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10001;
  height: min(76vh, 980rpx);
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  border-top-left-radius: 22rpx;
  border-top-right-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 -18rpx 40rpx rgba(17,20,24,0.14);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.city-header{
  height: 92rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid rgba(20,23,26,0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.city-title{
  color: #111418;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.city-close{
  min-width: 96rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #69727d;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.city-body{
  min-height: 0;
  flex: 1;
  display: grid;
  grid-template-columns: 168rpx minmax(0, 1fr);
}

.city-country-tabs{
  padding: 18rpx 0;
  background: #f4f6f8;
}

.city-country{
  height: 82rpx;
  padding-left: 24rpx;
  border-left: 8rpx solid transparent;
  color: #59636f;
  display: flex;
  align-items: center;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.city-country.active{
  color: #0f9b95;
  border-left-color: #0f9b95;
  background: #ffffff;
  font-weight: 900;
}

.city-group-scroll{
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.city-group{
  padding: 24rpx 22rpx 8rpx;
}

.city-group-title{
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #111418;
  font-size: 29rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.city-hot-badge{
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 8rpx;
  background: #ff6a3d;
  color: #ffffff;
  display: flex;
  align-items: center;
  font-size: 22rpx;
  line-height: 34rpx;
  font-style: italic;
  font-weight: 900;
}

.city-grid{
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.city-option{
  min-width: 0;
  height: 66rpx;
  padding: 0 12rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  color: #59636f;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 25rpx;
  line-height: 32rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.city-option.active{
  background: #0f9b95;
  color: #ffffff;
  box-shadow: 0 8rpx 18rpx rgba(15,155,149,0.22);
}

.category-mask{
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17,20,24,0.38);
  z-index: 10000;
}

.category-panel{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10001;
  padding: 0 24rpx calc(28rpx + env(safe-area-inset-bottom));
  border-top-left-radius: 22rpx;
  border-top-right-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 -18rpx 40rpx rgba(17,20,24,0.14);
  box-sizing: border-box;
}

.category-panel-header{
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(20,23,26,0.08);
  box-sizing: border-box;
}

.category-panel-title{
  color: #111418;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.category-panel-close{
  min-width: 96rpx;
  height: 64rpx;
  border-radius: 14rpx;
  color: #69727d;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 26rpx;
  font-weight: 900;
}

.category-option-grid{
  padding-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.category-option{
  min-width: 0;
  height: 58rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f4f6f8;
  color: #59636f;
  border: 1rpx solid rgba(20,23,26,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.category-option.active{
  background: #0f9b95;
  color: #ffffff;
  border-color: #0f9b95;
  box-shadow: 0 8rpx 18rpx rgba(15,155,149,0.22);
}

.pressable{
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 120ms;
}

.is-pressed{
  opacity: 0.82;
  transform: scale(0.97);
}

.card-pressed{
  opacity: 0.9;
  transform: scale(0.985);
}
