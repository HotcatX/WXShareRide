<timeline-preview wx:if="{{isTimelinePreview}}" id="timeline-preview" context="{{timelineContext}}" />
<block wx:elif="{{timelinePageReady}}">
<view class="ride-shell history-ride">
  <view class="ride-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar ride-topbar--center">
      <view
        class="ride-back ride-back-text"
        bindtap="goBack"
        hover-class="ride-pressed"
        hover-stay-time="80"
      >
        <text>‹</text>
      </view>
      <text class="ride-nav-title">{{pageTitle}}</text>
    </view>
  </view>

  <scroll-view class="ride-scroll history-scroll" scroll-y enhanced="true" show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="ride-state">
      正在加载历史行程
    </view>

    <view wx:elif="{{!historyTrips || historyTrips.length === 0}}" class="ride-state">
      暂无历史行程
    </view>

    <block wx:else>
      <view
        class="ride-card ride-list-card history-card"
        wx:for="{{historyTrips}}"
        wx:for-item="trip"
        wx:for-index="index"
        wx:key="_id"
        data-id="{{trip._id}}"
        data-index="{{index}}"
        bindtap="goTripDetail"
        hover-class="ride-card-pressed"
        hover-stay-time="80"
      >
        <view class="ride-list-head">
          <text class="ride-list-kind">历史行程</text>
          <text class="ride-list-time">{{trip._timeLabel || '时间待定'}}</text>
        </view>

        <view class="ride-route">
          <view class="ride-route-rail">
            <view class="ride-dot"></view>
            <view class="ride-line"></view>
            <view class="ride-dot ride-dot--accent"></view>
          </view>
          <view class="ride-route-body">
            <view class="ride-route-point">
              <text class="ride-route-label">出发</text>
              <text class="ride-route-name">{{trip._fromAddress}}</text>
            </view>
            <view class="ride-route-point">
              <text class="ride-route-label">到达</text>
              <text class="ride-route-name">{{trip._toAddress}}</text>
            </view>
          </view>
        </view>

        <view class="ride-meta history-meta">
          <text class="ride-chip ride-chip--accent">{{trip._roleLabel}}</text>
        </view>
      </view>
    </block>

    <view class="ride-bottom-space"></view>
  </scroll-view>
  <view wx:if="{{followupVisible}}" class="history-followup-mask" bindtap="onFollowupClose" catchtouchmove="onFollowupTouch">
    <view class="history-followup-panel" catchtap="onFollowupTouch" aria-role="dialog" aria-label="行程回访">
      <view class="history-followup-head">
        <text class="history-followup-title">行程回访</text>
        <view class="history-followup-close" bindtap="onFollowupClose" aria-role="button" aria-label="稍后回答">×</view>
      </view>
      <text class="history-followup-time">{{followupTime}}</text>
      <text wx:if="{{followupRoute}}" class="history-followup-route">{{followupRoute}}</text>
      <text class="history-followup-question">{{followupQuestion}}</text>
      <text class="history-followup-note">可关闭后稍后回答，不影响使用。</text>
      <text wx:if="{{followupError}}" class="history-followup-error">{{followupError}}</text>
      <view class="history-followup-actions">
        <button class="history-followup-no" data-outcome="no" bindtap="onFollowupAnswer" disabled="{{followupBusy}}">否</button>
        <button class="history-followup-yes" data-outcome="yes" bindtap="onFollowupAnswer" disabled="{{followupBusy}}">是</button>
      </view>
    </view>
  </view>
</view>
</block>
