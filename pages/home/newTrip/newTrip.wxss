@import "../../../styles/ride-calendar.wxss";

page{
  background: #f4f6f8;
}

.create-ride{
  background: #f4f6f8;
}

.create-scroll{
  padding-top: 10rpx;
}

.create-card-head{
  margin-bottom: 10rpx;
}

.create-card-head .ride-section-subtitle{
  display: block;
  margin-top: 2rpx;
}

.create-route-card{
  margin-top: 0;
}

.create-ride .ride-card-pad{
  padding: 16rpx;
}

.create-ride .ride-form-grid{
  gap: 8rpx;
}

/* 基础输入框容器 */
.create-ride .ride-field{
  min-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}

/* 横向输入项：左标题 + 右内容 */
.create-ride .ride-field-inline{
  height: 64rpx;
  padding: 0 18rpx;

  display: flex;
  flex-direction: row;
  align-items: center;
}

/* 左侧标题 */
.create-ride .ride-field-label{
  flex: 0 0 96rpx;
  margin: 0;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 800;
  color: #111418;
}

/* 右侧 picker 显示值 */
.create-ride .ride-field-inline-value{
  flex: 1;
  min-width: 0;

  display: flex;
  align-items: center;
  justify-content: flex-end;

  height: 100%;
  min-height: 64rpx;

  margin: 0;
  padding: 0;

  font-size: 20rpx;
  line-height: 1;

  color: #111418;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 右侧 input */
.create-ride .ride-input-inline{
  flex: 1;
  min-width: 0;
  height: 32rpx;
  min-height: 32rpx;
  margin: 0;
  padding: 0;
  text-align: right;
  font-size: 18rpx;
  line-height: 28rpx;
  color: #111418;
}

.create-ride .ride-price-input-wrap{
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
}

.create-ride .create-price-input{
  flex: 0 1 150rpx;
  text-align: right;
}

.create-ride .ride-input-suffix{
  flex: none;
  font-size: 22rpx;
  line-height: 32rpx;
  font-weight: 900;
  color: #111418;
}

/* 普通 input 兜底 */
.create-ride .ride-input{
  margin-top: 0;
  height: 32rpx;
  min-height: 32rpx;
  font-size: 22rpx;
  line-height: 32rpx;
}

/* picker 占满宽度 */
.create-ride picker{
  display: block;
  width: 100%;
}

/* picker 内部字段占满 */
.create-ride picker .ride-field-inline{
  width: 100%;
  box-sizing: border-box;
}

/* placeholder 灰色 */
.create-ride .ride-placeholder{
  color: #9aa3ad !important;
  font-weight: 500;
}

/* input placeholder 灰色 */
.create-ride .ride-input-inline::placeholder,
.create-ride .ride-input::placeholder{
  color: #9aa3ad;
}

/* 微信小程序 placeholder-class */
.create-ride input.ride-placeholder,
.create-ride .ride-input.ride-placeholder{
  color: #9aa3ad !important;
}

/* 备注区域 */
.create-ride .create-textarea-field{
  min-height: 112rpx;
  padding: 14rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
}

/* 备注标题：与其他标题一致 */
.create-ride .create-textarea-field .ride-field-label{
  flex: none;
  margin: 0;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 800;
  color: #111418;
}

/* 备注输入框 */
.create-ride .ride-textarea{
  width: 100%;
  margin-top: 8rpx;
  padding: 0;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #111418;
  box-sizing: border-box;
}

/* 车辆摘要与可展开的可选项 */
.create-profile-summary,
.create-optional-row{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 68rpx;
  font-size: 23rpx;
  line-height: 32rpx;
}

.create-profile-summary{
  margin-top: 8rpx;
  padding: 4rpx 4rpx 0;
  color: #687580;
}

.create-profile-text{
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.create-profile-link{
  flex: none;
  color: #0e8986;
  font-size: 23rpx;
}

.create-optional-row{
  padding: 0 4rpx;
  border-top: 1rpx solid #edf0f2;
  color: #687580;
}

.create-optional-arrow{
  color: #0e8986;
  font-size: 28rpx;
}

/* 最近发布与手动模板共用轻量入口，不占用表单空间。 */
.create-shortcut-section{ margin: 0 0 20rpx; }
.create-section-heading{ display: flex; align-items: center; justify-content: space-between; gap: 10rpx; margin: 0 4rpx 12rpx; }
.create-section-labels{ display: flex; align-items: baseline; gap: 12rpx; min-width: 0; }
.create-section-title{ color: #111418; font-size: 25rpx; font-weight: 800; }
.create-section-caption{ color: #7b858e; font-size: 20rpx; }
.create-manage-link{ flex: none; padding: 12rpx 0 12rpx 8rpx; color: #0e8986; font-size: 21rpx; }
.create-shortcut-scroll{ width: 100%; white-space: nowrap; }
.create-shortcut-track{ display: inline-flex; gap: 12rpx; padding: 1rpx 1rpx 4rpx; }
.create-shortcut-card{ width: 310rpx; padding: 16rpx 18rpx; background: #fff; border: 1rpx solid #dcebea; border-radius: 18rpx; box-sizing: border-box; }
.create-shortcut-top, .create-shortcut-bottom{ display: flex; align-items: center; justify-content: space-between; gap: 8rpx; }
.create-shortcut-title{ color: #0d7f7c; font-size: 23rpx; font-weight: 700; overflow: hidden; text-overflow: ellipsis; }
.create-shortcut-time{ color: #111418; font-size: 27rpx; font-weight: 800; }
.create-shortcut-route{ display: flex; align-items: center; gap: 10rpx; margin: 10rpx 0; font-size: 23rpx; font-weight: 600; color: #273239; }
.create-shortcut-route text{ min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.create-shortcut-arrow{ color: #0e8986; flex: none; }
.create-shortcut-bottom{ color: #869098; font-size: 20rpx; }
.create-shortcut-use{ color: #0e8986; }
.create-shortcut-pressed{ background: #e8f5f3; }
.create-recent-placeholder{ padding: 18rpx; border: 1rpx dashed #d9e2e5; border-radius: 14rpx; color: #7b858e; font-size: 22rpx; }
.create-recent-retry{ color: #0e8986; }
.create-saved-scroll{ margin-top: 10rpx; }
.create-saved-template{ display: inline-flex; align-items: center; gap: 10rpx; min-height: 62rpx; max-width: 520rpx; padding: 0 16rpx; background: #fff; border: 1rpx solid #e1e6e9; border-radius: 12rpx; font-size: 22rpx; color: #59636f; }
.create-saved-template text{ overflow: hidden; text-overflow: ellipsis; }
.create-saved-badge{ flex: none; color: #0e8986; font-size: 19rpx; }
.create-return-hint{ display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; padding: 14rpx 18rpx; background: #e2f2f0; border-radius: 12rpx; color: #0d7f7c; font-size: 23rpx; }
.create-return-icon{ font-size: 30rpx; }
.create-published{ padding-top: 56rpx; text-align: center; }
.create-success-icon{ display: flex; align-items: center; justify-content: center; width: 100rpx; height: 100rpx; margin: 0 auto 24rpx; border-radius: 50%; background: #def2ef; color: #0e8986; font-size: 56rpx; }
.create-success-title{ display: block; font-size: 36rpx; font-weight: 800; color: #111418; }
.create-success-subtitle{ display: block; margin: 12rpx 0 36rpx; font-size: 24rpx; color: #7b858e; }
.create-ride .create-published-card{ padding: 28rpx; text-align: left; }
.create-published-date{ color: #0e8986; font-size: 25rpx; font-weight: 700; }
.create-published-route{ display: flex; flex-wrap: wrap; align-items: center; gap: 20rpx; margin: 24rpx 0; color: #111418; font-size: 32rpx; font-weight: 800; }
.create-published-arrow{ color: #0e8986; }
.create-published-meta{ color: #687580; font-size: 24rpx; }
.create-success-hint{ display: block; margin-top: 26rpx; color: #869098; font-size: 22rpx; }
.create-success-actions{ display: flex; width: 100%; gap: 16rpx; }
.create-success-actions .ride-btn{ flex: 1; min-width: 0; margin: 0; white-space: nowrap; }
.create-success-actions .create-return-home{ flex: 0 0 34%; background: #eef1f3; color: #59636f; }

.create-notice-muted{
  margin-top: 14rpx;
  background: #ffffff;
  border-color: rgba(20,23,26,0.06);
}
