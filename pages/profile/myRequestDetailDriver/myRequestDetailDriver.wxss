/* pages/profile/myRequestDetailDriver/myRequestDetailDriver.wxss */

page{
  background: #F6EFE8;
}

.ui-page{
  height: 100vh;
  overflow: hidden;
  background: #F6EFE8;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏（保留原样） */
.nav-bar{
  width: 100%;
  background-color: #ffffff;
}
.nav-content{
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
}
.back-icon{
  width: 50rpx;
  height: 50rpx;
}
.nav-title{
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}

/* 加载中 */
.state-text{
  flex: 1;
  text-align: center;
  margin-top: 80rpx;
  font-size: 26rpx;
  color: rgba(0,0,0,0.45);
}
.state-card{
  margin: 80rpx 22rpx 0 22rpx;
  padding: 40rpx 28rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 14rpx 30rpx rgba(0,0,0,0.06);
  text-align: center;
}
.state-title{
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.5;
  color: rgba(0,0,0,0.68);
}
.state-action-btn{
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin-top: 28rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #9CB06A;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
}
.state-action-btn::after{ border: none; }

/* 中间滚动区（同款 padding） */
.ui-scroll{
  flex: 1;
  min-height: 0;
  padding: 22rpx 22rpx 0 22rpx;
  box-sizing: border-box;
}

/* 同款白卡：圆角+阴影 */
.ui-card{
  background: #fff;
  border-radius: 26rpx;
  padding: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 14rpx 30rpx rgba(0,0,0,0.06);
  margin-top: 18rpx;
}

/* 提示卡（轻提示体系） */
.ui-notice{
  border: 2rpx solid rgba(238,156,115,0.28);
  background: rgba(238,156,115,0.10);
  box-shadow: none;
}
.notice-title{
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.70);
  margin-bottom: 8rpx;
}
.notice-text{
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(0,0,0,0.55);
  line-height: 1.6;
}

/* 底部留空 */
.ui-bottom-space{
  height: calc(140rpx + env(safe-area-inset-bottom));
}

/* 底部固定白框 */
.ui-bottom-fixed{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}
.ui-bottom-bar{
  background: #fff;
  height: 160rpx;
  box-sizing: border-box;
  border-top: 2rpx solid rgba(0,0,0,0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 单按钮布局 */
.ui-bottom-bar--one{
  padding: 0 22rpx;
}

/* 统一按钮基础尺寸 */
.ui-secondary-btn,
.ui-danger-btn{
  width: 93%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 900;
}

/* ✅ 按你指定的按钮样式 */
.ui-secondary-btn{
  background: #9CB06A;
  color: #fff;
  border: none;
  box-shadow: 0 10rpx 22rpx rgba(0,0,0,0.06);
}

.ui-danger-btn{
  background: #FE814B;
  color: #fff;
  border: none;
  box-shadow: 0 10rpx 22rpx rgba(0,0,0,0.10);
}

/* 去掉 button 默认边框 */
.ui-secondary-btn::after,
.ui-danger-btn::after{
  border: none;
}

/* =========================
   顶部信息卡排版
   ========================= */
.route-row{
  display: flex;
  align-items: center;
}
.route-text-left,
.route-text-right{
  flex: 1;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 40rpx;
  color: rgba(0,0,0,0.78);
}
.route-text-left{ text-align: left; }
.route-text-right{ text-align: right; }

.route-arrow{
  width: 80rpx;
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
  line-height: 40rpx;
  color: rgba(0,0,0,0.45);
}

.time-seat-row{
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}
.time-text,
.seat-text{
  font-size: 30rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.60);
}

/* 卡片标题（与“已加入乘客”完全一致） */
.card-title{
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.75);
  margin-bottom: 16rpx;
  line-height: 1.2;
}


/* info-row */
.info-row{
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}
.label{
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.45);
  margin-right: 16rpx;
}
.value{
  flex: 1;
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.70);
}

/* =========================
   已加入乘客列表
   ========================= */
.empty-tip{
  font-size: 26rpx;
  color: rgba(0,0,0,0.45);
  padding: 6rpx 0 10rpx;
}

/* =========================
   已加入乘客列表（最终干净版：只用 Grid）
   ========================= */

   .passenger-item{
    display: flex;
    align-items: flex-start;
    padding: 16rpx 0;
    border-top: 2rpx solid rgba(0,0,0,0.06);
    gap: 18rpx;
  }
  .passenger-item:first-child{ border-top: none; }
  
  /* 左侧：头像上 + 名字下 */
  .passenger-left{
    width: 128rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }
  
  .passenger-avatar{
    width: 92rpx;
    height: 92rpx;
    border-radius: 50%;
  }
  
  .passenger-name{
    margin-top: 10rpx;
    font-size: 24rpx;
    font-weight: 900;
    color: rgba(0,0,0,0.78);
    text-align: center;
  
    width: 128rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  /* 右侧三行容器：行间距统一 */
  .passenger-right{
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12rpx;              /* ✅ 三行间距一致，建议 6~10 */
  }
  
  /* Grid 三列：label / value / button
     column-gap 控制“冒号与值”的间距（缩小到正常距离） */
  .pgrid{
    --label-w: 96rpx;       /* ✅ 标签列宽更紧凑（地址/微信/手机） */
    --btn-w: 102rpx;        /* ✅ 按钮列宽 */
    --btn-h: 36rpx;         /* ✅ 行高由按钮高度决定，三行统一 */
  
    display: grid;
    grid-template-columns: var(--label-w) 1fr var(--btn-w);
    column-gap: 6rpx;       /* ✅ 冒号后到值的“正常间距” */
    align-items: center;
    min-width: 0;
    min-height: 36rpx;
  }
  
  /* 地址可能两行：顶部对齐更自然，但行间距仍由 passenger-right gap 控制 */
  .pgrid--addr{
    align-items: start;
  }
  
  /* label：右对齐更像表单，且离冒号更贴合 */
  .pgrid-label{
    font-size: 24rpx;
    font-weight: 800;
    color: rgba(0,0,0,0.45);
    line-height: 34rpx;
    text-align: right;      /* ✅ 视觉更整齐 */
  }
  
  /* value：占中间列 */
  .pgrid-value{
    min-width: 0;
    font-size: 24rpx;
    font-weight: 800;
    color: rgba(0,0,0,0.70);
    line-height: 34rpx;
  
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  /* 地址允许两行 */
  .pgrid-value--addr{
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* 右侧占位：高度跟按钮一致，保证三行完全一致 */
  .pgrid-btn-placeholder{
    height: var(--btn-h);
  }
  
/* 复制按钮：更小更扁 + 白字黑体 + 文本严格居中 */

.copy-pill{
  width: var(--btn-w);
  height: var(--btn-h);
  border-radius: 999rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 20rpx;      /* ✅ 比信息字号小 */
  font-weight: 900;      /* ✅ 黑体/加粗 */
  line-height: 1;        /* ✅ 防止偏移 */
  color: #fff;           /* ✅ 白字 */
  background: #9CB06A;   /* ✅ 你截图里是绿色，我直接用同款绿；想灰/黑我也可改 */

  justify-self: end;     /* ✅ 第三列贴右 */
  align-self: center;    /* ✅ 行内垂直居中 */
}


/* 去掉 button 默认边框 */
.copy-btn::after{
  border: none;
}

/* 如果你仍然保留 size="mini"，需要把默认的外观也压住 */
.copy-btn[disabled]{
  opacity: 0.55;
}
