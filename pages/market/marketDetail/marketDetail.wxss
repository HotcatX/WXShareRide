.market-detail-page{
  height: 100vh;
  overflow: hidden;
  background: #f4f6f8;
  color: #111418;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.detail-top{
  background: #f4f6f8;
  border-bottom: 1rpx solid rgba(20,23,26,0.06);
  z-index: 2;
}

.detail-scroll{
  flex: 1;
  min-height: 0;
}

.detail-hero{
  height: 620rpx;
  margin: 18rpx 20rpx 0;
  border-radius: 22rpx;
  overflow: hidden;
  position: relative;
  background: #e9edf1;
  box-shadow: 0 12rpx 34rpx rgba(20,23,26,0.10);
}

.photo-swiper,
.hero-img,
.hero-no-img{
  width: 100%;
  height: 100%;
}

.hero-img{
  display: block;
}

.hero-no-img{
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #e8f4f2 0%, #f2f0ea 100%);
  color: #111418;
  text-align: center;
}

.hero-no-img text{
  font-size: 48rpx;
  line-height: 58rpx;
  font-weight: 900;
  word-break: break-all;
}

.hero-count{
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(17,20,24,0.58);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.detail-content{
  padding: 18rpx 20rpx 0;
  box-sizing: border-box;
}

.info-card,
.state-card{
  padding: 28rpx;
  border-radius: 22rpx;
  background: #ffffff;
  border: 1rpx solid rgba(20,23,26,0.05);
  box-shadow: 0 10rpx 28rpx rgba(20,23,26,0.07);
  box-sizing: border-box;
}

.seller-price-row{
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.seller-profile{
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.seller-avatar{
  width: 76rpx;
  height: 76rpx;
  flex: none;
  border-radius: 999rpx;
  background: #e9edf1;
}

.seller-copy{
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.seller-name-row{
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.seller-name{
  min-width: 0;
  display: block;
  color: #111418;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seller-region{
  color: #69727d;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-price{
  flex: none;
  max-width: 260rpx;
  color: #f05d4f;
  font-size: 40rpx;
  line-height: 50rpx;
  font-weight: 900;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-divider{
  height: 1rpx;
  margin: 24rpx 0;
  background: rgba(20,23,26,0.08);
}

.detail-title{
  display: block;
  color: #111418;
  font-size: 36rpx;
  line-height: 48rpx;
  font-weight: 900;
  word-break: break-word;
}

.detail-line{
  margin-top: 18rpx;
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.detail-label{
  flex: none;
  color: #9aa3ad;
  font-size: 26rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.detail-value{
  min-width: 0;
  color: #30363d;
  font-size: 26rpx;
  line-height: 38rpx;
  font-weight: 800;
  word-break: break-word;
}

.desc-text{
  display: block;
  margin-top: 22rpx;
  color: #30363d;
  font-size: 28rpx;
  line-height: 46rpx;
  font-weight: 700;
  word-break: break-word;
}

.location-section{
  margin-top: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.section-title{
  display: block;
  color: #111418;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.location-text{
  color: #59636f;
  font-size: 27rpx;
  line-height: 42rpx;
  font-weight: 700;
  word-break: break-word;
}

.detail-address-title{
  margin-top: 14rpx;
}

.detail-address-text{
  color: #69727d;
}

.meta-grid{
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.meta-cell{
  min-width: 0;
  min-height: 82rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: #f4f6f8;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
  box-sizing: border-box;
}

.meta-label{
  color: #69727d;
  font-size: 21rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.meta-value{
  min-width: 0;
  color: #111418;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.state-actions{
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.state-btn{
  min-height: 76rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #111418;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.06);
}

.detail-action-bar{
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 176rpx minmax(0, 1fr);
  gap: 10rpx;
  transition-property: opacity, transform;
  transition-duration: 120ms;
}

.detail-action-bar.single-action{
  grid-template-columns: minmax(0, 1fr);
}

.dock-hidden{
  opacity: 0;
  transform: translateY(18rpx);
  pointer-events: none;
}

.side-action,
.action-btn{
  height: 84rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.side-action{
  background: #ffffff;
  color: #111418;
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.06);
}

.action-btn.primary{
  background: #111418;
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(17,20,24,0.24);
}

.owner-actions{
  grid-column: 1 / -1;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.action-btn.secondary{
  background: #ffffff;
  color: #111418;
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.08);
}

.action-btn.danger{
  background: #f05d4f;
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(240,93,79,0.20);
}

.bottom-space{
  height: calc(34rpx + env(safe-area-inset-bottom));
}

.pressable{
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 120ms;
}

.is-pressed{
  opacity: 0.82;
  transform: scale(0.98);
}

.dock-pressed{
  opacity: 0.88;
  transform: scale(0.985);
  box-shadow: 0 10rpx 24rpx rgba(17,20,24,0.22);
}
