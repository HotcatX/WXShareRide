.history-question-row,.history-answer-actions,.history-stars{display:flex;align-items:center;}
.history-question-row{justify-content:space-between;gap:16rpx;}
.history-question-copy{min-width:0;flex:1;}
.history-question{display:block;font-size:26rpx;font-weight:600;line-height:1.5;color:#354551;}
.history-answer-actions{gap:10rpx;flex-shrink:0;}
.history-answer{margin:0;padding:0;width:76rpx;min-width:76rpx;line-height:62rpx;border-radius:13rpx;background:#f0f3f5;color:#687784;font-size:26rpx;font-weight:600;}
.history-answer--yes{background:#e7f5f3;color:#087f79;}
.history-answer::after,.history-star::after{border:none;}
.history-answer--disabled{opacity:.55;}
.history-rating{display:flex;justify-content:space-between;align-items:center;gap:12rpx;min-height:62rpx;animation:history-reveal .32s ease-out;}
.history-rating-title{font-size:24rpx;color:#647481;line-height:1.5;}
.history-stars{flex-shrink:0;gap:2rpx;}
.history-star{margin:0;padding:0;width:46rpx;line-height:58rpx;background:transparent!important;color:#e0ae4b;font-size:42rpx;font-weight:400;}
.history-star--selected{color:#e0ae4b;}
.history-feedback-error{display:block;margin-top:10rpx;font-size:23rpx;line-height:1.5;color:#b45a36;}
.history-retry{margin:8rpx 0 0;padding:0;background:transparent;color:#087f79;line-height:48rpx;font-size:24rpx;text-align:left;}
.history-retry::after{border:none;}
@keyframes history-reveal{from{opacity:.65;}to{opacity:1;}}
