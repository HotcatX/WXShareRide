page{
  background: #f4f6f8;
}

.history-ride{
  background: #f4f6f8;
}

.history-scroll{
  padding-top: 14rpx;
}

.history-card{
  margin-bottom: 14rpx;
  padding: 24rpx;
}
.history-card-head,.history-card-caption{display:flex;align-items:center;}
.history-card-head{justify-content:space-between;gap:16rpx;}
.history-card-caption{gap:12rpx;min-width:0;flex-wrap:wrap;}
.history-kind,.history-time{font-size:23rpx;color:#7b8794;line-height:1.5;}
.history-role{flex-shrink:0;font-size:22rpx;line-height:34rpx;padding:2rpx 12rpx;border-radius:9rpx;font-weight:600;}
.history-role--driver{background:#e0f2f1;color:#087f7b;}
.history-role--passenger{background:#e9edff;color:#5465b6;}
.history-role--unknown{background:#edf0f3;color:#687484;}
.history-status{font-size:21rpx;line-height:30rpx;}
.history-status--pending{color:#b87815;}
.history-status--rating{color:#5270bb;}
.history-status--done{color:#16837a;}
.history-route{display:flex;align-items:center;gap:14rpx;margin:18rpx 0 5rpx;min-width:0;}
.history-route-name{min-width:0;flex:1;font-size:30rpx;font-weight:600;line-height:1.5;color:#25313d;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.history-route-arrow{flex-shrink:0;color:#0b9993;font-size:30rpx;}
.history-meta{display:flex;align-items:center;gap:18rpx;min-width:0;}
.history-time{flex-shrink:0;}
.history-meta .ride-publisher-name{flex:1;text-align:right;}
.history-feedback{border-top:1rpx solid #edf0f3;margin-top:18rpx;padding-top:17rpx;}
.history-thanks{position:fixed;left:50%;transform:translateX(-50%);z-index:100;pointer-events:none;padding:12rpx 28rpx;background:#edf7f3;border-radius:24rpx;color:#387763;font-size:24rpx;box-shadow:0 2rpx 10rpx rgba(15,70,55,.04);animation:history-thanks 1.4s ease-in-out both;}
@keyframes history-thanks{0%,100%{opacity:0;}15%,80%{opacity:1;}}
