<timeline-preview wx:if="{{isTimelinePreview}}" id="timeline-preview" context="{{timelineContext}}" />
<block wx:elif="{{timelinePageReady}}">
<view class="ride-shell profile-ride">
  <view class="ride-top profile-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar profile-topbar" style="padding-right: {{menuRightSpace}}px;">
      <view class="ride-brand profile-brand">
        <text class="ride-kicker">MY PROFILE</text>
        <text class="ride-title">{{pageTitle}}</text>
      </view>
    </view>
  </view>

  <scroll-view class="ride-scroll profile-scroll" scroll-y enhanced="true" show-scrollbar="{{false}}">
    <view class="profile-hero ride-card ride-card-pad">
      <image class="profile-avatar" src="{{avatarUrl}}" mode="aspectFill" bindtap="goEditProfile" />

      <view class="profile-identity">
        <block wx:if="{{isLoggedIn}}">
          <text class="profile-name" bindtap="goEditProfile">{{ name || '微信用户' }}</text>
          <text class="profile-subtitle">{{wechatID || '微信号未填写'}}</text>
        </block>
        <block wx:else>
          <text class="profile-name">未登录</text>
          <view class="profile-login ride-action ride-action--dark" bindtap="onTapLoginBtn" hover-class="ride-pressed" hover-stay-time="80">
            <text>一键登录</text>
          </view>
        </block>
      </view>

      <view class="profile-actions">
        <button
          class="profile-action profile-action-button"
          open-type="contact"
          session-from="profile_feedback"
          show-message-card="true"
          send-message-title="联系官方客服"
          send-message-path="/pages/profile/profile"
          hover-class="ride-pressed"
          hover-stay-time="80"
        >
          <image class="profile-action-icon" src="/images/icon_feedback.png" mode="aspectFit" />
          <text class="profile-action-text">客服</text>
        </button>

        <view class="profile-action" bindtap="goNotification" hover-class="ride-pressed" hover-stay-time="80">
          <view class="profile-action-icon-wrap">
              <image class="profile-action-icon" src="/images/icon_message.png" mode="aspectFit" />
              <view wx:if="{{unreadCount > 0}}" class="profile-action-badge">
                <text>{{ unreadCount > 99 ? '99+' : unreadCount }}</text>
              </view>
            </view>
            <text class="profile-action-text">消息</text>
          </view>

          <view class="profile-action" bindtap="goEditProfile" hover-class="ride-pressed" hover-stay-time="80">
            <image class="profile-action-icon" src="/images/icon_setting.png" mode="aspectFit" />
            <text class="profile-action-text">设置</text>
          </view>
        </view>
    </view>

    <view class="profile-info ride-card ride-card-pad">

      <view class="profile-info-row" bindtap="goEditProfile" hover-class="ride-pressed" hover-stay-time="80">
        <text class="profile-info-label">所住公寓</text>
        <text class="profile-info-value">{{ isLoggedIn ? (apartment || '未填写') : '未登录' }}</text>
      </view>
      <view class="profile-divider"></view>

      <view class="profile-info-row" bindtap="goEditProfile" hover-class="ride-pressed" hover-stay-time="80">
        <text class="profile-info-label">所住区域</text>
        <text class="profile-info-value">{{ isLoggedIn ? (region || '无') : '未登录' }}</text>
      </view>
    </view>

    <view class="profile-section ride-card ride-card-pad">
      <view class="profile-section-head">
        <text class="ride-section-title">我的二手/转租</text>
      </view>

      <view class="profile-grid">
        <view class="profile-grid-item" bindtap="goPublished" hover-class="ride-card-pressed" hover-stay-time="80">
          <view class="profile-grid-icon-wrap profile-badge-wrap">
            <image class="profile-grid-icon" src="/images/icon_publish.png" mode="aspectFit" />
            <view wx:if="{{walletUnreadCount > 0}}" class="profile-badge">
              <text class="profile-badge-number">{{ walletUnreadCount > 99 ? '99+' : walletUnreadCount }}</text>
            </view>
          </view>
          <text class="profile-grid-text">我发布的</text>
        </view>

        <view class="profile-grid-item" bindtap="goSold" hover-class="ride-card-pressed" hover-stay-time="80">
          <view class="profile-grid-icon-wrap">
            <image class="profile-grid-icon" src="/images/icon_sold.png" mode="aspectFit" />
          </view>
          <text class="profile-grid-text">我卖出的</text>
        </view>

        <view class="profile-grid-item" bindtap="goBought" hover-class="ride-card-pressed" hover-stay-time="80">
          <view class="profile-grid-icon-wrap">
            <image class="profile-grid-icon" src="/images/icon_bought.png" mode="aspectFit" />
          </view>
          <text class="profile-grid-text">我买到的</text>
        </view>
      </view>
    </view>

    <view class="profile-section ride-card ride-card-pad">
      <view class="profile-section-head">
        <text class="ride-section-title">我的出行</text>
      </view>

      <view class="profile-grid">
        <view class="profile-grid-item" bindtap="goTripHistory" hover-class="ride-card-pressed" hover-stay-time="80">
          <view class="profile-grid-icon-wrap">
            <image class="profile-grid-icon" src="/images/icon_history.png" mode="aspectFit" />
          </view>
          <text class="profile-grid-text">历史行程</text>
        </view>

        <view class="profile-grid-item" bindtap="goCarpoolTemplate" hover-class="ride-card-pressed" hover-stay-time="80">
          <view class="profile-grid-icon-wrap">
            <image class="profile-grid-icon" src="/images/icon_template.png" mode="aspectFit" />
          </view>
          <text class="profile-grid-text">出行模板</text>
        </view>

        <view class="profile-grid-item" bindtap="goBlockList" hover-class="ride-card-pressed" hover-stay-time="80">
          <view class="profile-grid-icon-wrap profile-badge-wrap">
            <image class="profile-grid-icon" src="/images/icon_block.png" mode="aspectFit" />
            <view wx:if="{{blockedCount > 0}}" class="profile-badge">
              <text class="profile-badge-number">{{ blockedCount > 99 ? '99+' : blockedCount }}</text>
            </view>
          </view>
          <text class="profile-grid-text">黑名单</text>
        </view>
      </view>
    </view>

    <view class="profile-score ride-card ride-card-pad">
      <view class="profile-section-head">
        <text class="ride-section-title">出行信用</text>
      </view>
      <view class="profile-score-grid">
        <view class="profile-score-item">
          <text class="profile-score-role">司机</text>
          <text class="profile-score-value">{{isLoggedIn ? driverRatingText : '未登录'}}</text>
          <text class="profile-score-sub">{{isLoggedIn ? driverCompletedText : '登录后查看'}}</text>
        </view>
        <view class="profile-score-item">
          <text class="profile-score-role">乘客</text>
          <text class="profile-score-value">{{isLoggedIn ? passengerRatingText : '未登录'}}</text>
          <text class="profile-score-sub">{{isLoggedIn ? passengerCompletedText : '登录后查看'}}</text>
        </view>
      </view>
    </view>

    <view class="profile-privacy" bindtap="goPrivacy" hover-class="ride-pressed" hover-stay-time="80">
      <text class="profile-privacy-text">隐私政策</text>
    </view>

    <view class="profile-bottom-space"></view>
  </scroll-view>

  <app-tabbar active="profile" market-badge="{{walletUnreadCount}}" profile-badge="{{unreadCount}}"></app-tabbar>
</view>
</block>
