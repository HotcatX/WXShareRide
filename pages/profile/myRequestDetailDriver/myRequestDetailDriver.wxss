page{
  background: #F6EFE8;
}

.ui-page{
  height: 100vh;
  overflow: hidden;
  background: #F6EFE8;
  display: flex;
  flex-direction: column;
}

.nav-bar{
  width: 100%;
  background-color: #ffffff;
}
.nav-content{
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
}
.back-icon{
  width: 50rpx;
  height: 50rpx;
}
.nav-title{
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}

.state-text{
  flex: 1;
  text-align: center;
  margin-top: 80rpx;
  font-size: 26rpx;
  color: rgba(0,0,0,0.45);
}
.state-card{
  margin: 80rpx 22rpx 0 22rpx;
  padding: 40rpx 28rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 14rpx 30rpx rgba(0,0,0,0.06);
  text-align: center;
}
.state-title{
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.5;
  color: rgba(0,0,0,0.68);
}
.state-action-btn{
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin-top: 28rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #9CB06A;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
}
.state-action-btn::after{ border: none; }

.ui-scroll{
  flex: 1;
  min-height: 0;
  padding: 22rpx 22rpx 0 22rpx;
  box-sizing: border-box;
}

.ui-card{
  background: #fff;
  border-radius: 26rpx;
  padding: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 14rpx 30rpx rgba(0,0,0,0.06);
  margin-top: 18rpx;
}

.ui-notice{
  border: 2rpx solid rgba(238,156,115,0.28);
  background: rgba(238,156,115,0.10);
  box-shadow: none;
}
.notice-title{
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.70);
  margin-bottom: 8rpx;
}
.notice-text{
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(0,0,0,0.55);
  line-height: 1.6;
}

.ui-bottom-space{
  height: calc(140rpx + env(safe-area-inset-bottom));
}

.ui-bottom-fixed{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}
.ui-bottom-bar{
  background: #fff;
  height: 160rpx;
  box-sizing: border-box;
  border-top: 2rpx solid rgba(0,0,0,0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ui-bottom-bar--one{
  padding: 0 22rpx;
}

.ui-secondary-btn,
.ui-danger-btn{
  width: 93%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.ui-secondary-btn{
  background: #9CB06A;
  color: #fff;
  border: none;
  box-shadow: 0 10rpx 22rpx rgba(0,0,0,0.06);
}

.ui-danger-btn{
  background: #FE814B;
  color: #fff;
  border: none;
  box-shadow: 0 10rpx 22rpx rgba(0,0,0,0.10);
}

.ui-secondary-btn::after,
.ui-danger-btn::after{
  border: none;
}

.route-row{
  display: flex;
  align-items: center;
}
.route-text-left,
.route-text-right{
  flex: 1;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 40rpx;
  color: rgba(0,0,0,0.78);
}
.route-text-left{ text-align: left; }
.route-text-right{ text-align: right; }

.route-arrow{
  width: 80rpx;
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
  line-height: 40rpx;
  color: rgba(0,0,0,0.45);
}

.time-seat-row{
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}
.time-text,
.seat-text{
  font-size: 30rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.60);
}

.card-title{
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.75);
  margin-bottom: 16rpx;
  line-height: 1.2;
}


.info-row{
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}
.label{
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.45);
  margin-right: 16rpx;
}
.value{
  flex: 1;
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.70);
}

.empty-tip{
  font-size: 26rpx;
  color: rgba(0,0,0,0.45);
  padding: 6rpx 0 10rpx;
}

.passenger-item{
    display: flex;
    align-items: flex-start;
    padding: 16rpx 0;
    border-top: 2rpx solid rgba(0,0,0,0.06);
    gap: 18rpx;
  }
  .passenger-item:first-child{ border-top: none; }

  .passenger-left{
    width: 128rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }

  .passenger-avatar{
    width: 92rpx;
    height: 92rpx;
    border-radius: 50%;
  }

  .passenger-name{
    margin-top: 10rpx;
    font-size: 24rpx;
    font-weight: 900;
    color: rgba(0,0,0,0.78);
    text-align: center;

    width: 128rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .passenger-right{
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12rpx;              }

  .pgrid{
    --label-w: 96rpx;       --btn-w: 102rpx;        --btn-h: 36rpx;         display: grid;
    grid-template-columns: var(--label-w) 1fr var(--btn-w);
    column-gap: 6rpx;       align-items: center;
    min-width: 0;
    min-height: 36rpx;
  }

  .pgrid--addr{
    align-items: start;
  }

  .pgrid-label{
    font-size: 24rpx;
    font-weight: 800;
    color: rgba(0,0,0,0.45);
    line-height: 34rpx;
    text-align: right;      }

  .pgrid-value{
    min-width: 0;
    font-size: 24rpx;
    font-weight: 800;
    color: rgba(0,0,0,0.70);
    line-height: 34rpx;

    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pgrid-value--addr{
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pgrid-btn-placeholder{
    height: var(--btn-h);
  }

.copy-pill{
  width: var(--btn-w);
  height: var(--btn-h);
  border-radius: 999rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 20rpx;      font-weight: 900;      line-height: 1;        color: #fff;           background: #9CB06A;   justify-self: end;     align-self: center;    }


.copy-btn::after{
  border: none;
}

.copy-btn[disabled]{
  opacity: 0.55;
}
