page {
    background: #F6F1ED;
  }

  .container {
    min-height: 100vh;
    background: #F6F1ED;
  }

  .nav-bar {
    width: 100%;
    background-color: #ffffff;
  }

  .nav-content {
    height: 44px;
    display: flex;
    align-items: center;
    padding: 0 20rpx;
    position: relative;
  }

  .back-icon {
    width: 50rpx;
    height: 50rpx;
  }

  .nav-title {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    font-size: 34rpx;
    font-weight: 600;
    color: #111;
  }

  .header {
    display: flex;
    align-items: center;
    height: 80rpx;
    padding: 0 20rpx;
  }
  .title {
    flex: 1;
    text-align: center;
    font-size: 40rpx;
    font-weight: bold;
  }

  .filter-bar {
    display: flex;
    align-items: center;
    padding: 16rpx 24rpx;
    background-color: #ffffff;
    border-bottom: 1px solid #f5f5f5;
    font-size: 24rpx;
  }

  .filter-bar picker {
    flex: 1;
  }

  .filter-item {
    flex: 1;
  }

  .filter-spacer {
    width: 24rpx;
  }

  .filter-pill {
    padding: 8rpx 16rpx;
    border-radius: 999rpx;
    background-color: #f5f5f5;
    text-align: center;
  }

  .filter-reset {
    margin-left: 16rpx;
    font-size: 26rpx;
    font-weight: 800;
    color: #ff0000;
    text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.25);
  }

  .state-text {
    padding: 40rpx 24rpx;
    color: #666;
    font-size: 28rpx;
    text-align: center;
  }

  .date-header {
    padding: 24rpx 24rpx 8rpx;
  }

  .date-header-text {
    font-size: 28rpx;
    font-weight: 600;
    color: #333;
  }

  .trip-card {
    background: #ffffff;
    border-radius: 16rpx;
    box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
    padding: 20rpx 24rpx;
    margin: 8rpx 20rpx 20rpx;
  }

  .trip-main-row {
    display: flex;
    align-items: center;
  }

  .place-text-left,
  .place-text-right {
    flex: 1;
    font-size: 30rpx;
    font-weight: 500;
    color: #111;
  }

  .place-text-left {
    text-align: left;
  }

  .place-text-right {
    text-align: right;
  }

  .arrow-text {
    width: 80rpx;
    text-align: center;
    font-size: 32rpx;
    margin: 0;
  }

  .trip-sub-row {
    margin-top: 12rpx;
    display: flex;
    justify-content: space-between;
    font-size: 26rpx;
    color: #666;
  }

  .trip-sub-row2 {
    margin-top: 8rpx;
    display: flex;
    justify-content: space-between;
    font-size: 26rpx;
    color: #666;
  }

  .seat-text {
    color: #ff8c00;
  }

  .price-text {
    color: #333;
  }

  .status-text {
    color: #999;
  }

  .trip-card--tag {
    position: relative;  overflow: hidden;    }

  .left-tag {
    position: absolute;
    left: 0;
    top: 18rpx;
    bottom: 18rpx;
    width: 10rpx;
    border-radius: 999rpx;
  }

  .left-tag--orange {
    background: #FE814B;
  }

  .left-tag--blue {
    background: #2F80ED;
  }

  .toast-bar {
    position: fixed;
    top: 120rpx;
    left: 50%;
    transform: translateX(-50%);
    max-width: 80%;
    padding: 16rpx 24rpx;
    border-radius: 999rpx;
    background: rgba(0, 0, 0, 0.85);
    color: #fff;
    display: flex;
    align-items: center;
    z-index: 999;
    font-size: 26rpx;
    line-height: 1.4;
    box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  }

  .toast-icon {
    margin-right: 12rpx;
    font-size: 30rpx;
  }

  .toast-text {
    flex: 1;
    word-break: break-all;
  }