.page{
  height: 100vh;
  overflow: hidden;
  background: #F6EFE8; /* 米色背景 */
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 顶部导航栏 */
.nav-bar{
  width: 100%;
  background-color: #EE9C73; /* 橙色 */
}

.nav-content{
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 22rpx;
  position: relative;
  box-sizing: border-box;
}

.back-icon{
  width: 50rpx;
  height: 50rpx;
}

.nav-title{
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 900;
  color: #111;
}

/* 内容滚动 */
.content-scroll{
  flex: 1;
  min-height: 0;
  box-sizing: border-box;
}

/* 卡片容器 */
.card{
  background: #fff;
  border-radius: 26rpx;
  padding: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 14rpx 30rpx rgba(0,0,0,0.06);
  margin-top: 18rpx;
}

.inline-loading{
  margin: 18rpx 22rpx 0;
  padding: 18rpx 22rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.78);
  color: rgba(0,0,0,0.54);
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

/* 顶部块 */
.top-block{
  padding-bottom: 10rpx;
}

.img-uploader{
  width: 220rpx;
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: #F2F2F2;
  border-radius: 18rpx;
  position: relative;
}

.img{
  width: 100%;
  height: 100%;
}

.img-placeholder{
  text-align: center;
  color: rgba(0,0,0,0.28);
  font-weight: 800;
}

.image-upload-mask{
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2;
  background: rgba(0,0,0,0.42);
  backdrop-filter: blur(6px);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.upload-progress-ring{
  width: 108rpx;
  height: 108rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 24rpx rgba(0,0,0,0.22);
}

.upload-progress-core{
  width: 78rpx;
  height: 78rpx;
  border-radius: 999rpx;
  background: rgba(19,22,26,0.78);
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-progress-text{
  color: rgba(255,255,255,0.92);
  font-size: 22rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.ph1{ font-size: 26rpx; display: block; }
.ph2{ font-size: 24rpx; display: block; margin-top: 6rpx; }

.title-input{
  margin-top: 18rpx;
  height: 70rpx;
  border-bottom: 2rpx solid rgba(0,0,0,0.10);
  font-size: 30rpx;
  font-weight: 900;
  color: #111;
}

.title-ph{ color: rgba(0,0,0,0.30); font-weight: 700; }

.desc{
  margin-top: 14rpx;
  min-height: 100rpx;
  font-size: 28rpx;
  color: rgba(0,0,0,0.75);
}

.desc-ph{ color: rgba(0,0,0,0.30); }

/* 常用描述语 */
.quick-wrap{
  margin-top: 10rpx;
}

.quick-title{
  color: #E54B3B; /* 红色标题 */
  font-size: 28rpx;
  font-weight: 900;
  margin: 6rpx 0 10rpx 0;
}

.chips{
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip{
  border: 2rpx solid rgba(0,0,0,0.12);
  border-radius: 999rpx;
  padding: 10rpx 16rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(0,0,0,0.70);
  background: #fff;
}

/* 表单行 */
.form{
  margin-top: 0;
}

/* 1) 先去掉全局 row 的线 */
.row{
  border-bottom: none;
}

/* 2) 只给表单区域的 row 加线（你这个发布页就是 .form） */
.form .row{
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2rpx solid rgba(0,0,0,0.08);
}
.form .row.no-border{
  border-bottom: none;
}

.row.no-border{
  border-bottom: none;
}

.label{
  font-size: 32rpx;
  font-weight: 900;
  color: #111;
}

.right{
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.value{
  font-size: 30rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.45);
}

.arrow{
  font-size: 44rpx;
  color: rgba(0,0,0,0.30);
  line-height: 1;
}

/* 价格行 */
.price-row .value{ display: none; }

.yuan{
  font-size: 34rpx;
  font-weight: 900;
  color: #EE9C73;
}

.price-input{
  width: 180rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #EE9C73;
  text-align: right;
}

.price-ph{ color: rgba(217,100,74,0.60); }

.location-block{
  padding: 22rpx 0 6rpx;
}

.location-title-row{
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.location-saved{
  font-size: 22rpx;
  font-weight: 800;
  color: #179E16;
}

.location-mode-row{
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin-top: 18rpx;
}

.location-mode-btn{
  height: 72rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(0,0,0,0.10);
  background: #fff;
  color: rgba(0,0,0,0.62);
  font-size: 26rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
}

.location-mode-btn.active{
  border-color: #EE9C73;
  background: rgba(238,156,115,0.14);
  color: #C95D36;
}

.location-current-card{
  margin-top: 18rpx;
  min-height: 112rpx;
  border-radius: 20rpx;
  background: #fff7f2;
  border: 2rpx solid rgba(238,156,115,0.22);
  padding: 18rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.location-current-label{
  font-size: 28rpx;
  font-weight: 900;
  color: #111;
  line-height: 36rpx;
}

.location-current-sub{
  font-size: 22rpx;
  color: rgba(0,0,0,0.46);
  line-height: 30rpx;
}

.location-picker-wrap{
  margin-top: 18rpx;
  border-radius: 20rpx;
  background: #F7F7F7;
  box-sizing: border-box;
}

.location-picker-row{
  height: 84rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.location-picker-value{
  min-width: 0;
  flex: 1;
  font-size: 28rpx;
  font-weight: 800;
  color: #111;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.location-picker-value.is-placeholder{
  color: rgba(0,0,0,0.30);
  font-weight: 700;
}

.location-actions{
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 22rpx;
}

.location-save,
.location-clear{
  padding: 8rpx 0;
  font-size: 24rpx;
  font-weight: 900;
  color: #EE9C73;
}

.location-hint{
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: rgba(0,0,0,0.42);
}

/* 给底部按钮留空间 */

/* 给底部固定发布按钮留空 */
.bottom-space{
  height: calc(140rpx + env(safe-area-inset-bottom));
}

/* ✅ 底部白色底框 高度对齐导航栏风格 */
.bottom-fixed{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

/* 这个就是你说的框 */
.bottom-bar{
  background: #fff;
  height: 160rpx; /* 框高度 固定 */
  /* padding: 16rpx 22rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); 兼容安全区 */
  box-sizing: border-box;
  border-top: 2rpx solid rgba(0,0,0,0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ✅ 发布按钮阴影 */
.submit{
  width: 93%;
  height: 96rpx;
  border-radius: 999rpx;
  background: #EE9C73;
  color: #fff;
  font-size: 36rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 3rpx 6rpx 2rpx 0 rgba(0,0,0,0.25);
}


/* 内容容器 */
.content{
  padding: 22rpx 24rpx 0;
  box-sizing: border-box;
}

/* 底部占位（你已有就保留，没有就加上） */
.bottom-space{
  height: calc(160rpx + env(safe-area-inset-bottom));
}

/* 发布按钮 hover（可选） */
.submit--hover{
  opacity: .92;
}

/* 发布中：变灰 + 禁止点击 */
.submit--disabled{
  opacity: .55;
  filter: grayscale(20%);
  pointer-events: none;   /* 核心：不可点击 */
}

/* ====== 多图上传（九宫格） ====== */
.img-uploader-multi{ width: 320rpx; }
.img-grid{
  position: relative;
  width: 320rpx;
  min-height: 320rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #f6f6f6;
  display: flex;
  flex-wrap: wrap;
  align-content: flex-start;
}
.img-item{
  width: 106.66rpx;
  height: 106.66rpx;
  flex: 0 0 106.66rpx;
}
.img-count{
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  background: rgba(0,0,0,0.55);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
}
.img-tip{
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #999;
}

/* 隐藏 canvas（生成缩略图用） */
.thumb-canvas{
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 300px;
  height: 300px;
}
