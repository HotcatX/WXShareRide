page{
  background: #f4f6f8;
}

.detail-ride{
  background: #f4f6f8;
}

.detail-scroll{
  padding-top: 14rpx;
}

.detail-hero-head{
  margin-bottom: 18rpx;
}

.detail-section-head{
  margin-bottom: 12rpx;
}

.detail-paragraph{
  margin-top: 14rpx;
  display: block;
  color: #59636f;
  font-size: 26rpx;
  line-height: 38rpx;
  font-weight: 800;
}

.detail-toast{
  margin-bottom: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #ffffff;
  border: 1rpx solid rgba(20,23,26,0.06);
  box-shadow: 0 8rpx 24rpx rgba(20,23,26,0.06);
}

.detail-toast.success{
  background: rgba(15,155,149,0.10);
}

.detail-toast.error,
.detail-toast.warn{
  background: rgba(230,76,60,0.10);
}

.detail-toast-icon{
  font-size: 26rpx;
  font-weight: 900;
}

.detail-toast-text{
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 800;
  color: #59636f;
}

.detail-driver{
  margin-top: 18rpx;
}

.detail-tags{
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 4rpx 0 8rpx;
}

.create-card-head{
  margin-bottom: 16rpx;
}

.create-card-head .ride-section-subtitle{
  display: block;
  margin-top: 2rpx;
}
