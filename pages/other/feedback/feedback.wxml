<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content">
    <image class="back-icon" src="/images/back.png" bindtap="goBack" />
    <text class="nav-title">{{pageTitle}}</text>
  </view>
</view>

<view wx:if="{{toastVisible}}" class="toast-bar {{toastType}}">
  <text class="toast-icon">{{toastIcon}}</text>
  <text class="toast-text">{{toastText}}</text>
</view>

<view class="container">

  <view class="form-area">
    <view class="form-item">
      <text class="label">邮箱：</text>
      <input class="input-box"
             type="text"
             value="{{email}}"
             bindinput="onEmailInput"
             placeholder="请输入邮箱地址"
             placeholder-class="placeholder" />
    </view>

    <view class="form-item">
      <text class="label">手机号：</text>
      <view class="phone-row">
        <picker mode="selector"
                range="{{regionOptions}}"
                bindchange="onRegionChange">
          <view class="picker-box">{{ regionLabel }}</view>
        </picker>

        <input class="input-box flex-1"
               type="number"
               value="{{phone}}"
               bindinput="onPhoneInput"
               placeholder="请输入手机号"
               placeholder-class="placeholder" />
      </view>
    </view>

    <view class="form-item">
      <text class="label">反馈内容：</text>
      <textarea class="textarea-box"
                value="{{content}}"
                bindinput="onContentInput"
                placeholder="请输入您的意见或建议"
                placeholder-class="placeholder" />
    </view>

    <view class="btn-group">
      <button class="save-btn" bindtap="submitFeedback">提交反馈</button>
    </view>
  </view>
</view>
