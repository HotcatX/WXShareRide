page{
  background: #f4f6f8;
}

.home-ride{
  background: #f4f6f8;
}

.home-login-done{
  color: #69727d;
}

.home-city-entry{
  position: absolute;
  left: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 220rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #111418;
  box-sizing: border-box;
}

.home-city-text{
  max-width: 178rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 31rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.home-city-caret{
  color: #59636f;
  font-size: 28rpx;
  line-height: 30rpx;
  font-weight: 900;
}

.home-ride .ride-topbar{
  position: relative;
  justify-content: center;
}

.home-ride .ride-brand{
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 240rpx;
  flex: none;
  align-items: center;
  text-align: center;
}

.home-ride .ride-title{
  font-size: 40rpx;
  line-height: 48rpx;
}

.home-scroll{
  padding-top: 60rpx;
}

.home-service-grid{
  display: flex;
  gap: 18rpx;
  margin-bottom: 72rpx;
  align-items: stretch;
}

.home-service-grid .home-service{
  flex: 1;
  width: 0;
  height: 250rpx;
  min-height: 250rpx;
  max-height: 250rpx;
  margin: 0 !important;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
  display: grid;
  grid-template-rows: 126rpx 42rpx 30rpx;
  justify-items: center;
  align-items: center;
  text-align: center;
}

.home-service-icon-slot{
  width: 100%;
  height: 126rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-service-title-slot,
.home-service-desc-slot{
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-service-icon{
  width: 92rpx;
  height: 92rpx;
  border-radius: 24rpx;
  font-size: 54rpx;
  line-height: 92rpx;
}

.home-service-icon-img{
  width: 92rpx;
  height: 92rpx;
  display: block;
}

.home-service-title{
  margin: 0;
  font-size: 36rpx;
  line-height: 40rpx;

  font-weight: 700;
  color: #111418;

  letter-spacing: 2rpx;
}

.home-service-desc{
  margin: 0;
  font-size: 22rpx;
  line-height: 28rpx;
}

.home-section{
  margin-top: 50rpx;
}

.home-section-head{
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.home-section-head .ride-section-subtitle{
  display: block;
  margin-top: 2rpx;
}

.home-trip-list{
  min-height: 0;
}

.home-trip-list .ride-card + .ride-card{
  margin-top: 0;
}

.home-trip-card{
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx;
}

.home-trip-card .ride-list-head{
  margin-bottom: 10rpx;
  align-items: center;
}

.home-kind-row{
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.home-trip-card .ride-list-kind{
  display: flex;
  align-items: center;
  font-size: 23rpx;
  line-height: 30rpx;
}

.home-kind-row .ride-chip{
  height: 36rpx;
  padding: 0 11rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
  line-height: 34rpx;
  display: flex;
  align-items: center;
}

.home-trip-card .ride-list-time{
  font-size: 23rpx;
  line-height: 30rpx;
  color: #69727d;
}

.home-route-inline{
  min-width: 0;
  position: relative;
}

.home-route-main{
  min-width: 0;
  width: 100%;
  display: grid;
  grid-template-columns: minmax(0,0.92fr) 96rpx minmax(0,1.08fr);
  align-items: center;
  column-gap: 10rpx;
}

.home-route-place{
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  box-sizing: border-box;
}

.home-route-main .home-route-place:first-child{
  justify-content: flex-start;
}

.home-route-main .home-route-place:last-child{
  justify-content: flex-start;
  padding-right: 108rpx;
}

.home-trip-card .ride-route-label{
  flex: none;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 900;
  color: #59636f;
}

.home-trip-card .ride-route-name{
  min-width: 0;
  margin-top: 0;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
  color: #111418;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-route-arrow{
  width: 92rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: rgba(15,155,149,0.08);
  color: #0f746f;
  border: 1rpx solid rgba(15,155,149,0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  justify-self: center;
  align-self: center;
  font-size: 31rpx;
  line-height: 34rpx;
  font-weight: 900;
  text-align: center;
  box-sizing: border-box;
}

.home-seat-chip{
  flex: none;
  height: 36rpx;
  padding: 0 11rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
  line-height: 34rpx;
}

.home-route-side{
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 6rpx;
  max-width: 100rpx;
}

.home-price-chip{
  max-width: 92rpx;
  height: 36rpx;
  padding: 0 11rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
  line-height: 34rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-inline-state{
  margin: 0;
  padding: 42rpx 24rpx;
}

.home-stats{
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  gap: 18rpx;
}

.home-stat-main{
  flex: 1;
  min-width: 0;
}

.home-stat-label{
  font-size: 22rpx;
  line-height: 30rpx;
  color: #69727d;
  font-weight: 900;
}

.home-stat-number-row{
  margin-top: 8rpx;
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
}

.home-stat-number{
  font-size: 58rpx;
  line-height: 60rpx;
  font-weight: 900;
  color: #111418;
}

.home-stat-unit{
  margin-bottom: 6rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 900;
  color: #69727d;
}

.home-stat-subtitle{
  margin-top: 8rpx;
  display: block;
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 800;
  color: #69727d;
}

.home-stat-side{
  width: 220rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
}

.home-refresh-tip{
  margin-top: 26rpx;
  display: block;
  text-align: center;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 800;
  color: #9aa3ad;
}

.ride-unavailable-card{
  margin-top: 28rpx;
  padding: 44rpx 36rpx 42rpx;
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  text-align: left;
  box-sizing: border-box;
}

.ride-unavailable-title{
  display: block;
  color: #111418;
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 900;
}

.ride-unavailable-desc{
  margin-top: 18rpx;
  display: block;
  color: #69727d;
  font-size: 27rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.ride-unavailable-button{
  margin-top: 34rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #0f9b95;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 34rpx rgba(15,155,149,0.18);
}

.ride-unavailable-button.is-done{
  background: #eef2f5;
  color: #59636f;
  box-shadow: none;
}

/* 价格：黑底白字 */
.home-price-chip{
  max-width: 120rpx;
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  font-size: 21rpx;
  line-height: 36rpx;
  font-weight: 900;
  color: #ffffff;
  background: #111418;
  border: 1rpx solid #111418;
}

/* 展开/收起按钮基础样式 */
.home-toggle-chip{
  height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 38rpx;
  font-weight: 900;
}

/* 展开：黑底白字 */
.home-toggle-chip--open{
  background: #111418;
  color: #ffffff;
  border: 1rpx solid #111418;
}

/* 收起：白底黑字 */
.home-toggle-chip--close{
  background: #ffffff;
  color: #111418;
  border: 1rpx solid rgba(17,20,24,0.16);
}

/* 发起路线 */
.home-service-icon-post{
  width: 92rpx;
  height: 92rpx;
}

/* 加入拼车（放大一点） */
.home-service-icon-share{
  width: 110rpx;
  height: 110rpx;
}

.city-mask{
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(17,20,24,0.38);
}

.city-panel{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10001;
  height: min(76vh, 980rpx);
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  border-top-left-radius: 22rpx;
  border-top-right-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 -18rpx 40rpx rgba(17,20,24,0.14);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.city-header{
  height: 92rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid rgba(20,23,26,0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.city-title{
  color: #111418;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.city-close{
  min-width: 96rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #69727d;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.city-search-wrap{
  padding: 16rpx 24rpx 18rpx;
  border-bottom: 1rpx solid rgba(20,23,26,0.08);
  box-sizing: border-box;
}

.city-search-input{
  width: 100%;
  height: 70rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f4f6f8;
  color: #111418;
  font-size: 26rpx;
  line-height: 70rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.city-search-placeholder{
  color: #9aa4af;
  font-weight: 700;
}

.city-body{
  min-height: 0;
  flex: 1;
  display: grid;
  grid-template-columns: 168rpx minmax(0, 1fr);
}

.city-country-tabs{
  height: 100%;
  min-height: 0;
  padding: 18rpx 0;
  background: #f4f6f8;
  overflow: hidden;
  box-sizing: border-box;
}

.city-country{
  height: 82rpx;
  padding-left: 24rpx;
  border-left: 8rpx solid transparent;
  color: #59636f;
  display: flex;
  align-items: center;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.city-country.active{
  color: #0f9b95;
  border-left-color: #0f9b95;
  background: #ffffff;
  font-weight: 900;
}

.city-group-scroll{
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.city-group{
  padding: 26rpx 28rpx 4rpx;
}

.city-group-title{
  margin-bottom: 18rpx;
  color: #111418;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.city-hot-badge{
  padding: 0 7rpx;
  border-radius: 8rpx;
  background: #ff6b4a;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 28rpx;
  font-weight: 900;
  font-style: italic;
}

.city-grid{
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.city-option{
  height: 68rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  color: #3f4751;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.city-option.active{
  background: #0f9b95;
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15,155,149,0.18);
}

.city-empty{
  padding: 72rpx 28rpx 24rpx;
  color: #8b95a1;
  text-align: center;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.city-picker-hint{
  margin: 18rpx 28rpx 28rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f4f8f7;
  color: #66717d;
  font-size: 23rpx;
  line-height: 34rpx;
  font-weight: 700;
}
