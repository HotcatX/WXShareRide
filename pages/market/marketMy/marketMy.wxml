<view class="market-my-page">
  <view class="my-top ride-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar ride-topbar--center">
      <view class="ride-back ride-back-text" bindtap="onBack" hover-class="ride-pressed" hover-stay-time="80">
        <text>‹</text>
      </view>
      <text class="ride-nav-title">{{navTitle}}</text>
    </view>
  </view>

  <scroll-view class="my-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="profile-card">
      <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view class="profile-info">
        <text class="profile-name">{{nameDisplay}}</text>
        <view class="profile-meta">
          <text>{{wechatStatusText}}</text>
          <text>{{regionDisplay}}</text>
        </view>
        <text class="profile-apartment">{{apartmentDisplay}}</text>
      </view>
    </view>

    <view class="bio-card">
      <view class="section-head">
        <text class="section-title">个人介绍</text>
        <text class="save-state">{{saveStateText}}</text>
      </view>
      <textarea
        class="bio-textarea"
        value="{{bio}}"
        placeholder="写一句给买家的介绍"
        placeholder-class="input-placeholder"
        auto-height
        maxlength="120"
        bindinput="onBioInput"
        bindblur="onBioBlur"
      />
    </view>

    <view class="goods-head">
      <view>
        <text class="section-kicker">Listings</text>
        <text class="goods-title-main">{{goodsTitleMain}}</text>
      </view>
      <view class="add-small pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onAddGood">发布</view>
    </view>

    <view class="listing-segment">
      <view
        class="listing-segment-item {{item.selectedClass}} pressable"
        wx:for="{{listingTypeTabs}}"
        wx:key="type"
        data-type="{{item.type}}"
        hover-class="is-pressed"
        hover-stay-time="80"
        bindtap="onSelectListingType"
      >
        {{item.label}}
      </view>
    </view>

    <view wx:if="{{goodsEmpty}}" class="empty-state">
      <view class="empty-mark">＋</view>
      <view class="empty-title">{{goodsEmptyTitle}}</view>
      <view class="empty-subtitle">{{goodsEmptySubtitle}}</view>
      <view class="empty-action pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onAddGood">去发布</view>
    </view>

    <view class="goods-grid" wx:if="{{hasGoods}}">
      <view
        class="goods-card pressable"
        wx:for="{{goods}}"
        wx:key="id"
        hover-class="card-pressed"
        hover-stay-time="80"
        bindtap="onOpenGood"
        data-id="{{item.id}}"
      >
        <view class="photo-wrap">
          <image
            wx:if="{{item.hasImage}}"
            class="thumb"
            src="{{item.imageSrc}}"
            mode="aspectFill"
            lazy-load="true"
          />
          <view wx:else class="thumb text-thumb">
            <text>{{item.title}}</text>
          </view>

          <view
            wx:if="{{manageMode}}"
            class="select-box {{item.selectedClass}}"
            catchtap="onToggleSelect"
            data-id="{{item.id}}"
          >
            <text wx:if="{{item.selected}}" class="check">✓</text>
          </view>
        </view>

        <view class="goods-body">
          <text class="goods-title">{{item.title}}</text>
          <text class="goods-meta">{{item.metaText}}</text>
          <text class="goods-price">$ {{item.priceDisplay}}</text>
        </view>
      </view>
    </view>

    <view class="manage-dock {{dockVisibleClass}}">
      <view wx:if="{{manageMode}}" class="manage-actions">
        <view class="dock-btn secondary pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onToggleManage">退出</view>
        <view class="dock-btn secondary pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onToggleSelectAll">
          {{allSelectedText}}
        </view>
        <view
          class="dock-btn danger {{deleteDisabledClass}} pressable"
          hover-class="is-pressed"
          hover-stay-time="80"
          bindtap="onDeleteSelected"
        >
          删除 {{selectedCount}}
        </view>
      </view>

      <view wx:else class="dock-btn primary pressable" hover-class="dock-pressed" hover-stay-time="80" bindtap="onToggleManage">
        {{manageButtonText}}
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>
</view>
