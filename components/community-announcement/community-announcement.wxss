:host {
  position: relative;
  z-index: 20000;
}

.announcement-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx 32rpx;
  padding-top: calc(28rpx + env(safe-area-inset-top));
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  overscroll-behavior: contain;
}

.announcement-mask {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(17, 20, 24, 0.52);
}

.announcement-card {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  max-height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border: 1rpx solid rgba(20, 23, 26, 0.08);
  border-radius: 32rpx;
  background: #fff;
  box-shadow: 0 24rpx 80rpx rgba(17, 20, 24, 0.18);
  box-sizing: border-box;
}

.announcement-header {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx 12rpx 32rpx;
}

.announcement-label {
  display: flex;
  align-items: center;
  color: #69727d;
  font-size: 24rpx;
  font-weight: 600;
}

.announcement-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 12rpx;
  border-radius: 50%;
  background: #14b8a6;
}

.announcement-close {
  width: 64rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 50%;
  background: #f4f6f8;
  color: #69727d;
  font-size: 42rpx;
  font-weight: 400;
  line-height: 60rpx;
}

.announcement-close::after,
.announcement-confirm::after {
  border: 0;
}

.announcement-scroll {
  width: 100%;
  height: 52vh;
  max-height: 800rpx;
  min-height: 0;
  flex-shrink: 1;
  box-sizing: border-box;
}

.announcement-content {
  padding: 8rpx 32rpx 12rpx;
  box-sizing: border-box;
}

.announcement-title {
  display: block;
  color: #111418;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.45;
  white-space: pre-wrap;
  word-break: break-word;
}

.announcement-body {
  display: block;
  margin-top: 24rpx;
  color: #46505b;
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.announcement-image-area {
  margin-top: 28rpx;
}

.announcement-image {
  display: block;
  width: 100%;
  background: #fff;
}

.announcement-image-hint {
  display: block;
  margin-top: 14rpx;
  color: #87909b;
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.announcement-image-error {
  padding: 32rpx 24rpx;
  border-radius: 20rpx;
  background: #f4f6f8;
  color: #69727d;
  font-size: 26rpx;
  line-height: 1.7;
  text-align: center;
}

.announcement-footer {
  flex-shrink: 0;
  padding: 24rpx 32rpx 28rpx;
  border-top: 1rpx solid rgba(20, 23, 26, 0.06);
  background: #fff;
}

.announcement-confirm {
  width: 100%;
  margin: 0;
  padding: 0 24rpx;
  border: 0;
  border-radius: 22rpx;
  background: #111418;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 84rpx;
}

.announcement-pressed {
  opacity: 0.72;
}
