/* pages/profile/myTripDetailPassenger/myTripDetailPassenger.wxss */

page{
  background: #F6EFE8;
}

.ui-page{
  height: 100vh;
  overflow: hidden;
  background: #F6EFE8;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏（保持你原来） */
.nav-bar{
  width: 100%;
  background-color: #ffffff;
}
.nav-content{
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
  box-sizing: border-box;
}
.back-icon{
  width: 50rpx;
  height: 50rpx;
}
.nav-title{
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}

/* 加载态 */
.state-text{
  flex: 1;
  text-align: center;
  margin-top: 80rpx;
  font-size: 26rpx;
  color: rgba(0,0,0,0.45);
}
.state-card{
  margin: 80rpx 22rpx 0 22rpx;
  padding: 40rpx 28rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 26rpx;
  box-shadow: 0 14rpx 30rpx rgba(0,0,0,0.06);
  text-align: center;
}
.state-title{
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.5;
  color: rgba(0,0,0,0.68);
}
.state-action-btn{
  width: 240rpx;
  height: 72rpx;
  line-height: 72rpx;
  margin-top: 28rpx;
  padding: 0;
  border-radius: 999rpx;
  background: #9CB06A;
  color: #fff;
  font-size: 28rpx;
  font-weight: 900;
}
.state-action-btn::after{ border: none; }

/* 内容滚动区 */
.ui-scroll{
  flex: 1;
  min-height: 0;
  padding: 22rpx 22rpx 0 22rpx;
  box-sizing: border-box;
}

/* 同款白色卡片 */
.ui-card{
  background: #fff;
  border-radius: 26rpx;
  padding: 22rpx;
  box-sizing: border-box;
  box-shadow: 0 14rpx 30rpx rgba(0,0,0,0.06);
  margin-top: 18rpx;
}

/* 左侧强调条（司机信息：绿色） */
.ui-card-left-green{
  border-left: 6rpx solid #9CB06A;
}

/* 乘客卡做个轻强调（可选） */
.ui-card-accent{
  border: 2rpx solid rgba(238,156,115,0.18);
}

/* 提示卡 */
.ui-notice{
  border: 2rpx solid rgba(238,156,115,0.28);
  background: rgba(238,156,115,0.10);
  box-shadow: none;
}
.notice-title{
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.70);
  margin-bottom: 8rpx;
}
.notice-text{
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(0,0,0,0.55);
  line-height: 1.6;
}

/* 底部留空 */
.ui-bottom-space{
  height: calc(140rpx + env(safe-area-inset-bottom));
}

/* 底部固定白框（同二手交易） */
.ui-bottom-fixed{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}
.ui-bottom-bar{
  background: #fff;
  height: 160rpx;
  box-sizing: border-box;
  border-top: 2rpx solid rgba(0,0,0,0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 主按钮（同款） */
.ui-submit-btn{
  width: 93%;
  height: 96rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 36rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 3rpx 6rpx 2rpx 0 rgba(0,0,0,0.25);
}
.ui-submit-btn::after{ border: none; }

/* 橙色主按钮 */
.ui-primary-btn{
  background: #EE9C73;
}

/* 军绿色按钮（备用） */
.ui-secondary-btn{
  background: #9CB06A;
}

/* ===== 卡片内布局（统一） ===== */
.card-title{
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.75);
  margin-bottom: 16rpx;
}

/* 路线行 */
.route-row{
  display: flex;
  align-items: center;
}
.route-text-left,
.route-text-right{
  flex: 1;
  font-size: 32rpx;
  font-weight: 900;
  line-height: 40rpx;
  color: rgba(0,0,0,0.78);
}
.route-text-left{ text-align: left; }
.route-text-right{ text-align: right; }
.route-arrow{
  width: 80rpx;
  font-size: 34rpx;
  font-weight: 900;
  text-align: center;
  line-height: 40rpx;
  color: rgba(0,0,0,0.45);
}

.price-text-combined{
  font-size: 34rpx;
  line-height: 36rpx;     /* 可选：更紧凑 */
  color: #E54B3B;
  font-weight: 900;
  white-space: nowrap;
}


/* 司机区头部 */
.driver-header{
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.driver-avatar{
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}
.driver-name-box{ flex: 1; }
.driver-name{
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.78);
}

/* info-row */
.info-row{
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}
.label{
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.45);
  margin-right: 16rpx;
}
.value{
  flex: 1;
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.70);
  margin-right: 16rpx;
}
.wechat-row,
.phone-row,
.zelle-row{
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

/* 复制按钮：中性灰胶囊 */
.copy-btn{
  padding: 0 18rpx;
  font-size: 22rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 999rpx;
  background: rgba(0,0,0,0.06);
  color: rgba(0,0,0,0.65);
  margin-left: auto;
}
.copy-btn::after{ border: none; }

/* 乘客列表 */
.empty-tip,
.empty-text{
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.45);
  padding: 10rpx 0;
  text-align: center;
}

/* =========================
   司机信息：逐行排列（同款 Grid + 同款 copy-pill）
   ========================= */

/* 头像 + 名字：单独一行 */
.dprofile{
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 6rpx 0 14rpx;
}

.dprofile-avatar{
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
}

.dprofile-name{
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.78);
}

/* Grid 三列：label / value / button */
.pgrid{
  --label-w: 96rpx;
  --btn-w: 102rpx;
  --btn-h: 36rpx;

  display: grid;
  grid-template-columns: var(--label-w) 1fr var(--btn-w);
  column-gap: 6rpx;
  align-items: center;

  min-width: 0;
  min-height: 36rpx;

  padding: 8rpx 0;                 /* ✅ 行间距更“逐行” */
  border-top: 2rpx solid rgba(0,0,0,0.06);
}

.pgrid:first-of-type{
  border-top: none;                /* 第一行不画线（紧跟头像行时也更干净） */
}

.pgrid-label{
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.45);
  line-height: 34rpx;
  text-align: right;
}

.pgrid-value{
  min-width: 0;
  font-size: 24rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.70);
  line-height: 34rpx;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pgrid-btn-placeholder{
  height: var(--btn-h);
}

/* 同款复制按钮 */
.copy-pill{
  width: var(--btn-w);
  height: var(--btn-h);
  border-radius: 999rpx;

  display: flex;
  align-items: center;
  justify-content: center;

  font-size: 20rpx;
  font-weight: 900;
  line-height: 1;
  color: #fff;
  background: #9CB06A;

  justify-self: end;
  align-self: center;
}

/* =========================
   已加入乘客：统一为 Grid 版（同 myRequestDetailDriver）
   ========================= */

   .passenger-item{
    display: flex;
    align-items: flex-start;
    padding: 16rpx 0;
    border-top: 2rpx solid rgba(0,0,0,0.06);
    gap: 18rpx;
  }
  .passenger-item:first-child{ border-top: none; }
  
  /* 左侧：头像上 + 名字下 */
  .passenger-left{
    width: 128rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
  }
  
  .passenger-avatar{
    width: 92rpx;
    height: 92rpx;
    border-radius: 50%;
  }
  
  .passenger-name{
    margin-top: 10rpx;
    font-size: 24rpx;
    font-weight: 900;
    color: rgba(0,0,0,0.78);
    text-align: center;
  
    width: 128rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  
  /* 右侧三行容器 */
  .passenger-right{
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 12rpx;
  }
  
  /* 关键：本页如果你前面已经为“司机信息”定义了 pgrid 并带了 border/padding，
     这里把乘客卡片内的 pgrid 重置为“干净版”，避免出现分割线。 */
  .passenger-right .pgrid{
    border-top: none !important;
    padding: 0 !important;
    min-height: 36rpx;
  }
  
  /* 地址行顶部对齐 */
  .pgrid--addr{ align-items: start; }
  
  /* 地址允许两行 */
  .pgrid-value--addr{
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
/* ===== 顶部发车卡片：最终稳定版（只保留这一套） ===== */

.ui-trip-top-card .time-seat-row{
  display: flex;
  justify-content: space-between;
  align-items: center;      /* ✅ 现在对子元素是 view，必然居中一致 */
  margin-top: 20rpx;
  flex-wrap: nowrap;
  gap: 16rpx;
}

/* 左侧时间：可压缩省略号 */
.ui-trip-top-card .time-text{
  flex: 1;
  min-width: 0;

  font-size: 30rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.60);

  height: 34rpx;
  line-height: 34rpx;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 右侧余位：不压缩 */
.ui-trip-top-card .seat-text{
  flex-shrink: 0;

  font-size: 30rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.60);

  height: 34rpx;
  line-height: 34rpx;

  white-space: nowrap;
  text-align: right;
}

/* 价格行：缩小间距 */
.ui-trip-top-card .price-row{
  margin-top: 6rpx;         /* ✅ 更紧凑 */
  display: flex;
  justify-content: center;
}
