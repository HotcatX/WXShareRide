<view wx:if="{{visible}}" class="announcement-overlay" catchtouchmove="stopBubble">
  <view class="announcement-mask" data-source="mask" catchtap="onClose"></view>
  <view class="announcement-card" catchtap="stopBubble" aria-role="dialog" aria-label="社区公告">
    <view class="announcement-header">
      <view class="announcement-label">
        <view class="announcement-dot"></view>
        <text>社区公告</text>
      </view>
      <button class="announcement-close" data-source="close" catchtap="onClose" hover-class="announcement-pressed" aria-label="关闭公告">×</button>
    </view>

    <scroll-view class="announcement-scroll" scroll-y="{{true}}" enhanced="{{true}}" bounces="{{false}}" show-scrollbar="{{true}}">
      <view class="announcement-content">
        <text class="announcement-title">{{notice.title || '社区公告'}}</text>
        <text wx:if="{{notice.body}}" class="announcement-body">{{notice.body}}</text>
        <view wx:if="{{notice.imageUrl}}" class="announcement-image-area">
          <view wx:if="{{imageFailed}}" class="announcement-image-error">图片暂时加载失败，请稍后重新打开公告。</view>
          <block wx:else>
            <image class="announcement-image" src="{{notice.imageUrl}}" mode="widthFix" show-menu-by-longpress="{{true}}" binderror="onImageError" catchtap="onPreviewImage" aria-label="公告图片，点击查看大图"></image>
            <text class="announcement-image-hint">点击查看大图，也可长按图片</text>
          </block>
        </view>
      </view>
    </scroll-view>

    <view class="announcement-footer">
      <button class="announcement-confirm" data-source="confirm" catchtap="onClose" hover-class="announcement-pressed">知道了</button>
    </view>
  </view>
</view>
