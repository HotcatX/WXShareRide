.market-post-page{
  height: 100vh;
  overflow: hidden;
  background: #f4f6f8;
  color: #111418;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.post-top{
  background: #f4f6f8;
  border-bottom: 1rpx solid rgba(20,23,26,0.06);
  z-index: 2;
}

.post-nav{
  min-height: 96rpx;
  padding: 14rpx 24rpx 12rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
  box-sizing: border-box;
}

.nav-back{
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #111418;
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  line-height: 54rpx;
  font-weight: 700;
}

.nav-copy{
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.nav-kicker{
  color: #0f9b95;
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

.nav-title{
  color: #111418;
  font-size: 36rpx;
  line-height: 44rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.post-scroll{
  flex: 1;
  min-height: 0;
}

.post-content{
  padding: 18rpx 24rpx 0;
  box-sizing: border-box;
}

.inline-loading{
  margin-bottom: 18rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #69727d;
  font-size: 25rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.06);
}

.section-card{
  margin-bottom: 18rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid rgba(20,23,26,0.05);
  box-shadow: 0 10rpx 28rpx rgba(20,23,26,0.07);
  box-sizing: border-box;
}

.section-head{
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 18rpx;
}

.section-head.compact{
  margin-bottom: 12rpx;
}

.section-head view{
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.section-kicker{
  font-size: 20rpx;
  line-height: 26rpx;
  color: #0f9b95;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

.section-title{
  font-size: 31rpx;
  line-height: 40rpx;
  color: #111418;
  font-weight: 900;
}

.section-note{
  height: 40rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background: #f4f6f8;
  color: #69727d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
}

.image-uploader{
  width: 232rpx;
  height: 232rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: #f4f6f8;
  position: relative;
  border: 1rpx solid rgba(20,23,26,0.06);
}

.preview-img{
  width: 100%;
  height: 100%;
  display: block;
}

.image-placeholder{
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  color: #69727d;
  text-align: center;
}

.image-plus{
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #0f9b95;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  line-height: 62rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 20rpx rgba(20,23,26,0.07);
}

.image-title{
  margin-top: 8rpx;
  color: #111418;
  font-size: 26rpx;
  line-height: 32rpx;
  font-weight: 900;
}

.image-subtitle{
  color: #8a949f;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 700;
}

.image-upload-mask{
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2;
  background: rgba(17,20,24,0.46);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.upload-progress-card{
  min-width: 132rpx;
  min-height: 96rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(17,20,24,0.82);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-sizing: border-box;
}

.upload-progress-percent{
  color: #ffffff;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.upload-progress-text{
  color: rgba(255,255,255,0.86);
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.title-input{
  margin-top: 18rpx;
  height: 84rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  padding: 0 18rpx;
  box-sizing: border-box;
  color: #111418;
  font-size: 31rpx;
  font-weight: 900;
}

.desc-input{
  width: 100%;
  min-height: 132rpx;
  margin-top: 14rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  padding: 18rpx;
  box-sizing: border-box;
  color: #30363d;
  font-size: 27rpx;
  line-height: 38rpx;
  font-weight: 700;
}

.input-placeholder,
.price-placeholder{
  color: #9aa3ad;
  font-weight: 700;
}

.form-list{
  border-radius: 16rpx;
  overflow: hidden;
  background: #f8fafb;
}

.form-row{
  min-height: 92rpx;
  padding: 0 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(20,23,26,0.06);
  box-sizing: border-box;
}

.form-list .form-row:last-child{
  border-bottom: 0;
}

.row-label{
  flex: none;
  color: #111418;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.row-value{
  min-width: 0;
  flex: 1;
  color: #30363d;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 800;
  text-align: right;
}

.row-value text:first-child{
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-arrow{
  flex: none;
  color: #9aa3ad;
  font-size: 42rpx;
  line-height: 42rpx;
}

.price-control{
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  flex: 1;
}

.currency{
  color: #f05d4f;
  font-size: 32rpx;
  font-weight: 900;
}

.price-input{
  width: 180rpx;
  height: 76rpx;
  color: #f05d4f;
  font-size: 34rpx;
  font-weight: 900;
  text-align: right;
}

.location-row{
  align-items: flex-start;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
}

.location-value text:first-child{
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.muted{
  color: #9aa3ad;
}

.phrase-card{
  margin-bottom: 0;
}

.phrase-grid{
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.phrase-chip{
  min-height: 54rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  color: #30363d;
  border: 1rpx solid rgba(20,23,26,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  line-height: 30rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.bottom-space{
  height: calc(32rpx + env(safe-area-inset-bottom));
}

.submit-dock{
  margin-top: 18rpx;
  padding: 0;
  background: transparent;
  border-top: 0;
  box-sizing: border-box;
  z-index: 1;
  transition-property: opacity, transform;
  transition-duration: 120ms;
}

.dock-hidden{
  opacity: 0;
  transform: translateY(18rpx);
  pointer-events: none;
}

.submit-btn{
  height: 92rpx;
  border-radius: 18rpx;
  background: #111418;
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(17,20,24,0.26);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 31rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.submit-btn.disabled{
  opacity: 0.56;
}

.pressable{
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 120ms;
}

.is-pressed,
.row-pressed{
  opacity: 0.82;
  transform: scale(0.98);
}

.submit-pressed{
  opacity: 0.88;
  transform: scale(0.985);
  box-shadow: 0 10rpx 24rpx rgba(17,20,24,0.22);
}
