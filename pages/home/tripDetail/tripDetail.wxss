page{
  background: #f4f6f8;
}

.detail-ride{
  background: #f4f6f8;
}

.expired-route-action{
  width: auto;
  max-width: 100%;
  display: inline-block;
  padding: 0 32rpx;
}

.detail-scroll{
  padding-top: 14rpx;
}

.detail-hero-head{
  margin-bottom: 18rpx;
  gap: 12rpx;
}

.detail-driver-stats{
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #6b7581;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 36rpx;
  min-width: 0;
  flex: 1;
}

.detail-driver-stats text{
  white-space: nowrap;
}

.detail-driver-completed{
  color: #0f9b95;
  font-weight: 800;
}

.detail-driver-divider{
  color: #a1a9b2;
}

.detail-hero-head .ride-head-actions{
  flex-shrink: 0;
}

@media (max-width: 360px){
  .detail-driver-stats{
    gap: 6rpx;
  }

  .detail-hero-head .ride-head-actions{
    gap: 8rpx;
  }

  .detail-hero-head .ride-head-actions .ride-chip{
    padding: 0 12rpx;
  }
}

.detail-section-head{
  margin-bottom: 12rpx;
}

.detail-alternatives{
  padding-top: 0;
  padding-bottom: 0;
}

.detail-alternative{
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-top: 1rpx solid #edf1f3;
}

.detail-alternative:first-child{
  border-top: 0;
}

.detail-alternative-time{
  flex-shrink: 0;
  color: #087d78;
  font-size: 30rpx;
  font-weight: 800;
}

.detail-alternative-main{
  flex: 1;
  min-width: 0;
}

.detail-alternative-route{
  display: block;
  color: #26333b;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 38rpx;
  overflow-wrap: break-word;
}

.detail-alternative-meta{
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #76818d;
  font-size: 23rpx;
  line-height: 34rpx;
  margin-top: 4rpx;
}

.detail-alternative-meta .ride-publisher-name{
  flex: 1;
}

.detail-alternative-meta > text:not(.ride-publisher-name){
  flex-shrink: 0;
}

.detail-alternative-seats{
  color: #0c8c86;
}

.detail-alternative-arrow{
  flex-shrink: 0;
  color: #78918e;
  font-size: 40rpx;
}

.detail-request-row{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  color: #76818d;
  font-size: 25rpx;
}

.detail-alternative + .detail-request-row{
  border-top: 1rpx solid #edf1f3;
}

.detail-request-button{
  flex: none;
  width: auto;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: rgba(15,155,149,0.10);
  color: #087d78;
  font-size: 25rpx;
  font-weight: 700;
}

.detail-request-row--inline{
  margin-top: 20rpx;
  padding: 18rpx 0 0;
  border-top: 1rpx solid #edf1f3;
}

.detail-request-row--inline .detail-request-button{
  height: 48rpx;
  line-height: 48rpx;
  padding: 0;
  background: transparent;
}

.detail-paragraph{
  margin-top: 14rpx;
  display: block;
  color: #59636f;
  font-size: 26rpx;
  line-height: 38rpx;
  font-weight: 800;
}

.detail-toast{
  margin-bottom: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: #ffffff;
  border: 1rpx solid rgba(20,23,26,0.06);
  box-shadow: 0 8rpx 24rpx rgba(20,23,26,0.06);
}

.detail-toast.success{
  background: rgba(15,155,149,0.10);
}

.detail-toast.error,
.detail-toast.warn{
  background: rgba(230,76,60,0.10);
}

.detail-toast-icon{
  font-size: 26rpx;
  font-weight: 900;
}

.detail-toast-text{
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 800;
  color: #59636f;
}

.detail-driver{
  margin-top: 18rpx;
}

.detail-tags{
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin: 4rpx 0 8rpx;
}

.create-card-head{
  margin-bottom: 16rpx;
}

.create-card-head .ride-section-subtitle{
  display: block;
  margin-top: 2rpx;
}

/* 顶部路线信息：点、标签、地点水平对齐 */
.ride-route{
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.ride-route-body{
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.ride-route-point{
  display: flex;
  align-items: center;
  min-height: 44rpx;
}

.ride-route-label{
  width: 58rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  font-size: 24rpx;
  font-weight: 900;
  color: #8b96a3;
  line-height: 36rpx;
}

.ride-route-name{
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 900;
  color: #14171a;
  line-height: 40rpx;
}

/* 让拉黑司机和余位高度一致 */
.ride-head-actions{
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ride-head-actions .ride-chip{
  height: 48rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: 48rpx;
}

.ride-head-actions .ride-chip--small{
  height: 48rpx;
  padding: 0 18rpx;
  line-height: 48rpx;
}
