<view class="market-post-page">
  <view class="post-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="post-nav">
      <view class="nav-back pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onBack">‹</view>
      <view class="nav-copy">
        <text class="nav-kicker">{{postModeKicker}}</text>
        <text class="nav-title">{{postPageTitle}}</text>
      </view>
      <view class="nav-spacer"></view>
    </view>
  </view>

  <scroll-view class="post-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="post-content">
      <view wx:if="{{editLoading}}" class="inline-loading">正在加载内容...</view>

      <view class="section-card media-section">
        <view class="section-head">
          <view>
            <text class="section-kicker">Photo</text>
            <text class="section-title">{{photoSectionTitle}}</text>
          </view>
          <text class="section-note">可选</text>
        </view>

        <view class="image-uploader pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onChooseImage">
          <image wx:if="{{image}}" class="preview-img" src="{{image}}" mode="aspectFill" />
          <view wx:else class="image-placeholder">
            <text class="image-plus">＋</text>
            <text class="image-title">添加图片</text>
            <text class="image-subtitle">无图也可以发布</text>
          </view>

          <view wx:if="{{imageUploading}}" class="image-upload-mask" catchtap="noop">
            <view class="upload-progress-card">
              <text class="upload-progress-percent">{{imageUploadProgress}}%</text>
              <text class="upload-progress-text">{{imageUploadText}}</text>
            </view>
          </view>
        </view>

        <input
          class="title-input"
          value="{{title}}"
          placeholder="{{titlePlaceholder}}"
          placeholder-class="input-placeholder"
          bindinput="onTitleInput"
        />

        <textarea
          class="desc-input"
          value="{{desc}}"
          placeholder="{{descPlaceholder}}"
          placeholder-class="input-placeholder"
          maxlength="500"
          bindinput="onDescInput"
        />
      </view>

      <view class="section-card">
        <view class="section-head compact">
          <view>
            <text class="section-kicker">Details</text>
            <text class="section-title">{{detailSectionTitle}}</text>
          </view>
        </view>

        <view class="form-list">
          <picker mode="selector" range="{{categoryOptions}}" value="{{categoryIndex}}" bindchange="onCategoryPickerChange">
            <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80">
              <view class="row-label">{{categoryLabel}}</view>
              <view class="row-value">
                <text>{{categoryDisplay}}</text>
                <text class="row-arrow">›</text>
              </view>
            </view>
          </picker>

          <view class="form-row">
            <view class="row-label">{{priceLabel}}</view>
            <view class="price-control">
              <text class="currency">$</text>
              <input
                class="price-input"
                value="{{price}}"
                placeholder="0.00"
                placeholder-class="price-placeholder"
                keyboard-type="digit"
                bindinput="onPriceInput"
              />
            </view>
          </view>

          <view wx:if="{{showConditionRow}}" class="form-row pressable" hover-class="row-pressed" hover-stay-time="80" bindtap="onChooseCondition">
            <view class="row-label">{{conditionLabel}}</view>
            <view class="row-value">
              <text>{{condition}}</text>
              <text class="row-arrow">›</text>
            </view>
          </view>

          <block wx:if="{{showSubletFields}}">
            <view class="form-row">
              <view class="row-label">押金</view>
              <view class="price-control">
                <text class="currency">$</text>
                <input
                  class="price-input"
                  value="{{deposit}}"
                  placeholder="可不填"
                  placeholder-class="price-placeholder"
                  keyboard-type="digit"
                  bindinput="onDepositInput"
                />
              </view>
            </view>

            <picker mode="selector" range="{{housingTypeOptions}}" value="{{housingTypeIndex}}" bindchange="onHousingTypePickerChange">
              <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80">
                <view class="row-label">房源类型</view>
                <view class="row-value">
                  <text>{{housingTypeDisplay}}</text>
                  <text class="row-arrow">›</text>
                </view>
              </view>
            </picker>

            <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80" bindtap="onToggleFurnished">
              <view class="row-label">带家具</view>
              <view class="row-value toggle-value">
                <text>{{furnishedDisplay}}</text>
                <view class="mini-toggle {{furnished ? 'on' : ''}}">
                  <view class="mini-toggle-knob"></view>
                </view>
              </view>
            </view>

            <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80" bindtap="onToggleUtilities">
              <view class="row-label">水电网</view>
              <view class="row-value toggle-value">
                <text>{{utilitiesIncludedDisplay}}</text>
                <view class="mini-toggle {{utilitiesIncluded ? 'on' : ''}}">
                  <view class="mini-toggle-knob"></view>
                </view>
              </view>
            </view>

            <picker mode="selector" range="{{genderPreferenceOptions}}" value="{{genderPreferenceIndex}}" bindchange="onGenderPreferencePickerChange">
              <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80">
                <view class="row-label">室友要求</view>
                <view class="row-value">
                  <text>{{genderPreferenceDisplay}}</text>
                  <text class="row-arrow">›</text>
                </view>
              </view>
            </picker>

            <view class="form-row">
              <view class="row-label">室友数</view>
              <view class="row-value">
                <input
                  class="small-number-input"
                  value="{{roommateCount}}"
                  placeholder="可不填"
                  placeholder-class="price-placeholder"
                  keyboard-type="number"
                  bindinput="onRoommateCountInput"
                />
              </view>
            </view>
          </block>

          <picker mode="date" start="{{pickupStartMin}}" end="{{pickupStartMax}}" value="{{pickupStartDate}}" bindchange="onPickupStartDateChange">
            <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80">
              <view class="row-label">{{pickupStartLabel}}</view>
              <view class="row-value">
                <text>{{pickupStartDate}}</text>
                <text class="row-arrow">›</text>
              </view>
            </view>
          </picker>

          <picker mode="date" start="{{pickupEndMin}}" end="{{pickupEndMax}}" value="{{pickupEndDate}}" bindchange="onPickupEndDateChange">
            <view class="form-row pressable" hover-class="row-pressed" hover-stay-time="80">
              <view class="row-label">{{pickupEndLabel}}</view>
              <view class="row-value">
                <text>{{pickupEndDate}}</text>
                <text class="row-arrow">›</text>
              </view>
            </view>
          </picker>

          <view class="form-row location-row pressable" hover-class="row-pressed" hover-stay-time="80" bindtap="onTapProfileLocation">
            <view class="row-label">{{locationLabel}}</view>
            <view class="row-value location-value">
              <text class="{{locationMutedClass}}">{{locationDisplay}}</text>
              <text class="row-arrow">›</text>
            </view>
          </view>
        </view>
      </view>

      <view class="submit-dock {{dockVisibleClass}}">
        <view
          class="submit-btn {{submitDisabledClass}} pressable"
          hover-class="submit-pressed"
          hover-stay-time="80"
          bindtap="onSubmit"
        >
          {{submitText}}
        </view>
      </view>

      <view class="bottom-space"></view>
    </view>
  </scroll-view>
</view>
