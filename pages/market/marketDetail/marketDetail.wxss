.market-detail-page{
  height: 100vh;
  overflow: hidden;
  background: #f4f6f8;
  color: #111418;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.detail-top{
  background: #f4f6f8;
  border-bottom: 1rpx solid rgba(20,23,26,0.06);
  z-index: 2;
}

.detail-nav{
  min-height: 88rpx;
  padding: 12rpx 24rpx;
  display: grid;
  grid-template-columns: 72rpx 1fr 72rpx;
  align-items: center;
  box-sizing: border-box;
}

.nav-back{
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #ffffff;
  color: #111418;
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 54rpx;
  line-height: 54rpx;
  font-weight: 700;
}

.nav-title{
  color: #111418;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 900;
  text-align: center;
}

.detail-scroll{
  flex: 1;
  min-height: 0;
}

.hero-card{
  margin: 18rpx 24rpx 0;
  height: 640rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #e9edf1;
  position: relative;
  box-shadow: 0 12rpx 34rpx rgba(20,23,26,0.10);
}

.photo-swiper,
.hero-img,
.hero-no-img{
  width: 100%;
  height: 100%;
}

.hero-img{
  display: block;
}

.hero-no-img{
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 50rpx;
  box-sizing: border-box;
  background: linear-gradient(135deg, #e8f4f2 0%, #f2f0ea 100%);
  color: #111418;
  text-align: center;
}

.hero-no-img text{
  font-size: 48rpx;
  line-height: 58rpx;
  font-weight: 900;
  word-break: break-all;
}

.hero-badge{
  position: absolute;
  left: 18rpx;
  top: 18rpx;
  max-width: 220rpx;
  height: 48rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: rgba(17,20,24,0.74);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.detail-content{
  padding: 18rpx 24rpx 0;
  box-sizing: border-box;
}

.title-card,
.section-card{
  padding: 22rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid rgba(20,23,26,0.05);
  box-shadow: 0 10rpx 28rpx rgba(20,23,26,0.07);
  box-sizing: border-box;
}

.price-row{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.price{
  color: #f05d4f;
  font-size: 46rpx;
  line-height: 54rpx;
  font-weight: 900;
}

.condition{
  max-width: 180rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background: rgba(15,155,149,0.10);
  color: #0f817c;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.product-title{
  display: block;
  margin-top: 12rpx;
  color: #111418;
  font-size: 38rpx;
  line-height: 48rpx;
  font-weight: 900;
  word-break: break-all;
}

.stats-row{
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.stats-row text{
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: #f4f6f8;
  color: #69727d;
  display: flex;
  align-items: center;
  font-size: 21rpx;
  font-weight: 800;
}

.info-grid{
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
}

.sublet-info-grid{
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.info-cell{
  min-height: 86rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.06);
  box-sizing: border-box;
}

.info-cell.compact{
  min-height: 78rpx;
  padding: 16rpx;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.info-label{
  flex: none;
  color: #69727d;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 800;
}

.info-value{
  min-width: 0;
  flex: 1;
  color: #111418;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
  text-align: right;
  word-break: break-word;
}

.info-cell.compact .info-value{
  width: 100%;
  text-align: left;
}

.section-card{
  margin-top: 16rpx;
}

.section-title{
  display: block;
  color: #111418;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.desc-text{
  display: block;
  margin-top: 12rpx;
  color: #30363d;
  font-size: 27rpx;
  line-height: 42rpx;
  font-weight: 700;
  word-break: break-word;
}

.quick-actions{
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.quick-btn{
  min-height: 76rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #111418;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 25rpx;
  line-height: 32rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.06);
  box-sizing: border-box;
}

.bottom-space{
  height: calc(32rpx + env(safe-area-inset-bottom));
}

.detail-dock{
  margin-top: 16rpx;
  padding: 0;
  background: transparent;
  border-top: 0;
  box-sizing: border-box;
  z-index: 1;
  transition-property: opacity, transform;
  transition-duration: 120ms;
}

.dock-hidden{
  opacity: 0;
  transform: translateY(18rpx);
  pointer-events: none;
}

.owner-actions{
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
}

.dock-btn{
  height: 92rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 31rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.dock-btn.primary{
  background: #111418;
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(17,20,24,0.26);
}

.dock-btn.secondary{
  background: #ffffff;
  color: #111418;
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.08);
}

.dock-btn.danger{
  background: #f05d4f;
  color: #ffffff;
  box-shadow: 0 12rpx 26rpx rgba(240,93,79,0.20);
}

.is-sublet-detail .hero-card{
  margin: 12rpx 20rpx 0;
  height: 360rpx;
  border-radius: 18rpx;
}

.is-sublet-detail .hero-no-img{
  padding: 36rpx;
}

.is-sublet-detail .hero-no-img text{
  font-size: 38rpx;
  line-height: 46rpx;
}

.is-sublet-detail .hero-badge{
  left: 14rpx;
  top: 14rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.is-sublet-detail .detail-content{
  padding: 12rpx 20rpx 0;
}

.is-sublet-detail .title-card,
.is-sublet-detail .section-card{
  padding: 18rpx;
  border-radius: 16rpx;
}

.is-sublet-detail .price-row{
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 240rpx);
  gap: 10rpx;
}

.is-sublet-detail .price{
  min-width: 0;
  font-size: 40rpx;
  line-height: 48rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.is-sublet-detail .condition{
  justify-self: end;
  max-width: 100%;
  height: 38rpx;
  padding: 0 10rpx;
  border-radius: 10rpx;
  display: block;
  font-size: 20rpx;
  line-height: 38rpx;
  text-align: center;
}

.is-sublet-detail .product-title{
  margin-top: 8rpx;
  font-size: 32rpx;
  line-height: 40rpx;
}

.is-sublet-detail .stats-row{
  margin-top: 10rpx;
  gap: 8rpx;
}

.is-sublet-detail .stats-row text{
  height: 32rpx;
  padding: 0 10rpx;
  border-radius: 9rpx;
  font-size: 20rpx;
}

.is-sublet-detail .info-grid{
  margin-top: 10rpx;
  gap: 8rpx;
}

.is-sublet-detail .sublet-info-grid{
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.is-sublet-detail .info-cell{
  min-height: 64rpx;
  padding: 12rpx 14rpx;
  border-radius: 14rpx;
  gap: 12rpx;
  align-items: center;
}

.is-sublet-detail .info-cell.compact{
  min-height: 66rpx;
  padding: 10rpx 12rpx;
  gap: 2rpx;
}

.is-sublet-detail .info-label{
  font-size: 21rpx;
  line-height: 28rpx;
}

.is-sublet-detail .info-value{
  font-size: 23rpx;
  line-height: 30rpx;
}

.is-sublet-detail .info-cell.compact .info-value{
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.is-sublet-detail .section-card{
  margin-top: 10rpx;
}

.is-sublet-detail .section-title{
  font-size: 27rpx;
  line-height: 34rpx;
}

.is-sublet-detail .desc-text{
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 34rpx;
}

.is-sublet-detail .quick-actions{
  margin-top: 10rpx;
  gap: 10rpx;
}

.is-sublet-detail .quick-btn{
  min-height: 64rpx;
  border-radius: 14rpx;
  font-size: 23rpx;
  line-height: 30rpx;
}

.is-sublet-detail .detail-dock{
  margin-top: 12rpx;
}

.is-sublet-detail .owner-actions{
  gap: 10rpx;
}

.is-sublet-detail .dock-btn{
  height: 76rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.is-sublet-detail .bottom-space{
  height: calc(20rpx + env(safe-area-inset-bottom));
}

.pressable{
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 120ms;
}

.is-pressed{
  opacity: 0.82;
  transform: scale(0.98);
}

.dock-pressed{
  opacity: 0.88;
  transform: scale(0.985);
  box-shadow: 0 10rpx 24rpx rgba(17,20,24,0.22);
}
