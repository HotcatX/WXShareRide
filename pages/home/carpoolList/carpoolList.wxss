page{
  background: #f4f6f8;
}

.list-ride{
  background: #f4f6f8;
}

.list-city-entry{
  position: absolute;
  left: 92rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 220rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #111418;
  box-sizing: border-box;
}

.list-city-text{
  max-width: 178rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 31rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.list-city-caret{
  color: #59636f;
  font-size: 28rpx;
  line-height: 30rpx;
  font-weight: 900;
}

/* 找路线筛选卡片 */
.list-filter{
  margin: 0 28rpx 10rpx;
}

.list-filter.ride-card-pad{
  padding: 14rpx 16rpx 16rpx;
}

.list-filter-title-row{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.list-filter-title-row .ride-section-title{
  font-size: 27rpx;
  line-height: 34rpx;
}

.list-filter-title-row .ride-section-subtitle{
  display: none;
}

/* 重置按钮：黑底白字 */
.list-filter-title-row .ride-chip{
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #111418;
  color: #ffffff;
  border: none;
  font-size: 22rpx;
  line-height: 44rpx;
  font-weight: 800;
}

/* 三个筛选整体左右变窄 */
.list-filter-grid{
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  gap: 10rpx;
  padding: 0 10rpx;
}

/* 每个 picker */
.list-filter-grid picker{
  min-width: 0;
}

/* 筛选按钮：上下更高、左右更窄 */
.list-filter .ride-field{
  height: 50rpx;
  min-height: 50rpx;
  padding: 0 8rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 隐藏小标题 */
.list-filter .ride-field-label{
  display: none;
}

/* 筛选文字：字体稍微扩大 */
.list-filter .ride-field-value{
  margin-top: 0;
  width: 100%;
  text-align: center;
  font-size: 23rpx;
  line-height: 50rpx;
  font-weight: 800;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.list-scroll{
  padding: 10rpx 12rpx 0;
}

.list-unavailable-card{
  margin: 22rpx 16rpx 0;
}

.ride-unavailable-card{
  padding: 44rpx 36rpx 42rpx;
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  text-align: left;
  box-sizing: border-box;
}

.ride-unavailable-title{
  display: block;
  color: #111418;
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 900;
}

.ride-unavailable-desc{
  margin-top: 18rpx;
  display: block;
  color: #69727d;
  font-size: 27rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.ride-unavailable-button{
  margin-top: 34rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #0f9b95;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 34rpx rgba(15,155,149,0.18);
}

.ride-unavailable-button.is-done{
  background: #eef2f5;
  color: #59636f;
  box-shadow: none;
}

.list-scroll .ride-card + .ride-card{
  margin-top: 0;
}

.list-date-row{
  margin: 10rpx 4rpx 5rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.list-date{
  font-size: 25rpx;
  line-height: 31rpx;
  font-weight: 900;
  color: #111418;
}

.list-date-count{
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 800;
  color: #69727d;
}

.list-trip-card{
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx;
}

.list-trip-card .ride-list-head{
  margin-bottom: 10rpx;
  align-items: center;
}

.list-kind-row{
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.list-trip-card .ride-list-kind{
  display: flex;
  align-items: center;
  font-size: 23rpx;
  line-height: 30rpx;
}

.list-kind-row .ride-chip{
  height: 36rpx;
  padding: 0 11rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
  line-height: 34rpx;
  display: flex;
  align-items: center;
}

.list-trip-card .ride-list-time{
  font-size: 23rpx;
  line-height: 30rpx;
  color: #69727d;
}

.list-route-inline{
  min-width: 0;
  position: relative;
}

.list-route-main{
  min-width: 0;
  width: 100%;
  display: grid;
  grid-template-columns: minmax(0,0.92fr) 96rpx minmax(0,1.08fr);
  align-items: center;
  column-gap: 10rpx;
}

.list-route-place{
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  box-sizing: border-box;
}

.list-route-main .list-route-place:first-child{
  justify-content: flex-start;
}

.list-route-main .list-route-place:last-child{
  justify-content: flex-start;
  padding-right: 108rpx;
}

.list-route-label{
  flex: none;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 900;
  color: #59636f;
}

.list-route-name{
  min-width: 0;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
  color: #111418;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-route-arrow{
  width: 92rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: rgba(15,155,149,0.08);
  color: #0f746f;
  border: 1rpx solid rgba(15,155,149,0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  justify-self: center;
  align-self: center;
  font-size: 31rpx;
  line-height: 34rpx;
  font-weight: 900;
  text-align: center;
  box-sizing: border-box;
}

.list-seat-chip{
  flex: none;
  height: 36rpx;
  padding: 0 11rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
  line-height: 34rpx;
}

.list-route-side{
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 6rpx;
  max-width: 100rpx;
}

.list-price-chip{
  max-width: 120rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: #111418;
  color: #ffffff;
  border: none;
  font-size: 21rpx;
  line-height: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.toast-bar{
  position: fixed;
  top: calc(44px + constant(safe-area-inset-top) + 32rpx);
  top: calc(44px + env(safe-area-inset-top) + 32rpx);
  left: 50%;
  transform: translateX(-50%);
  max-width: 80%;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(17, 20, 24, 0.88);
  color: #fff;
  display: flex;
  align-items: center;
  z-index: 999;
  font-size: 26rpx;
  line-height: 1.4;
  box-shadow: 0 8rpx 24rpx rgba(20,23,26,0.18);
}

.toast-icon{
  margin-right: 12rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.toast-text{
  flex: 1;
  word-break: break-all;
}

.city-mask{
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(17,20,24,0.38);
}

.city-panel{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10001;
  height: min(76vh, 980rpx);
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  border-top-left-radius: 22rpx;
  border-top-right-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 -18rpx 40rpx rgba(17,20,24,0.14);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.city-header{
  height: 92rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid rgba(20,23,26,0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.city-title{
  color: #111418;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.city-close{
  min-width: 96rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #69727d;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.city-search-wrap{
  padding: 16rpx 24rpx 18rpx;
  border-bottom: 1rpx solid rgba(20,23,26,0.08);
  box-sizing: border-box;
}

.city-search-input{
  width: 100%;
  height: 70rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f4f6f8;
  color: #111418;
  font-size: 26rpx;
  line-height: 70rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.city-search-placeholder{
  color: #9aa4af;
  font-weight: 700;
}

.city-body{
  min-height: 0;
  flex: 1;
  display: grid;
  grid-template-columns: 168rpx minmax(0, 1fr);
}

.city-country-tabs{
  height: 100%;
  min-height: 0;
  padding: 18rpx 0;
  background: #f4f6f8;
  overflow: hidden;
  box-sizing: border-box;
}

.city-country{
  height: 82rpx;
  padding-left: 24rpx;
  border-left: 8rpx solid transparent;
  color: #59636f;
  display: flex;
  align-items: center;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.city-country.active{
  color: #0f9b95;
  border-left-color: #0f9b95;
  background: #ffffff;
  font-weight: 900;
}

.city-group-scroll{
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.city-group{
  padding: 26rpx 28rpx 4rpx;
}

.city-group-title{
  margin-bottom: 18rpx;
  color: #111418;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.city-hot-badge{
  padding: 0 7rpx;
  border-radius: 8rpx;
  background: #ff6b4a;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 28rpx;
  font-weight: 900;
  font-style: italic;
}

.city-grid{
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.city-option{
  height: 68rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  color: #3f4751;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.city-option.active{
  background: #0f9b95;
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15,155,149,0.18);
}

.city-empty{
  padding: 72rpx 28rpx 24rpx;
  color: #8b95a1;
  text-align: center;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.city-picker-hint{
  margin: 18rpx 28rpx 28rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f4f8f7;
  color: #66717d;
  font-size: 23rpx;
  line-height: 34rpx;
  font-weight: 700;
}
