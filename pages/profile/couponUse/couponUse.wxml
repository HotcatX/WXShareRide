<view class="page">
  <!-- custom nav -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="onBack">
        <image class="nav-back" src="/images/back.png" mode="aspectFit" />
      </view>
      <text class="nav-title">优惠券</text>
      <view class="nav-right"></view>
    </view>
  </view>

  <!-- tabs（只做展示，跟列表一致） -->
  <view class="tabs">
    <view class="tab active">全部</view>
    <view class="tab">餐厅</view>
    <view class="tab">娱乐</view>
  </view>

  <scroll-view class="content" scroll-y="true">
    <!-- 大图区域 -->
    <view class="img-wrap">
      <view class="close-x" bindtap="onBack">×</view>
      <image class="coupon-img" src="{{coupon.image}}" mode="widthFix" />
    </view>

    <!-- 下方再放一张“同款信息卡”（和你图一致） -->
    <view class="coupon-card">
      <view class="left">
        <view class="tags">
          <view class="tag red">{{coupon.tag1}}</view>
          <view class="tag yellow">{{coupon.tag2}}</view>
        </view>
        <view class="title">{{coupon.title}}</view>
        <view class="expire">{{coupon.expireText}}</view>
      </view>

      <view class="right">
        <view class="discount">{{coupon.discountText}}</view>
        <view class="note">{{coupon.note}}</view>

        <!-- 现在先占位：点了提示“请向商家出示” -->
        <view class="use-btn" bindtap="onConfirmUse">去使用</view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>
</view>
