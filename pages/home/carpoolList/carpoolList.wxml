<timeline-preview wx:if="{{isTimelinePreview}}" id="timeline-preview" context="{{timelineContext}}" />
<block wx:elif="{{timelinePageReady}}">
<view class="ride-shell list-ride">
  <view class="ride-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar ride-topbar--center">
      <view
        class="ride-back ride-back-text"
        bindtap="goBack"
        hover-class="ride-pressed"
        hover-stay-time="80"
      >
        <text>‹</text>
      </view>
      <!-- <view
        class="list-city-entry"
        bindtap="onTapCity"
        hover-class="ride-pressed"
        hover-stay-time="80"
      >
        <text class="list-city-text">{{activeCityLabel}}</text>
        <text class="list-city-caret">⌄</text>
      </view> -->
      <text class="ride-nav-title">{{pageTitle}}</text>
    </view>

    <view wx:if="{{isRideServiceAvailable}}" class="list-filter">
      <view class="list-place-bar">
        <view class="list-place-field" data-field="from" bindtap="onOpenPlacePicker" hover-class="ride-pressed" role="button" aria-label="选择出发地">
          <view class="list-place-value-row"><text class="list-place-value {{selectedFromPlace ? 'is-selected' : ''}}">{{fromFilterLabel}}</text><text class="list-filter-caret">⌄</text></view>
        </view>
        <view class="list-swap" bindtap="onSwapFilterPlaces" hover-class="ride-pressed" role="button" aria-label="交换出发地和目的地">⇄</view>
        <view class="list-place-field" data-field="to" bindtap="onOpenPlacePicker" hover-class="ride-pressed" role="button" aria-label="选择目的地">
          <view class="list-place-value-row"><text class="list-place-value {{selectedToPlace ? 'is-selected' : ''}}">{{toFilterLabel}}</text><text class="list-filter-caret">⌄</text></view>
        </view>
        <view class="list-refine-entry {{moreFilterCount ? 'is-active' : ''}}" bindtap="onOpenRefineFilters" hover-class="ride-pressed" role="button" aria-label="筛选日期和路线类型">筛选<text wx:if="{{moreFilterCount}}" class="list-refine-count">{{moreFilterCount}}</text></view>
      </view>

      <view wx:if="{{moreFilterCount}}" class="list-active-filters">
        <text wx:if="{{selectedDate || timeFilterIndex >= 0}}">{{selectedDate ? dateFilterLabel : (timeFilterIndex === 0 ? '今天' : (timeFilterIndex === 1 ? '明天' : '其他日期'))}}</text>
        <text wx:if="{{routeTypeFilter !== 'all'}}" class="{{routeTypeFilter === 'request' ? 'list-active-request' : ''}}">{{routeTypeFilter === 'request' ? '只看求车' : '只看发车'}}</text>
        <view class="list-active-reset" bindtap="onResetFilter" hover-class="ride-pressed">重置</view>
      </view>
    </view>
  </view>

  <scroll-view
    class="ride-scroll list-scroll"
    scroll-y="{{!placePickerVisible && !refineFiltersVisible}}"
    enhanced="true"
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refresherTriggered}}"
    bindrefresherrefresh="onPullDownRefresh"
    bindscrolltolower="onLoadMoreDays"
    lower-threshold="120"
  >
    <view wx:if="{{!isRideServiceAvailable}}" class="ride-card ride-card-pad ride-unavailable-card list-unavailable-card">
      <text class="ride-unavailable-title">{{activeCityLabel}} 暂无出行服务</text>
      <text class="ride-unavailable-desc">目前只服务纽约/新泽西区域。你可以提交区域需求，我们会按请求量优先评估开通。</text>
      <view
        class="ride-unavailable-button {{rideDemandRequested ? 'is-done' : ''}}"
        bindtap="onRequestRideCityService"
        hover-class="ride-pressed"
        hover-stay-time="80"
      >
        {{rideDemandRequested ? '已收到请求' : (rideDemandSubmitting ? '提交中...' : '请求增加该区域')}}
      </view>
    </view>

    <view wx:elif="{{loading && !hasLoadedOnce}}" class="ride-state">
      {{loadingText}}
    </view>

    <view wx:elif="{{!dayGroups || dayGroups.length === 0}}" class="ride-state">
      <text>{{fullTripCount ? '暂无有空座的车辆，可展开查看已满车辆' : (hasMoreDays ? '这两天暂无符合条件的路线，可继续查看后续日期' : (hasActiveFilters ? '没有符合条件的路线，试试其他地点或日期' : '暂无可查看的行程'))}}</text>
      <view wx:if="{{hasActiveFilters && !fullTripCount}}" class="list-empty-reset" bindtap="onResetFilter" hover-class="ride-pressed">清除筛选</view>
    </view>

    <block wx:else>
      <block wx:for="{{dayGroups}}" wx:key="key">
        <view class="list-date-row">
          <text class="list-date">{{item.dateLabel}}</text>
          <view class="list-date-count">
            <text class="list-date-count--carpool">发车 {{item.carpoolCount || 0}}</text>
            <text class="list-date-count-separator">·</text>
            <text class="list-date-count--request">求车 {{item.requestCount || 0}}</text>
          </view>
        </view>

        <block wx:if="{{item.items && item.items.length}}">
          <block wx:for="{{item.items}}" wx:for-item="trip" wx:key="_id">
            <view
              class="ride-card ride-list-card list-trip-card {{trip._type === 'request' ? 'list-trip-card--request' : ''}}"
              bindtap="goItemDetail"
              data-id="{{trip._id}}"
              data-type="{{trip._type}}"
              hover-class="ride-card-pressed"
              hover-stay-time="80"
            >
              <view class="ride-list-head">
                <view class="list-kind-row">
                  <text class="ride-list-kind">{{trip._type === 'request' ? '求车路线' : '发车路线'}}</text>
                  <text wx:if="{{trip._priceText}}" class="ride-chip list-price-chip">{{trip._priceText}}</text>
                </view>
                <text class="ride-list-time">时间 {{trip._timeLabel || '待定'}}</text>
              </view>

              <view class="list-route-inline">
                <view class="list-route-main">
                  <view class="list-route-place">
                    <text class="list-route-name">{{trip._fromAddress || '出发地未设置'}}</text>
                  </view>
                  <text class="list-route-arrow">→</text>
                  <view class="list-route-place">
                    <text class="list-route-name">{{trip._toAddress || '目的地未设置'}}</text>
                  </view>
                </view>

                <view class="list-route-side">
                  <text wx:if="{{trip._type === 'carpool'}}" class="ride-chip list-seat-chip list-seat-chip--{{trip._seatAvailability || 'unknown'}}">{{trip._seatLabel || '余位 —'}}</text>
                  <text wx:else class="ride-chip ride-chip--accent list-seat-chip">{{trip._requestPassengerCount || 1}}人求车</text>
                </view>
              </view>
            </view>
          </block>
        </block>
      </block>
    </block>

    <view
      wx:if="{{isRideServiceAvailable && fullTripCount > 0}}"
      class="ride-card ride-list-card list-trip-card list-full-toggle"
      bindtap="onToggleFullTrips"
      hover-class="ride-card-pressed"
      hover-stay-time="80"
      role="button"
      aria-label="{{(showFullTrips ? '收起' : '显示') + fullTripCount + '辆已满车辆'}}"
    >
      <text>{{showFullTrips ? '收起' : '显示'}}{{fullTripCount}}辆已满车辆</text>
    </view>

    <view
      wx:if="{{isRideServiceAvailable && hasLoadedOnce && (hasMoreDays || loadingMoreDays || loadMoreError)}}"
      class="list-load-more {{loadingMoreDays || loading ? 'is-loading' : ''}} {{loadMoreError ? 'is-error' : ''}}"
      bindtap="onLoadMoreDays"
      hover-class="ride-pressed"
      role="button"
      aria-label="{{loadingMoreDays ? '正在加载更多路线' : (loadMoreError ? '加载失败，点击重试' : '加载后两天的路线')}}"
      aria-disabled="{{loadingMoreDays || loading}}"
    >{{loadingMoreDays ? '正在加载更多路线…' : (loadMoreError ? '加载失败，点击重试' : '继续向下滑，查看后两天')}}</view>
    <view wx:elif="{{isRideServiceAvailable && hasLoadedOnce && !loading && (dayGroups.length || fullTripCount)}}" class="list-load-more list-load-more--complete">已显示全部路线</view>

    <view class="toast-bar" wx:if="{{showToast}}">
      <text class="toast-icon">!</text>
      <text class="toast-text">{{toastText}}</text>
    </view>

    <text wx:if="{{isRideServiceAvailable}}" class="ride-refresh-hint">{{refreshHintText}}</text>
    <view class="ride-bottom-space"></view>
  </scroll-view>

  <view wx:if="{{refineFiltersVisible}}">
    <view class="list-place-mask" bindtap="onCloseRefineFilters" catchtouchmove="stopTouchMove"></view>
    <view class="list-place-panel list-refine-panel">
      <view class="list-place-panel-handle"></view>
      <view class="list-place-panel-header">
        <text class="list-place-panel-title">筛选路线</text>
        <view class="list-place-close" bindtap="onCloseRefineFilters" hover-class="ride-pressed" role="button" aria-label="关闭筛选">×</view>
      </view>
      <text class="list-refine-section-title">出发日期</text>
      <view class="list-date-filters">
        <view class="list-date-option {{timeFilterIndex < 0 && !selectedDate ? 'is-active' : ''}}" data-value="all" bindtap="onQuickDateChange" hover-class="ride-pressed">不限日期</view>
        <view class="list-date-option {{timeFilterIndex === 0 && !selectedDate ? 'is-active' : ''}}" data-value="today" bindtap="onQuickDateChange" hover-class="ride-pressed">今天</view>
        <view class="list-date-option {{timeFilterIndex === 1 && !selectedDate ? 'is-active' : ''}}" data-value="tomorrow" bindtap="onQuickDateChange" hover-class="ride-pressed">明天</view>
        <picker class="list-date-picker" mode="date" value="{{selectedDate || todayDateStr}}" start="{{todayDateStr}}" bindchange="onSpecificDateChange">
          <view class="list-date-option {{selectedDate || timeFilterIndex === 2 ? 'is-active' : ''}}"><text>{{dateFilterLabel}}</text><text class="list-filter-caret">⌄</text></view>
        </picker>
      </view>

      <text class="list-refine-section-title">路线类型</text>
      <view class="list-type-tabs">
        <view class="list-type-tab {{routeTypeFilter === 'all' ? 'is-active' : ''}}" data-type="all" bindtap="onRouteTypeChange" hover-class="ride-pressed">全部路线</view>
        <view class="list-type-tab {{routeTypeFilter === 'carpool' ? 'is-active' : ''}}" data-type="carpool" bindtap="onRouteTypeChange" hover-class="ride-pressed"><text class="list-type-dot"></text>发车路线</view>
        <view class="list-type-tab list-type-tab--request {{routeTypeFilter === 'request' ? 'is-active' : ''}}" data-type="request" bindtap="onRouteTypeChange" hover-class="ride-pressed"><text class="list-type-dot"></text>求车路线</view>
      </view>
      <view class="list-refine-footer">
        <view class="list-refine-reset" bindtap="onResetFilter" hover-class="ride-pressed">重置</view>
        <view class="list-refine-done" bindtap="onCloseRefineFilters" hover-class="ride-pressed">完成</view>
      </view>
    </view>
  </view>

  <view wx:if="{{placePickerVisible}}" class="list-place-picker">
    <view class="list-place-mask" bindtap="onClosePlacePicker" catchtouchmove="stopTouchMove"></view>
    <view class="list-place-panel">
      <view class="list-place-panel-handle"></view>
      <view class="list-place-panel-header">
        <text class="list-place-panel-title">{{placePickerTitle}}</text>
        <view class="list-place-close" bindtap="onClosePlacePicker" hover-class="ride-pressed" role="button" aria-label="关闭地点选择">×</view>
      </view>
      <view class="list-place-search">
        <text class="list-place-search-icon">⌕</text>
        <input class="list-place-search-input" placeholder="搜索地点，如 Fort Lee、哥大" placeholder-class="list-place-search-placeholder" value="{{placeSearchKeyword}}" bindinput="onPlaceSearchInput" confirm-type="search" />
      </view>
      <scroll-view class="list-place-options-scroll" scroll-y enhanced="true" show-scrollbar="false">
        <view class="list-place-options">
          <view wx:for="{{placePickerOptions}}" wx:key="value" class="list-place-option {{item.selected ? 'is-selected' : ''}}" data-value="{{item.value}}" bindtap="onSelectFilterPlace" hover-class="ride-pressed">
            <text>{{item.label}}</text><text wx:if="{{item.selected}}" class="list-place-check">✓</text>
          </view>
        </view>
        <view wx:if="{{!placePickerOptions.length || (placeSearchKeyword && placePickerOptions.length === 1 && !placePickerOptions[0].value)}}" class="list-place-no-results">没有匹配的地点，换个关键词试试</view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{cityPickerVisible}}">
    <view class="city-mask" bindtap="onCityPickerCancel"></view>

    <view class="city-panel" catchtouchmove="stopTouchMove">
      <view class="city-header">
        <text class="city-title">选择地区</text>
        <text class="city-close" bindtap="onCityPickerCancel" hover-class="ride-pressed" hover-stay-time="80">关闭</text>
      </view>

      <view class="city-search-wrap">
        <input
          class="city-search-input"
          placeholder="搜索城市名称"
          placeholder-class="city-search-placeholder"
          value="{{citySearchKeyword}}"
          bindinput="onCitySearchInput"
          confirm-type="search"
        />
      </view>

      <view class="city-body">
        <scroll-view class="city-country-tabs" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
          <view
            class="city-country {{item.className}}"
            wx:for="{{cityCountryTabs}}"
            wx:key="code"
            data-code="{{item.code}}"
            bindtap="onSelectCityCountry"
            hover-class="ride-pressed"
            hover-stay-time="80"
          >
            {{item.label}}
          </view>
        </scroll-view>

        <scroll-view class="city-group-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
          <view class="city-group" wx:for="{{cityPickerGroups}}" wx:key="title">
            <view class="city-group-title">
              <text wx:if="{{item.badge}}" class="city-hot-badge">{{item.badge}}</text>
              <text>{{item.title}}</text>
            </view>
            <view class="city-grid">
              <view
                class="city-option {{city.className}}"
                wx:for="{{item.cities}}"
                wx:for-item="city"
                wx:key="key"
                data-key="{{city.key}}"
                bindtap="onSelectCity"
                hover-class="ride-pressed"
                hover-stay-time="80"
              >
                {{city.label}}
              </view>
            </view>
          </view>
          <view wx:if="{{!cityPickerHasResults}}" class="city-empty">{{cityPickerEmptyText}}</view>
          <view class="city-picker-hint">{{cityPickerHintText}}</view>
        </scroll-view>
      </view>
    </view>
  </view>
</view>
</block>
