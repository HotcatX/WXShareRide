.page{
  height: 100vh;
  overflow: hidden;
  background: #f7efe9;
  display: flex;
  flex-direction: column;
}

/* 顶部导航栏 */
.header { 
  display:flex; 
  align-items:center; 
  height:80rpx; 
  padding:0 20rpx; 
}
.back-icon {
  width: 50rpx;
  height: 50rpx;
}
.title { 
  flex:1; 
  text-align:center; 
  font-size:40rpx; 
  font-weight:bold; 
}

.nav-bar {
  width: 100%;
  background-color: #EE9C73;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}

/* 内容区 */
.content{
  flex: 1;
  overflow: hidden;
  padding: 18rpx 22rpx 0 22rpx;
  box-sizing: border-box;
}

/* 大图 */
.img-wrap{
  width: 100%;
  height: 520rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(0,0,0,0.08);
  overflow: hidden;
  background:#fff;
}
.main-img{
  width: 100%;
  height: 100%;
}
.main-no-img{
  width: 100%;
  height: 100%;
  padding: 48rpx;
  box-sizing: border-box;
  background: #eef3e5;
  color: #111;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.main-no-img text{
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1.18;
  word-break: break-all;
}

/* 信息卡 */
.info-card{
  margin-top: 18rpx;
  background: #a6ad71;
  border-radius: 12rpx;
  padding: 18rpx 18rpx 20rpx 18rpx;
  box-sizing: border-box;
  color: #fff;
  position: relative;
}
.info-line{
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.45;
}
.post-date{
  position: absolute;
  right: 18rpx;
  bottom: 14rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
  text-align: right;
}
.post-date .date{
  display:block;
  font-weight: 800;
}
.pickup-window{
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 2rpx solid rgba(0,0,0,0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.58);
}
.pickup-date{
  color: #111;
  text-align: right;
}

/* 品牌 + 商品名称 */
.brand-row{
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 6rpx;
  box-sizing: border-box;
}

.brand-badge{
  background: #EE9C73;
  color: #111;
  font-size: 30rpx;
  font-weight: 900;
  padding: 10rpx 18rpx;
  border-radius: 18rpx;
}

.product-title{
  flex: 1;
  font-size: 40rpx;
  font-weight: 900;
  color: #111;
  line-height: 1.2;
}

/* 描述 */
.desc-box{
  margin-top: 18rpx;
  border: 2rpx solid rgba(0,0,0,0.18);
  border-radius: 10rpx;
  min-height: 140rpx;
  padding: 14rpx 14rpx;
  box-sizing: border-box;
}
.desc-title{
  font-size: 28rpx;
  font-weight: 800;
  color: rgba(0,0,0,0.55);
}
.desc-text{
  margin-top: 8rpx;
  font-size: 28rpx;
  color: rgba(0,0,0,0.80);
  line-height: 1.5;
}

/* 两个小按钮 */
.mini-actions{
  margin-top: 18rpx;
  display:flex;
  gap: 16rpx;
}
.mini-btn{
  flex:1;
  height: 86rpx;
  border: 2rpx solid rgba(0,0,0,0.18);
  border-radius: 10rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size: 28rpx;
  font-weight: 800;
  color:#111;
  background:#fff;
  text-align:center;
  padding: 0 10rpx;
  box-sizing: border-box;
}

/* 危险按钮（删除） */
.mini-btn.danger{
  border-color: rgba(229,77,66,0.45);
  color: #E54D42;
}

/* 底部固定按钮空间 */
.bottom-space{
  height: calc(140rpx + env(safe-area-inset-bottom));
}

/* 底部固定 */
.bottom-fixed{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: #fff;
  border-top: 2rpx solid rgba(0,0,0,0.10);
  box-sizing: border-box;
}
.bottom-bar{
  height: 155rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 本人发布：底部编辑/删除 */
.owner-bar{
  width: 98%;
  display: flex;
  gap: 18rpx;
}
.owner-btn{
  flex: 1;
  height: 96rpx;
  border-radius: 999rpx;
  background: #EE9C73;
  color:#fff;
  font-size: 36rpx;
  font-weight: 900;
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow: 3rpx 6rpx 2rpx 0 rgba(0,0,0,0.25);
}
.owner-btn.danger{
  background: #E54D42;
}

/* 非本人：联系购买 */
.contact-btn{
  width: 98%;
  height: 96rpx;
  border-radius: 999rpx;
  background: #EE9C73;
  color:#fff;
  font-size: 36rpx;
  font-weight: 900;
  display:flex;
  align-items:center;
  justify-content:center;
  box-shadow: 3rpx 6rpx 2rpx 0 rgba(0,0,0,0.25);
}

.main-swiper{
  width: 100%;
  height: 100%;
}
