<view class="page">

<!-- 顶部导航栏（自定义） -->
<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content">
    <image class="back-icon" src="/images/back.png" bindtap="goBack" mode="aspectFit" />
    <text class="nav-title">{{pageTitle}}</text>
  </view>
</view>

<view class="container">

  <!-- 宣传照：最上面的头图（改为云端 posterImg） -->
  <view class="hero-card">
    <image
      class="hero-img"
      src="{{posterImg}}"
      mode="widthFix"
      wx:if="{{posterImg}}"
    />
    <view class="hero-img-placeholder" wx:else>
      <text class="placeholder-text">海报加载中…</text>
    </view>
  </view>

  <!-- 图二风格：文字头部 -->
  <view class="header-card">
    <text class="header-top">{{restaurant.headerTop}}</text>

    <view class="header-title-row">
      <text class="header-title-en">{{restaurant.name}}</text>
      <text class="header-title-cn">{{restaurant.titleCN}}</text>
    </view>

    <!-- <text class="header-subtitle">{{restaurant.subtitle}}</text> -->
  </view>

  <!-- 详细信息（带绿色对勾） -->
  <view class="card">
    <view class="card-title">{{restaurant.detailTitle}}</view>

    <view class="detail-list">
      <view class="detail-item">
        <text class="check">✓</text>
        <text class="detail-text">{{restaurant.detailLine1}}</text>
      </view>

      <view class="detail-item">
        <text class="check">✓</text>
        <text class="detail-text">{{restaurant.detailLine2}}</text>
      </view>
    </view>

    <view class="info-row address-row">
      <text class="info-label">地址</text>
      <view class="address-right">
        <text class="info-value address-text">{{restaurant.address}}</text>
        <view class="copy-mini" bindtap="copyAddress">复制</view>
      </view>
    </view>
  </view>

  <!-- 联系方式：点击复制微信号 -->
  <view class="card wechat-card" bindtap="copyWechat">
    <view class="card-title">联系方式</view>

    <view class="wechat-content">
      <text class="wechat-desc">点击复制微信号联系</text>
      <text class="wechat-id">NaomiEyelash</text>
      <view class="wechat-copy">点击复制</view>
    </view>
  </view>

</view>
</view>
