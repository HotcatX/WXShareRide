/* pages/profile/tripActionReason/tripActionReason.wxss */
page{
  background: #f4f6f8;
}

.reason-page{
  min-height: 100vh;
  background: #f4f6f8;
}

.reason-scroll{
  height: calc(100vh - 168rpx);
  box-sizing: border-box;
  padding: 10rpx 12rpx 0;
}

.reason-scroll .ride-card + .ride-card{
  margin-top: 10rpx;
}

.reason-card{
  padding: 18rpx;
  box-sizing: border-box;
}

.reason-title{
  display: block;
  font-size: 32rpx;
  line-height: 42rpx;
  font-weight: 900;
  color: #1f2933;
}

.reason-desc{
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  line-height: 32rpx;
  font-weight: 700;
  color: #69727d;
}

.reason-section-head{
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.reason-list{
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.reason-option{
  min-height: 78rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  background: #f7f9fb;
  border: 2rpx solid #edf1f5;
  box-sizing: border-box;
  display: flex;
  align-items: center;
}

.reason-option--active{
  background: #fff7f5;
  border-color: #e64c3c;
}

.reason-radio{
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 3rpx solid #c8d0d9;
  box-sizing: border-box;
  margin-right: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.reason-option--active .reason-radio{
  border-color: #e64c3c;
}

.reason-radio-dot{
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e64c3c;
}

.reason-option-text{
  flex: 1;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 800;
  color: #26323f;
}

.reason-textarea{
  width: 100%;
  height: 180rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #f7f9fb;
  border: 2rpx solid #edf1f5;
  box-sizing: border-box;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 700;
  color: #26323f;
}

.reason-count{
  margin-top: 8rpx;
  text-align: right;
  font-size: 21rpx;
  line-height: 28rpx;
  font-weight: 700;
  color: #9aa4af;
}

.reason-notice{
  background: #fffaf0;
  border: 2rpx solid #ffe3aa;
}

.reason-notice-title{
  display: block;
  font-size: 25rpx;
  line-height: 32rpx;
  font-weight: 900;
  color: #8a5a00;
}

.reason-notice-text{
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 31rpx;
  font-weight: 700;
  color: #9a6a12;
}

.reason-bottom-space{
  height: 150rpx;
}

.reason-bottom{
  gap: 12rpx;
}

.reason-bottom .ride-btn{
  flex: 1;
}