@import "../../../styles/ride-calendar.wxss";

page{
  background: #f4f6f8;
}

.list-ride{
  background: #f4f6f8;
}

.list-city-entry{
  position: absolute;
  left: 92rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 220rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #111418;
  box-sizing: border-box;
}

.list-city-text{
  max-width: 178rpx;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 31rpx;
  line-height: 40rpx;
  font-weight: 900;
}

.list-city-caret{
  color: #59636f;
  font-size: 28rpx;
  line-height: 30rpx;
  font-weight: 900;
}


.list-ride .ride-top{
  flex: none;
}

.list-filter{
  margin: 0 12rpx 12rpx;
}

.list-place-bar{
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border: 1rpx solid #e6eaee;
  border-radius: 14rpx;
  background: #ffffff;
}

.list-place-field{
  flex: 1;
  min-width: 0;
  padding: 4rpx 0;
}

.list-place-value-row{
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 62rpx;
}

.list-place-value{
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: #66717d;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.list-place-value.is-selected{
  color: #111418;
}

.list-filter-caret{
  flex: none;
  font-size: 23rpx;
  color: #85909a;
}

.list-swap{
  flex: none;
  width: 58rpx;
  height: 64rpx;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  color: #7e969c;
  font-size: 34rpx;
}

.list-date-filters{
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin: 12rpx 0;
}

.list-date-option{
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  min-height: 64rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  color: #606b76;
  font-size: 24rpx;
  line-height: 32rpx;
  white-space: nowrap;
}

.list-date-option.is-active{
  color: #0b7772;
  background: #e1f1ef;
  font-weight: 800;
}

.list-date-picker{
  min-width: 0;
}

.list-type-tabs{
  display: flex;
  gap: 4rpx;
  padding: 5rpx;
  background: #e9edf0;
  border-radius: 15rpx;
}

.list-type-tab{
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 9rpx;
  min-height: 62rpx;
  border-radius: 11rpx;
  color: #6d7782;
  font-size: 24rpx;
  font-weight: 700;
}

.list-type-tab.is-active{
  background: #ffffff;
  color: #0e7772;
  box-shadow: 0 2rpx 8rpx rgba(21,40,51,0.06);
}

.list-type-dot{
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #0f9b95;
}

.list-type-tab--request .list-type-dot{
  background: #d87826;
}

.list-type-tab--request.is-active{
  color: #a94c12;
}

.list-empty-reset{
  margin: 22rpx auto 0;
  padding: 12rpx 26rpx;
  width: fit-content;
  border-radius: 12rpx;
  background: #e1f1ef;
  color: #0b7772;
  font-size: 25rpx;
  font-weight: 700;
}

.list-ride .list-scroll{
  height: 0;
  flex: 1;
  min-height: 0;
  padding: 14rpx 12rpx 0;
}

.list-unavailable-card{
  margin: 22rpx 16rpx 0;
}

.ride-unavailable-card{
  padding: 44rpx 36rpx 42rpx;
  min-height: 360rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  text-align: left;
  box-sizing: border-box;
}

.ride-unavailable-title{
  display: block;
  color: #111418;
  font-size: 36rpx;
  line-height: 46rpx;
  font-weight: 900;
}

.ride-unavailable-desc{
  margin-top: 18rpx;
  display: block;
  color: #69727d;
  font-size: 27rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.ride-unavailable-button{
  margin-top: 34rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #0f9b95;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 900;
  box-shadow: 0 16rpx 34rpx rgba(15,155,149,0.18);
}

.ride-unavailable-button.is-done{
  background: #eef2f5;
  color: #59636f;
  box-shadow: none;
}

.list-scroll .ride-card + .ride-card{
  margin-top: 0;
}

.list-date-row{
  margin: 10rpx 4rpx 5rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.list-date{
  font-size: 25rpx;
  line-height: 31rpx;
  font-weight: 900;
  color: #111418;
}

.list-date-count{
  flex: none;
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-left: 12rpx;
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 800;
  color: #69727d;
}

.list-date-count--carpool{
  color: #0f746f;
}

.list-date-count--request{
  color: #b45316;
}

.list-date-count-separator{
  color: #9ba2aa;
}

.list-trip-card{
  min-height: 114rpx;
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx;
}

.list-full-toggle{
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  color: #111418;
  font-size: 26rpx;
  font-weight: 800;
}

.list-full-toggle-arrow{
  color: #0f746f;
  font-size: 32rpx;
  line-height: 36rpx;
}

.list-full-toggle + .list-load-more{
  margin-top: 28rpx;
}

.list-ride .ride-bottom-space{
  height: calc(180rpx + env(safe-area-inset-bottom));
}

.list-load-more{
  min-height: 76rpx;
  padding: 12rpx 18rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #0f746f;
  font-size: 23rpx;
  line-height: 32rpx;
}

.list-load-more.is-loading,
.list-load-more--complete{
  color: #89939c;
}

.list-load-more.is-error{
  color: #b45316;
}

.list-trip-card .ride-list-head{
  margin-bottom: 10rpx;
  align-items: center;
}

.list-kind-row{
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.list-trip-card .ride-list-kind{
  display: flex;
  align-items: center;
  font-size: 23rpx;
  line-height: 30rpx;
}

.list-kind-row .ride-chip{
  height: 36rpx;
  padding: 0 11rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
  line-height: 34rpx;
  display: flex;
  align-items: center;
}

.list-trip-card .ride-list-time{
  font-size: 23rpx;
  line-height: 30rpx;
  color: #69727d;
}

.list-route-inline{
  min-width: 0;
  position: relative;
}

.list-route-main{
  min-width: 0;
  width: 100%;
  display: grid;
  grid-template-columns: minmax(0,0.92fr) 96rpx minmax(0,1.08fr);
  align-items: center;
  column-gap: 10rpx;
}

.list-route-place{
  min-width: 0;
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  box-sizing: border-box;
}

.list-route-main .list-route-place:first-child{
  justify-content: flex-start;
}

.list-route-main .list-route-place:last-child{
  justify-content: flex-start;
  padding-right: 108rpx;
}

.list-route-label{
  flex: none;
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 900;
  color: #59636f;
}

.list-route-name{
  min-width: 0;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
  color: #111418;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-route-arrow{
  width: 92rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: rgba(15,155,149,0.08);
  color: #0f746f;
  border: 1rpx solid rgba(15,155,149,0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  justify-self: center;
  align-self: center;
  font-size: 31rpx;
  line-height: 34rpx;
  font-weight: 900;
  text-align: center;
  box-sizing: border-box;
}

.list-seat-chip{
  flex: none;
  height: 36rpx;
  padding: 0 11rpx;
  border-radius: 10rpx;
  font-size: 21rpx;
  line-height: 34rpx;
}

.list-seat-chip--available{
  color: #0f746f;
  background: #e3f3f1;
  border-color: #b6ddd9;
}

.list-seat-chip--limited{
  color: #915900;
  background: #fff3d6;
  border-color: #efd196;
}

.list-seat-chip--last{
  color: #b33a2e;
  background: #fff0ec;
  border-color: #f1b9ad;
}

.list-seat-chip--full,
.list-seat-chip--unknown{
  color: #69727d;
  background: #f2f3f5;
  border-color: #dce0e4;
}

.list-route-side{
  position: absolute;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 6rpx;
  max-width: 100rpx;
}

.list-price-chip{
  max-width: 120rpx;
  height: 36rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  background: #111418;
  color: #ffffff;
  border: none;
  font-size: 21rpx;
  line-height: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.toast-bar{
  position: fixed;
  top: calc(44px + constant(safe-area-inset-top) + 32rpx);
  top: calc(44px + env(safe-area-inset-top) + 32rpx);
  left: 50%;
  transform: translateX(-50%);
  max-width: 80%;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(17, 20, 24, 0.88);
  color: #fff;
  display: flex;
  align-items: center;
  z-index: 999;
  font-size: 26rpx;
  line-height: 1.4;
  box-shadow: 0 8rpx 24rpx rgba(20,23,26,0.18);
}

.toast-icon{
  margin-right: 12rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.toast-text{
  flex: 1;
  word-break: break-all;
}

.city-mask{
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(17,20,24,0.38);
}

.city-panel{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10001;
  height: min(76vh, 980rpx);
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  border-top-left-radius: 22rpx;
  border-top-right-radius: 22rpx;
  background: #ffffff;
  box-shadow: 0 -18rpx 40rpx rgba(17,20,24,0.14);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.city-header{
  height: 92rpx;
  padding: 0 26rpx;
  border-bottom: 1rpx solid rgba(20,23,26,0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.city-title{
  color: #111418;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.city-close{
  min-width: 96rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #69727d;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
}

.city-search-wrap{
  padding: 16rpx 24rpx 18rpx;
  border-bottom: 1rpx solid rgba(20,23,26,0.08);
  box-sizing: border-box;
}

.city-search-input{
  width: 100%;
  height: 70rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #f4f6f8;
  color: #111418;
  font-size: 26rpx;
  line-height: 70rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.city-search-placeholder{
  color: #9aa4af;
  font-weight: 700;
}

.city-body{
  min-height: 0;
  flex: 1;
  display: grid;
  grid-template-columns: 168rpx minmax(0, 1fr);
}

.city-country-tabs{
  height: 100%;
  min-height: 0;
  padding: 18rpx 0;
  background: #f4f6f8;
  overflow: hidden;
  box-sizing: border-box;
}

.city-country{
  height: 82rpx;
  padding-left: 24rpx;
  border-left: 8rpx solid transparent;
  color: #59636f;
  display: flex;
  align-items: center;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.city-country.active{
  color: #0f9b95;
  border-left-color: #0f9b95;
  background: #ffffff;
  font-weight: 900;
}

.city-group-scroll{
  height: 100%;
  min-height: 0;
  box-sizing: border-box;
}

.city-group{
  padding: 26rpx 28rpx 4rpx;
}

.city-group-title{
  margin-bottom: 18rpx;
  color: #111418;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.city-hot-badge{
  padding: 0 7rpx;
  border-radius: 8rpx;
  background: #ff6b4a;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 28rpx;
  font-weight: 900;
  font-style: italic;
}

.city-grid{
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.city-option{
  height: 68rpx;
  padding: 0 8rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  color: #3f4751;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 25rpx;
  line-height: 30rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.city-option.active{
  background: #0f9b95;
  color: #ffffff;
  box-shadow: 0 12rpx 28rpx rgba(15,155,149,0.18);
}

.city-empty{
  padding: 72rpx 28rpx 24rpx;
  color: #8b95a1;
  text-align: center;
  font-size: 26rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.city-picker-hint{
  margin: 18rpx 28rpx 28rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f4f8f7;
  color: #66717d;
  font-size: 23rpx;
  line-height: 34rpx;
  font-weight: 700;
}

/* 求车以暖色区分，只作用于本页卡片。 */
.list-trip-card--request .ride-list-kind{
  color: #b45316;
}

.list-trip-card--request .list-seat-chip,
.list-trip-card--request .list-route-arrow{
  color: #a94c12;
  background: #fff2e5;
  border-color: #efc59e;
}

.list-place-mask{
  position: fixed;
  inset: 0;
  z-index: 10000;
  background: rgba(17,24,32,0.36);
}

.list-place-panel{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10001;
  height: 68vh;
  max-height: 1000rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding: 16rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #ffffff;
}

.list-place-panel-handle{
  flex: none;
  width: 62rpx;
  height: 7rpx;
  margin: 0 auto 10rpx;
  border-radius: 8rpx;
  background: #dce1e5;
}

.list-place-panel-header{
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
}

.list-place-panel-title{
  color: #111418;
  font-size: 33rpx;
  font-weight: 800;
}

.list-place-close{
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  margin-right: -14rpx;
  color: #697580;
  font-size: 45rpx;
}

.list-place-search{
  flex: none;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 82rpx;
  margin-bottom: 24rpx;
  padding: 0 22rpx;
  background: #f3f5f7;
  border-radius: 15rpx;
}

.list-place-search-icon{
  color: #7c8993;
  font-size: 40rpx;
}

.list-place-search-input{
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #24313b;
}

.list-place-search-placeholder{
  color: #8a949d;
}

.list-place-options-scroll{
  flex: 1;
  height: 0;
  min-height: 0;
}

.list-place-options{
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.list-place-option{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
  min-height: 86rpx;
  padding: 14rpx 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #e7ebee;
  border-radius: 14rpx;
  color: #3d4b58;
  font-size: 26rpx;
  line-height: 36rpx;
  overflow-wrap: anywhere;
}

.list-place-option.is-selected{
  border-color: #74bdb5;
  background: #edf8f5;
  color: #0b7772;
  font-weight: 700;
}

.list-place-check{
  flex: none;
  color: #0b7772;
}

.list-place-no-results{
  padding: 38rpx 10rpx;
  text-align: center;
  color: #7c8792;
  font-size: 26rpx;
}

.list-refine-entry{
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  min-height: 58rpx;
  margin-left: 8rpx;
  padding-left: 16rpx;
  border-left: 1rpx solid #e5eaed;
  color: #62717c;
  font-size: 23rpx;
}

.list-refine-entry.is-active{
  color: #0b7772;
  font-weight: 700;
}

.list-refine-count{
  display: flex;
  align-items: center;
  justify-content: center;
  width: 27rpx;
  height: 27rpx;
  border-radius: 50%;
  background: #e1f1ef;
  font-size: 18rpx;
}

.list-active-filters{
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 12rpx 12rpx 0;
  color: #0b7772;
  font-size: 22rpx;
  line-height: 28rpx;
}

.list-active-request{
  color: #b45316;
}

.list-active-reset{
  margin-left: auto;
  padding: 0 4rpx;
  color: #89939c;
}

.list-refine-panel{
  height: auto;
}

.list-refine-section-title{
  display: block;
  margin-top: 8rpx;
  color: #64717c;
  font-size: 24rpx;
  line-height: 34rpx;
}

.list-refine-panel .list-date-filters{
  margin: 16rpx 0 30rpx;
  gap: 12rpx;
}

.list-refine-panel .list-date-option{
  min-height: 76rpx;
  padding: 0 24rpx;
  background: #f3f5f7;
}

.list-refine-panel .list-date-option.is-active{
  background: #e1f1ef;
}

.list-refine-panel .list-type-tabs{
  margin-top: 16rpx;
}

.list-refine-panel .list-type-tab{
  min-height: 74rpx;
}

.list-refine-footer{
  display: flex;
  gap: 20rpx;
  margin-top: 42rpx;
}

.list-refine-reset,
.list-refine-done{
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 16rpx;
  font-size: 27rpx;
  font-weight: 700;
}

.list-refine-reset{
  width: 160rpx;
  background: #f2f4f6;
  color: #67737e;
}

.list-refine-done{
  flex: 1;
  background: #0f9b95;
  color: #ffffff;
}
