.app-tabbar-wrap{
  position: fixed;
  left: 0;
  right: 0;
  bottom: -8rpx;
  width: 100%;
  z-index: 9999;
  padding: 8rpx 46rpx calc(8rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  pointer-events: none;
}

.app-tabbar{
  height: 104rpx;
  border-radius: 30rpx;
  background: rgba(255,255,255,0.98);
  border: 1rpx solid rgba(20,23,26,0.08);
  box-shadow: 0 18rpx 44rpx rgba(20,23,26,0.16);
  display: grid;
  grid-template-columns: repeat(3, minmax(0,1fr));
  align-items: center;
  box-sizing: border-box;
  pointer-events: auto;
}

.tab-item{
  height: 88rpx;
  margin: 8rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  color: #69727d;
  box-sizing: border-box;
  transition: background-color 160ms ease, color 160ms ease, transform 160ms ease, opacity 160ms ease;
}

.tab-item.active{
  background: #f4f6f8;
  color: #111418;
}

.market-tab{
  position: relative;
  padding: 0;
  background: transparent;
  border: 1rpx solid rgba(20,23,26,0.06);
  overflow: hidden;
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
}

.market-tab.active{
  background: #f4f6f8;
}

.market-tab-indicator{
  position: absolute;
  left: 0;
  top: 0;
  width: 50%;
  height: 100%;
  border-radius: 22rpx;
  background: #111418;
  z-index: 0;
  opacity: 0;
  transition: transform 180ms ease, background-color 180ms ease, opacity 160ms ease;
}

.market-tab-indicator.visible{
  opacity: 1;
}

.market-tab-indicator.is-sublet{
  background: #111418;
  transform: translateX(100%);
}

.market-tab-half{
  position: relative;
  z-index: 2;
  min-width: 0;
  height: 88rpx;
  color: #69727d;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  box-sizing: border-box;
  transition: color 160ms ease, transform 160ms ease, opacity 160ms ease;
}

.market-tab-half.selected{
  color: #ffffff;
}

.market-tab-icon{
  width: 38rpx;
  height: 38rpx;
  display: block;
  filter: brightness(0) opacity(0.62);
  transition: transform 160ms ease, opacity 160ms ease, filter 160ms ease;
}

.market-tab-half.selected .market-tab-icon{
  transform: translateY(-2rpx);
  filter: brightness(0) invert(1);
}

.market-tab-text{
  font-size: 21rpx;
  line-height: 27rpx;
  font-weight: 900;
}

.tab-pressed{
  opacity: 0.72;
  transform: scale(0.98);
}

.tab-icon-wrap{
  position: relative;
  width: 38rpx;
  height: 38rpx;
}

.tab-icon{
  width: 38rpx;
  height: 38rpx;
  display: block;
  transition: transform 160ms ease, opacity 160ms ease;
}

.tab-item.active .tab-icon{
  transform: translateY(-2rpx);
}

.tab-text{
  font-size: 21rpx;
  line-height: 27rpx;
  font-weight: 900;
}

.tab-badge{
  position: absolute;
  right: -20rpx;
  top: -12rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  border-radius: 999rpx;
  background: #e64c3c;
  color: #fff;
  border: 3rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18rpx;
  line-height: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.market-badge{
  right: -10rpx;
  top: -10rpx;
}
