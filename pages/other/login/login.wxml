<timeline-preview wx:if="{{isTimelinePreview}}" id="timeline-preview" context="{{timelineContext}}" />
<block wx:elif="{{timelinePageReady}}">
<view class="login-container ride-page">
  <view class="login-shell ride-shell">
    <view class="login-card ride-card ride-card-pad">
      <view class="login-head">
        <view class="login-chip ride-chip ride-chip--accent">FL-NYC 出行</view>
        <view class="login-title">欢迎使用</view>
        <view class="login-subtitle">浏览公开行程无需登录</view>
      </view>

      <view class="login-actions">
        <button
          class="login-button ride-btn ride-primary ride-btn--primary {{logging ? 'ride-btn--disabled' : ''}} {{!privacyAgreed ? 'login-button--privacy-disabled' : ''}}"
          bindtap="onLoginTap"
          loading="{{logging}}"
          disabled="{{logging}}"
          hover-class="ride-pressed"
        >
          {{logging ? '登录中' : '微信快速登录'}}
        </button>

        <button
          class="login-button login-guest-button ride-btn ride-secondary"
          bindtap="onGuestTap"
          hover-class="ride-pressed"
        >
          暂不登录，先浏览
        </button>
      </view>

      <!-- <view class="login-meta">
        <view class="login-mini-chip ride-chip">微信同步</view>
        <view class="login-mini-chip ride-chip">游客浏览</view>
      </view> -->

      <view class="privacy-footer">
        <view class="privacy-row">
          <view
            class="privacy-checkbox {{privacyAgreed ? 'privacy-checkbox--checked' : ''}}"
            bindtap="togglePrivacyAgreement"
          >
            <text wx:if="{{privacyAgreed}}" class="privacy-checkmark">✓</text>
          </view>

          <view class="privacy-agreement-text">
            <text
              class="privacy-text"
              bindtap="togglePrivacyAgreement"
            >我已阅读并同意</text>

            <text
              class="privacy-link"
              catchtap="goPrivacy"
            >《隐私政策》</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
</block>
