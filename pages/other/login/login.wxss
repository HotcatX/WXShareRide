.login-container {
  min-height: 100vh;
  background: #f4f6f8;
  box-sizing: border-box;
}

.login-shell {
  min-height: 100vh;
  padding: 120rpx 40rpx calc(52rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;

  display: flex;
  flex-direction: column;
}

.login-card {
  flex: 1;
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 0;

  background: transparent;
  border-radius: 0;
  box-shadow: none;
  border: none;

  display: flex;
  flex-direction: column;
}

.login-head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  gap: 22rpx;
}

.login-chip {
  height: 64rpx;
  padding: 0 26rpx;

  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;

  border-radius: 32rpx;
}

.login-title {
  margin-top: 26rpx;
  color: #111418;
  font-size: 62rpx;
  line-height: 74rpx;
  font-weight: 900;
}

.login-subtitle {
  color: #69727d;
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 700;
}

.login-actions {
  margin-top: 260rpx;

  display: flex;
  flex-direction: column;
  gap: 72rpx;
}

.login-button {
  width: 100%;
  height: 180rpx;
  margin: 0;
  font-size: 36rpx;
  font-weight: 700;
  border-radius: 60rpx;

  transition: opacity 0.2s ease;
}

/* 未勾选隐私政策：看起来不可用，但实际仍能点击 */
.login-button--privacy-disabled {
  opacity: 0.45;
}

.login-button[disabled] {
  opacity: 0.45;
}

.login-button[disabled]::after {
  border: none;
}

.privacy-footer {
  margin-top: auto;
  padding-top: 48rpx;

  width: 100%;
  box-sizing: border-box;

  display: flex;
  justify-content: center;
  align-items: center;
}

/* 整个协议区域强制横向 */
.privacy-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;

  flex-wrap: nowrap;
  white-space: nowrap;

  width: auto;
}

/* 左侧勾选框 */
.privacy-checkbox {
  width: 30rpx;
  height: 30rpx;

  flex: 0 0 30rpx;

  margin-right: 10rpx;

  border: 2rpx solid #b7b7b7;
  border-radius: 6rpx;
  box-sizing: border-box;

  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-checkbox--checked {
  background: #2f80ed;
  border-color: #2f80ed;
}

.privacy-checkmark {
  display: block;

  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 26rpx;

  text-align: center;
}

/* “我已阅读并同意 + 隐私政策”作为一个整体 */
.privacy-agreement-text {
  display: flex;
  flex-direction: row;
  align-items: center;

  flex-wrap: nowrap;
  white-space: nowrap;

  height: 34rpx;
  line-height: 34rpx;

  font-size: 24rpx;
  font-weight: 700;
}

.privacy-text {
  color: #8a8a8a;

  font-size: 24rpx;
  line-height: 34rpx;

  white-space: nowrap;
}

.privacy-link {
  margin-left: 4rpx;

  color: #2f80ed;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 900;

  white-space: nowrap;
}