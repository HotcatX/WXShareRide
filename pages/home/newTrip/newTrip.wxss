page{
  background: #f4f6f8;
}

.create-ride{
  background: #f4f6f8;
}

.create-scroll{
  padding-top: 10rpx;
}

.create-card-head{
  margin-bottom: 10rpx;
}

.create-card-head .ride-section-subtitle{
  display: block;
  margin-top: 2rpx;
}

.create-route-card{
  margin-top: 0;
}

.create-ride .ride-card-pad{
  padding: 16rpx;
}

.create-ride .ride-form-grid{
  gap: 8rpx;
}

/* 基础输入框容器 */
.create-ride .ride-field{
  min-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}

/* 横向输入项：左标题 + 右内容 */
.create-ride .ride-field-inline{
  height: 64rpx;
  padding: 0 18rpx;

  display: flex;
  flex-direction: row;
  align-items: center;
}

/* 左侧标题 */
.create-ride .ride-field-label{
  flex: 0 0 96rpx;
  margin: 0;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 800;
  color: #111418;
}

/* 右侧 picker 显示值 */
.create-ride .ride-field-inline-value{
  flex: 1;
  min-width: 0;

  display: flex;
  align-items: center;
  justify-content: flex-end;

  height: 100%;
  min-height: 64rpx;

  margin: 0;
  padding: 0;

  font-size: 20rpx;
  line-height: 1;

  color: #111418;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 右侧 input */
.create-ride .ride-input-inline{
  flex: 1;
  min-width: 0;
  height: 32rpx;
  min-height: 32rpx;
  margin: 0;
  padding: 0;
  text-align: right;
  font-size: 18rpx;
  line-height: 28rpx;
  color: #111418;
}

/* 普通 input 兜底 */
.create-ride .ride-input{
  margin-top: 0;
  height: 32rpx;
  min-height: 32rpx;
  font-size: 22rpx;
  line-height: 32rpx;
}

/* picker 占满宽度 */
.create-ride picker{
  display: block;
  width: 100%;
}

/* picker 内部字段占满 */
.create-ride picker .ride-field-inline{
  width: 100%;
  box-sizing: border-box;
}

/* placeholder 灰色 */
.create-ride .ride-placeholder{
  color: #9aa3ad !important;
  font-weight: 500;
}

/* input placeholder 灰色 */
.create-ride .ride-input-inline::placeholder,
.create-ride .ride-input::placeholder{
  color: #9aa3ad;
}

/* 微信小程序 placeholder-class */
.create-ride input.ride-placeholder,
.create-ride .ride-input.ride-placeholder{
  color: #9aa3ad !important;
}

/* 备注区域 */
.create-ride .create-textarea-field{
  min-height: 112rpx;
  padding: 14rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: flex-start;
}

/* 备注标题：与其他标题一致 */
.create-ride .create-textarea-field .ride-field-label{
  flex: none;
  margin: 0;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 800;
  color: #111418;
}

/* 备注输入框 */
.create-ride .ride-textarea{
  width: 100%;
  margin-top: 8rpx;
  padding: 0;
  font-size: 24rpx;
  line-height: 34rpx;
  color: #111418;
  box-sizing: border-box;
}

/* Zelle */
.create-zelle{
  margin-top: 16rpx;
}

.create-check{
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.create-check-text{
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 800;
  color: #111418;
}

/* 常用模板 */
.create-template-head{
  margin: 26rpx 4rpx 12rpx;
}

.create-inline-state{
  margin: 0;
}

.create-template-list{
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.create-template-card{
  padding: 18rpx 20rpx;
}

.create-template-time{
  min-width: 0;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
  color: #111418;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.create-template-route{
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: minmax(0,1fr) 36rpx minmax(0,1fr);
  align-items: center;
  gap: 10rpx;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 800;
  color: #59636f;
}

.create-template-route text{
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.create-template-arrow{
  text-align: center;
  color: #111418;
  font-weight: 900;
}

.create-notice-muted{
  margin-top: 14rpx;
  background: #ffffff;
  border-color: rgba(20,23,26,0.06);
}