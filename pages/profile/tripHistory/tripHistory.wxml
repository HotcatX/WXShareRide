<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content">
    <image class="back-icon" src="/images/back.png" bindtap="goBack" />
    <text class="nav-title">{{pageTitle}}</text>
  </view>
</view>

<view class="container">
  <!-- 顶部标题：改成历史行程 -->
  <!-- <view class="page-title">历史行程</view> -->

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="state-text">
    正在加载历史行程...
  </view>

  <!-- 无数据 -->
  <view wx:elif="{{!historyTrips || historyTrips.length === 0}}" class="state-text">
    暂无历史行程
  </view>

  <!-- 有数据时的列表 -->
  <block wx:else>
    <!-- 一条历史出行 -->
    <block
      wx:for="{{historyTrips}}"
      wx:for-item="trip"
      wx:for-index="index"
      wx:key="tripId"
    >
    <!-- 行程卡片 -->
    <view class="trip-card">
      <!-- 第一行：出发地 -> 目的地 -->
      <view class="trip-main-row">
        <text class="place-text-left">{{trip._fromAddress}}</text>
        <text class="arrow-text">➡️</text>
        <text class="place-text-right">{{trip._toAddress}}</text>
      </view>

      <!-- 第二行：时间 + 角色 -->
      <view class="trip-sub-row">
        <text class="time-text">{{trip._timeLabel}}</text>
        <text class="seat-text">{{trip._roleLabel}}</text>
      </view>
    </view>

    </block>
  </block>
</view>
