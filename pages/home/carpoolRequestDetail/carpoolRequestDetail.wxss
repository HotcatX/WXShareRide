/* ✅ 只让这两个提示框突破父容器左右 padding（默认按 22rpx 计算） */
.ui-scroll{
  flex: 1;
  min-height: 0;
  padding: 22rpx 22rpx 0 22rpx;
  box-sizing: border-box;
}
