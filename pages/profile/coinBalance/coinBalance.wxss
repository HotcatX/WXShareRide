.page{
  min-height: 100vh;
  background:#fff;
}

/* nav */
.nav-bar{ background:#fff; border-bottom: 2rpx solid rgba(0,0,0,0.10); }
.nav-content{
  height: 44px;
  display:flex;
  align-items:center;
  padding: 0 22rpx;
}
.nav-left{
  width: 90rpx;
  font-size: 44rpx;
  font-weight: 900;
  color:#111;
}
.nav-title{
  flex:1;
  text-align:center;
  font-size: 34rpx;
  font-weight: 900;
  color:#111;
}
.nav-right{ width: 90rpx; }

.content{
  padding: 26rpx 28rpx;
  box-sizing: border-box;
}

.block{
  margin-bottom: 34rpx;
}

.h{
  font-size: 30rpx;
  font-weight: 900;
  color: #e24b3a;   /* red headline like your sketch */
  margin-bottom: 10rpx;
}

.p{
  font-size: 26rpx;
  font-weight: 700;
  color: rgba(0,0,0,0.55);
  line-height: 1.75;
}
.nav-left{
  width: 80rpx;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.nav-back{
  width: 42rpx;
  height: 42rpx;
}
