<timeline-preview wx:if="{{isTimelinePreview}}" id="timeline-preview" context="{{timelineContext}}" />
<block wx:elif="{{timelinePageReady}}">
<view class="ride-shell edit-info">
  <view class="ride-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar ride-topbar--center">
      <view
        class="ride-back ride-back-text"
        bindtap="goBack"
        hover-class="ride-pressed"
        hover-stay-time="80"
      >
        <text>‹</text>
      </view>
      <text class="ride-nav-title">{{pageTitle}}</text>
    </view>
  </view>

  <scroll-view class="ride-scroll edit-scroll" scroll-y enhanced="true" show-scrollbar="{{false}}">
    <view class="ride-card ride-card-pad edit-profile-card">
      <button
        class="avatar-btn"
        open-type="chooseAvatar"
        bindchooseavatar="onChooseAvatar"
        hover-class="ride-card-pressed"
        hover-stay-time="80"
      >
        <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
        <text class="ride-chip avatar-chip">更换头像</text>
      </button>

      <view class="profile-name-field ride-field">
        <text class="ride-field-label">昵称</text>
        <input
          class="ride-input edit-input"
          placeholder="请输入昵称"
          placeholder-class="ride-placeholder"
          value="{{name}}"
          data-field="name"
          bindinput="onInput"
        />
      </view>
    </view>

    <view class="section-head">
      <text class="ride-section-title">基础信息</text>
      <text class="ride-section-subtitle">联系方式与定位</text>
    </view>

    <view class="ride-card ride-card-pad edit-form-card">
      <view class="ride-field edit-field">
        <text class="ride-field-label edit-field-label">*微信号</text>
        <input
          class="ride-input edit-input"
          placeholder="必填，方便添加好友"
          placeholder-class="ride-placeholder"
          value="{{wechat}}"
          data-field="wechat"
          bindinput="onInput"
        />
      </view>

      <view
        class="ride-field edit-field edit-field-action"
        bindtap="onTapRegionPicker"
        hover-class="ride-card-pressed"
        hover-stay-time="80"
      >
        <text class="ride-field-label edit-field-label">城市/区域</text>
        <view class="edit-value-action">
          <view wx:if="{{regionStateLabel || regionGroupLabel || regionAreaLabel}}" class="edit-region-lines">
            <text class="ride-field-value edit-value-text">{{regionStateLabel || '-'}}</text>
            <text class="ride-field-value edit-value-text">/{{regionGroupLabel || '-'}}</text>
            <text class="ride-field-value edit-value-text">/{{regionAreaLabel || '-'}}</text>
          </view>
          <text wx:else class="ride-field-value edit-value-text ride-placeholder">选择地区和城市</text>
          <text class="edit-chevron">›</text>
        </view>
      </view>

      <view class="ride-field edit-field edit-address-field">
        <text class="ride-field-label edit-field-label">公寓名称</text>
        <view class="edit-address-control">
          <input
            class="ride-input edit-input"
            placeholder="选填，例如 1440,The Modern等"
            placeholder-class="ride-placeholder"
            value="{{buildingName}}"
            data-field="buildingName"
            bindinput="onInput"
          />
        </view>
      </view>

      <view
        class="ride-field edit-field edit-field-action"
        bindtap="onChooseLocation"
        hover-class="ride-card-pressed"
        hover-stay-time="80"
      >
        <text class="ride-field-label edit-field-label">精确定位</text>
        <view class="edit-value-action">
          <text wx:if="{{locationPicking}}" class="ride-field-value edit-value-text ride-placeholder">打开中</text>
          <text wx:elif="{{locationDisplay}}" class="ride-field-value edit-value-text">{{locationDisplay}}</text>
          <text wx:else class="ride-field-value edit-value-text ride-placeholder">用于计算距离</text>
          <text class="edit-chevron">›</text>
        </view>
      </view>

      <picker
        mode="selector"
        range="{{regions}}"
        value="{{regionIndex}}"
        bindchange="onRegionChange"
        class="edit-picker"
      >
        <view class="ride-field edit-field edit-field-action">
          <text class="ride-field-label edit-field-label">手机号地区</text>
          <view class="edit-value-action">
            <text class="ride-field-value edit-value-text">{{regions[regionIndex]}}</text>
            <text class="edit-chevron">›</text>
          </view>
        </view>
      </picker>

      <view class="ride-field edit-field">
        <text class="ride-field-label edit-field-label">手机号</text>
        <input
          class="ride-input edit-input"
          placeholder="选填"
          placeholder-class="ride-placeholder"
          value="{{phone}}"
          data-field="phone"
          bindinput="onInput"
          type="number"
        />
      </view>
    </view>

    <view class="section-head">
      <text class="ride-section-title">司机信息</text>
      <text class="ride-section-subtitle">收款与车辆</text>
    </view>

    <view class="ride-card ride-card-pad edit-form-card driver-form-card">
      <view class="ride-field edit-field">
        <text class="ride-field-label edit-field-label">Zelle 姓名</text>
        <input
          class="ride-input edit-input"
          placeholder="用于收款核实"
          placeholder-class="ride-placeholder"
          value="{{zelleName}}"
          data-field="zelleName"
          bindinput="onInput"
        />
      </view>

      <view class="ride-field edit-field">
        <text class="ride-field-label edit-field-label">Zelle 账号</text>
        <input
          class="ride-input edit-input"
          placeholder="邮箱或手机号"
          placeholder-class="ride-placeholder"
          value="{{zelleAccount}}"
          data-field="zelleAccount"
          bindinput="onInput"
        />
      </view>

      <view class="ride-field edit-field">
        <text class="ride-field-label edit-field-label">车牌号</text>
        <input
          class="ride-input edit-input"
          placeholder="例如 NJ ABC123"
          placeholder-class="ride-placeholder"
          value="{{carNumber}}"
          data-field="carNumber"
          bindinput="onInput"
        />
      </view>

      <view class="ride-field edit-field">
        <text class="ride-field-label edit-field-label">车辆品牌</text>
        <input
          class="ride-input edit-input"
          placeholder="例如 Toyota"
          placeholder-class="ride-placeholder"
          value="{{carBrand}}"
          data-field="carBrand"
          bindinput="onInput"
        />
      </view>

      <view class="ride-field edit-field">
        <text class="ride-field-label edit-field-label">车辆型号</text>
        <input
          class="ride-input edit-input"
          placeholder="例如 Camry"
          placeholder-class="ride-placeholder"
          value="{{carModel}}"
          data-field="carModel"
          bindinput="onInput"
        />
      </view>

      <view class="driver-zelle-setting">
        <view class="driver-setting-copy">
          <text class="driver-setting-title">向加入的乘客公开 Zelle</text>
          <text class="driver-setting-note">仅用于之后发布的路线</text>
        </view>
        <switch class="driver-zelle-switch" checked="{{defaultShowZelle}}" color="#0f9b95" bindchange="onDefaultShowZelleChange" />
      </view>
    </view>

    <view class="edit-bottom-space"></view>
  </scroll-view>

  <!-- 第一层：选择州 / 大地区 -->
  <view wx:if="{{cityPickerVisible}}">
    <view class="rp-mask" bindtap="onCityPickerCancel"></view>
    <view class="city-panel" catchtouchmove="stopTouchMove">
      <view class="city-header">
        <text class="city-title">选择地区</text>
        <text class="city-close pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onCityPickerCancel">关闭</text>
      </view>

      <view class="city-search-wrap">
        <input
          class="city-search-input"
          placeholder="搜索地区名称"
          placeholder-class="city-search-placeholder"
          value="{{citySearchKeyword}}"
          bindinput="onCitySearchInput"
          confirm-type="search"
        />
      </view>

      <scroll-view class="city-group-scroll city-group-scroll--single" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="city-group" wx:for="{{cityPickerGroups}}" wx:key="title">
          <view class="city-group-title">
            <text wx:if="{{item.badge}}" class="city-hot-badge">{{item.badge}}</text>
            <text>{{item.title}}</text>
          </view>

          <view class="city-grid">
            <view
              class="city-option {{city.className}} pressable"
              wx:for="{{item.cities}}"
              wx:for-item="city"
              wx:key="key"
              data-key="{{city.key}}"
              hover-class="is-pressed"
              hover-stay-time="80"
              bindtap="onSelectCity"
            >
              {{city.label}}
            </view>
          </view>
        </view>

        <view wx:if="{{!cityPickerHasResults}}" class="city-empty">{{cityPickerEmptyText}}</view>
      </scroll-view>
    </view>
  </view>

  <!-- 第二层 + 第三层：左边小区域，右边细分区域 -->
  <view wx:if="{{areaPickerVisible}}">
    <view class="rp-mask" bindtap="onAreaPickerCancel"></view>
    <view class="city-panel area-panel" catchtouchmove="stopTouchMove">
      <view class="city-header">
        <text class="city-title">{{areaPickerTitle}}</text>
        <text class="city-close pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onAreaPickerCancel">关闭</text>
      </view>

      <view class="area-two-col">
        <scroll-view class="area-left-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
          <view
            class="area-left-option {{item.className}} pressable"
            wx:for="{{areaGroupOptions}}"
            wx:key="key"
            data-key="{{item.key}}"
            hover-class="is-pressed"
            hover-stay-time="80"
            bindtap="onSelectProfileAreaGroup"
          >
            {{item.label}}
          </view>
        </scroll-view>

        <scroll-view class="area-right-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
          <view class="city-grid area-grid">
            <view
              class="city-option area-option {{item.className}} pressable"
              wx:for="{{areaOptions}}"
              wx:key="key"
              data-key="{{item.key}}"
              hover-class="is-pressed"
              hover-stay-time="80"
              bindtap="onSelectProfileArea"
            >
              {{item.label}}
            </view>
          </view>

          <view wx:if="{{!areaOptions.length}}" class="city-empty">请选择左侧区域</view>

        </scroll-view>
      </view>
    </view>
  </view>

  <view class="edit-save-footer">
    <button
      class="ride-btn ride-btn--primary {{savingProfile ? 'ride-btn--disabled' : ''}}"
      bindtap="onSaveProfile"
      disabled="{{savingProfile}}"
      loading="{{savingProfile}}"
    >
      {{ savingProfile ? '保存中' : '保存' }}
    </button>
  </view>

</view>
</block>
