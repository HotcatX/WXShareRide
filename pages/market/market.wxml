<view class="market-page">
  <view class="market-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="topbar">
      <view class="brand">
        <text class="brand-kicker">{{brandKicker}}</text>
        <view class="brand-title-row">
          <text class="brand-title">{{brandTitle}}</text>
          <view class="market-segment">
            <view
              class="market-segment-item {{item.className}} pressable"
              wx:for="{{listingTypeTabs}}"
              wx:key="type"
              data-type="{{item.type}}"
              hover-class="is-pressed"
              hover-stay-time="80"
              bindtap="onSelectListingType"
            >
              {{item.label}}
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="search-card">
      <view class="search-box">
        <text class="search-symbol">⌕</text>
        <input
          class="search-input"
          value="{{keyword}}"
          placeholder="{{searchPlaceholder}}"
          placeholder-class="search-placeholder"
          bindinput="onKeywordInput"
          confirm-type="search"
          bindconfirm="onSearch"
        />
        <view
          wx:if="{{keyword}}"
          class="clear-keyword pressable"
          hover-class="is-pressed"
          hover-stay-time="80"
          bindtap="onClearKeyword"
        >
          ×
        </view>
        <view class="search-submit pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onSearch">
          搜索
        </view>
      </view>

      <view class="control-row">
        <view class="control-chip pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onTapRegion">
          <text class="control-label">区域</text>
          <text class="control-value">{{activeRegionLabel}}</text>
        </view>
        <view class="control-chip pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onTogglePriceSort">
          <text class="control-label">{{priceControlLabel}}</text>
          <text class="control-value">{{priceSortLabel}}</text>
        </view>
        <view class="control-chip {{distanceSortClass}} pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onToggleDistanceSort">
          <text class="control-label">{{distanceControlLabel}}</text>
          <text class="control-value">{{distanceSortLabel}}</text>
        </view>
      </view>
    </view>

    <scroll-view class="category-scroll" scroll-x show-scrollbar="{{false}}">
      <view class="category-track">
        <view
          class="category-pill {{item.className}} pressable"
          wx:for="{{categoryTabs}}"
          wx:key="label"
          data-cat="{{item.label}}"
          hover-class="is-pressed"
          hover-stay-time="80"
          bindtap="onSelectCat"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>
  </view>

  <scroll-view class="goods-scroll" scroll-y lower-threshold="140" bindscroll="onGoodsScroll" bindscrolltolower="onGoodsScrollToLower">
    <view class="result-row">
      <text class="result-title">{{resultTitle}}</text>
      <text class="result-count">{{resultCountText}}</text>
    </view>

    <view class="goods-grid" wx:if="{{hasDisplayGoods}}">
      <view
        class="goods-card pressable"
        wx:for="{{displayFeed}}"
        wx:key="_feedKey"
        wx:for-index="index"
        data-id="{{item.id}}"
        data-index="{{index}}"
        hover-class="card-pressed"
        hover-stay-time="80"
        bindtap="onTapFeedItem"
      >
        <view class="photo-wrap">
          <image
            wx:if="{{item.hasImage}}"
            class="goods-photo"
            lazy-load="true"
            src="{{item.imageSrc}}"
            mode="aspectFill"
          />
          <view wx:else class="goods-photo no-photo">
            <text>{{item.title}}</text>
          </view>
          <view class="corner-stack">
            <text wx:if="{{item.isAd}}" class="condition-badge ad-badge">{{item.badgeText}}</text>
            <block wx:else>
              <text class="price-badge">$ {{item.priceText}}</text>
              <text class="condition-badge">{{item.conditionText}}</text>
            </block>
          </view>
        </view>

        <view class="goods-body">
          <view class="goods-title-row">
            <text class="goods-title">{{item.title}}</text>
            <text wx:if="{{item.isAd}}" class="distance ad-cta">{{item.ctaText}}</text>
            <text wx:elif="{{item.distanceText}}" class="distance">{{item.distanceText}}</text>
          </view>
        </view>
        <button
          wx:if="{{item.isAd && item.targetType === 'contact'}}"
          class="ad-contact-trigger"
          open-type="contact"
          session-from="{{item.contactSessionFrom}}"
          send-message-title="{{item.contactMessageTitle}}"
          send-message-path="{{item.contactMessagePath}}"
          send-message-img="{{item.contactMessageImg}}"
          show-message-card="{{item.showMessageCard}}"
          data-index="{{index}}"
          catchtap="onTapAdContact"
        ></button>
      </view>
    </view>

    <view class="skeleton-grid" wx:if="{{showSkeleton}}">
      <view class="skeleton-card" wx:for="{{skeletonItems}}" wx:key="*this">
        <view class="skeleton-img"></view>
        <view class="skeleton-line wide"></view>
        <view class="skeleton-line short"></view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{showEmpty}}">
      <view class="empty-mark">⌕</view>
      <view class="empty-title">{{emptyTitle}}</view>
      <view class="empty-subtitle">{{emptySubtitle}}</view>
      <view class="empty-action pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onResetMarketFilters">
        重置筛选
      </view>
    </view>

    <view class="loading-more" wx:if="{{showLoadingMore}}">
      正在加载更多...
    </view>

    <view
      class="view-more pressable"
      wx:if="{{showViewMore}}"
      hover-class="is-pressed"
      hover-stay-time="80"
      bindtap="onViewMore"
    >
      查看更多
    </view>

    <view class="bottom-spacer"></view>
  </scroll-view>

  <view class="market-float-actions {{publishFabVisibleClass}}">
    <view class="float-action primary pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onSellIdle">发布</view>
  </view>

  <view wx:if="{{regionPickerVisible}}">
    <view class="rp-mask" bindtap="onRegionPickerCancel"></view>

    <view class="rp-panel" catchtouchmove="stopTouchMove">
      <view class="rp-header">
        <text class="rp-btn pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onRegionPickerCancel">取消</text>
        <text class="rp-title">选择地区</text>
        <text class="rp-btn ok pressable" hover-class="is-pressed" hover-stay-time="80" bindtap="onRegionPickerConfirm">确定</text>
      </view>

      <picker-view
        class="rp-picker"
        indicator-style="height: 44px;"
        value="{{regionPickerValue}}"
        bindchange="onRegionPickerChange"
      >
        <picker-view-column>
          <view class="rp-item" wx:for="{{regionCol1}}" wx:key="*this">{{item}}</view>
        </picker-view-column>

        <picker-view-column>
          <view class="rp-item" wx:for="{{regionCol2}}" wx:key="*this">{{item}}</view>
        </picker-view-column>

        <picker-view-column>
          <view class="rp-item" wx:for="{{regionCol3}}" wx:key="*this">{{item}}</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>

  <app-tabbar active="market" market-type="{{activeListingType}}" bindmarketchange="onMarketTabTypeChange"></app-tabbar>
</view>
