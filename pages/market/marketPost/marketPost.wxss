.market-post-page{
  height: 100vh;
  overflow: hidden;
  background: #f4f6f8;
  color: #111418;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.post-top{
  background: #f4f6f8;
  border-bottom: 1rpx solid rgba(20,23,26,0.06);
  z-index: 2;
}

.post-nav{
  min-height: 86rpx;
  padding: 10rpx 22rpx;
  display: grid;
  grid-template-columns: 64rpx 1fr 64rpx;
  align-items: center;
  box-sizing: border-box;
}

.nav-back{
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #111418;
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  line-height: 48rpx;
  font-weight: 700;
}

.nav-copy{
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
}

.nav-kicker{
  color: #0f9b95;
  font-size: 19rpx;
  line-height: 24rpx;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

.nav-title{
  color: #111418;
  font-size: 34rpx;
  line-height: 40rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.post-scroll{
  flex: 1;
  min-height: 0;
}

.post-content{
  min-height: 100%;
  padding: 14rpx 20rpx 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.inline-loading{
  margin-bottom: 10rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #ffffff;
  color: #69727d;
  font-size: 25rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.06);
}

.section-card{
  margin-bottom: 14rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #ffffff;
  border: 1rpx solid rgba(20,23,26,0.05);
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.06);
  box-sizing: border-box;
}

.section-head{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.section-head.compact{
  margin-bottom: 10rpx;
}

.section-head view{
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.section-kicker{
  display: none;
  font-size: 18rpx;
  line-height: 22rpx;
  color: #0f9b95;
  font-weight: 800;
  letter-spacing: 0;
  text-transform: uppercase;
}

.section-title{
  font-size: 30rpx;
  line-height: 38rpx;
  color: #111418;
  font-weight: 900;
}

.section-note{
  height: 38rpx;
  padding: 0 14rpx;
  border-radius: 12rpx;
  background: #f4f6f8;
  color: #69727d;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
}

.media-section{
  display: grid;
  grid-template-columns: 220rpx minmax(0, 1fr);
  gap: 14rpx;
  align-items: start;
}

.media-section .section-head{
  grid-column: 1 / -1;
  margin-bottom: 0;
}

.image-uploader{
  grid-column: 1;
  grid-row: 2 / span 2;
  width: 220rpx;
  height: 220rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f4f6f8;
  position: relative;
  border: 1rpx solid rgba(20,23,26,0.06);
}

.preview-img{
  width: 100%;
  height: 100%;
  display: block;
}

.image-placeholder{
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5rpx;
  color: #69727d;
  text-align: center;
}

.image-plus{
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: #ffffff;
  color: #0f9b95;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  line-height: 50rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 20rpx rgba(20,23,26,0.07);
}

.image-title{
  margin-top: 6rpx;
  color: #111418;
  font-size: 25rpx;
  line-height: 32rpx;
  font-weight: 900;
}

.image-subtitle{
  display: none;
  color: #8a949f;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 700;
}

.image-upload-mask{
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 2;
  background: rgba(17,20,24,0.46);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.upload-progress-card{
  min-width: 132rpx;
  min-height: 96rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(17,20,24,0.82);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-sizing: border-box;
}

.upload-progress-percent{
  color: #ffffff;
  font-size: 30rpx;
  line-height: 36rpx;
  font-weight: 900;
}

.upload-progress-text{
  color: rgba(255,255,255,0.86);
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.title-input{
  grid-column: 2;
  grid-row: 2;
  margin-top: 0;
  height: 92rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  padding: 0 16rpx;
  box-sizing: border-box;
  color: #111418;
  font-size: 30rpx;
  font-weight: 900;
}

.desc-input{
  grid-column: 2;
  grid-row: 3;
  width: 100%;
  height: 114rpx;
  min-height: 114rpx;
  max-height: 114rpx;
  margin-top: 0;
  border-radius: 14rpx;
  background: #f4f6f8;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  color: #30363d;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.input-placeholder,
.price-placeholder{
  color: #9aa3ad;
  font-weight: 700;
}

.form-list{
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  border-radius: 0;
  overflow: visible;
  background: transparent;
}

.form-list picker{
  min-width: 0;
  display: block;
}

.form-list picker .form-row{
  height: 100%;
}

.form-row{
  min-height: 94rpx;
  padding: 12rpx 14rpx;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 3rpx;
  border: 1rpx solid rgba(20,23,26,0.06);
  border-radius: 14rpx;
  background: #f8fafb;
  box-sizing: border-box;
}

.form-list .form-row:last-child{
  border: 1rpx solid rgba(20,23,26,0.06);
}

.row-label{
  flex: none;
  color: #69727d;
  font-size: 23rpx;
  line-height: 29rpx;
  font-weight: 900;
}

.row-value{
  min-width: 0;
  width: 100%;
  flex: none;
  color: #30363d;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  font-size: 26rpx;
  line-height: 33rpx;
  font-weight: 800;
  text-align: right;
}

.row-value text:first-child{
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.row-arrow{
  flex: none;
  color: #9aa3ad;
  font-size: 34rpx;
  line-height: 34rpx;
}

.price-control{
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 6rpx;
  flex: none;
}

.currency{
  color: #f05d4f;
  font-size: 28rpx;
  font-weight: 900;
}

.price-input{
  width: 142rpx;
  height: 40rpx;
  color: #f05d4f;
  font-size: 30rpx;
  font-weight: 900;
  text-align: left;
}

.small-number-input{
  width: 100%;
  height: 40rpx;
  color: #30363d;
  font-size: 27rpx;
  font-weight: 900;
  text-align: left;
}

.toggle-value{
  gap: 8rpx;
}

.mini-toggle{
  flex: none;
  width: 64rpx;
  height: 38rpx;
  padding: 4rpx;
  border-radius: 999rpx;
  background: #dce2e7;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  transition-property: background-color;
  transition-duration: 160ms;
}

.mini-toggle.on{
  background: #111418;
}

.mini-toggle-knob{
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 10rpx rgba(20,23,26,0.16);
  transition-property: transform;
  transition-duration: 160ms;
}

.mini-toggle.on .mini-toggle-knob{
  transform: translateX(26rpx);
}

.location-row{
  grid-column: 1 / -1;
  min-height: 102rpx;
  align-items: stretch;
  padding: 14rpx 16rpx;
  gap: 6rpx;
}

.location-value text:first-child{
  white-space: nowrap;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.location-row .row-label{
  font-size: 24rpx;
  line-height: 30rpx;
}

.location-row .row-value{
  font-size: 28rpx;
  line-height: 35rpx;
}

.muted{
  color: #9aa3ad;
}

.bottom-space{
  height: calc(18rpx + env(safe-area-inset-bottom));
}

.submit-dock{
  margin-top: auto;
  padding-top: 14rpx;
  padding: 0;
  background: transparent;
  border-top: 0;
  box-sizing: border-box;
  z-index: 1;
  transition-property: opacity, transform;
  transition-duration: 120ms;
}

.dock-hidden{
  opacity: 0;
  transform: translateY(18rpx);
  pointer-events: none;
}

.submit-btn{
  height: 96rpx;
  border-radius: 18rpx;
  background: #111418;
  color: #ffffff;
  box-shadow: 0 18rpx 36rpx rgba(17,20,24,0.26);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.submit-btn.disabled{
  opacity: 0.56;
}

.pressable{
  transition-property: transform, opacity, background-color, box-shadow;
  transition-duration: 120ms;
}

.is-pressed,
.row-pressed{
  opacity: 0.82;
  transform: scale(0.98);
}

.submit-pressed{
  opacity: 0.88;
  transform: scale(0.985);
  box-shadow: 0 10rpx 24rpx rgba(17,20,24,0.22);
}
