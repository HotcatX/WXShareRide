<view class="login-container">

<view class="title-area">
  <view class="title">FL-NYC出行</view>
  <view class="subtitle">欢迎使用共享出行服务</view>
</view>

<view class="btn-area">

  <button
    class="login-btn"
    bindtap="onLoginTap"
    loading="{{logging}}"
    disabled="{{logging}}"
  >
    微信快速登录
  </button>

  <button
    class="guest-btn"
    bindtap="onGuestTap"
    disabled="{{logging}}"
  >
    游客身份查看
  </button>

</view>

<view class="privacy-footer">
  <text>登录或继续浏览前，请阅读</text>
  <text class="privacy-link" bindtap="goPrivacy">《隐私政策》</text>
</view>

</view>
