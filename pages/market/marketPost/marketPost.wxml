<view class="page">

<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content">
    <image class="back-icon" src="/images/back.png" bindtap="onBack" />
    <text class="nav-title">{{isEdit ? '编辑商品' : '发布闲置'}}</text>
    <view class="nav-right"></view>
  </view>
</view>

<scroll-view
  class="content-scroll"
  scroll-y="{{true}}"
  enhanced="{{true}}"
  show-scrollbar="{{false}}"
>
<view class="content">
<view wx:if="{{editLoading}}" class="inline-loading">正在加载商品...</view>

<view class="card">
  <view class="top-block">
    <view class="img-uploader" bindtap="onChooseImage">
      <image wx:if="{{image}}" class="img" src="{{image}}" mode="aspectFill" />
      <view wx:else class="img-placeholder">
        <text class="ph1">+ 添加图片</text>
        <text class="ph2">可选，文字也能发布</text>
      </view>
      <view wx:if="{{imageUploading}}" class="image-upload-mask" catchtap="noop">
        <view class="upload-progress-ring" style="background: conic-gradient(#ffffff {{imageUploadProgressDeg}}deg, rgba(255,255,255,0.22) 0deg);">
          <view class="upload-progress-core">{{imageUploadProgress}}%</view>
        </view>
        <text class="upload-progress-text">{{imageUploadText}}</text>
      </view>
    </view>

    <input
      class="title-input"
      value="{{title}}"
      placeholder="商品名称（必填）"
      placeholder-class="title-ph"
      bindinput="onTitleInput"
    />

    <textarea
      class="desc"
      value="{{desc}}"
      placeholder="描述一下商品品牌、货品来源……"
      placeholder-class="desc-ph"
      auto-height
      maxlength="500"
      bindinput="onDescInput"
    />
  </view>

  <view class="quick-wrap">
    <view class="quick-title">添加常用描述语</view>
    <view class="chips">
      <view
        class="chip"
        wx:for="{{quickPhrases}}"
        wx:key="*this"
        data-text="{{item}}"
        bindtap="onTapPhrase"
      >
        {{item}}
      </view>
    </view>
  </view>
</view>

<view class="card">
  <view class="form">
    <picker
      mode="selector"
      range="{{categoryOptions}}"
      value="{{categoryIndex}}"
      bindchange="onCategoryPickerChange"
    >
      <view class="row">
        <view class="label">类型</view>
        <view class="right">
          <text class="value">{{category || "—"}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </picker>

    <view class="row price-row">
      <view class="label">价格</view>
      <view class="right">
        <text class="yuan">$</text>
        <input
          class="price-input"
          value="{{price}}"
          placeholder="0.00"
          placeholder-class="price-ph"
          keyboard-type="number"
          bindinput="onPriceInput"
        />
        <text class="arrow">›</text>
      </view>
    </view>

    <view class="row" bindtap="onChooseCondition">
      <view class="label">新旧程度</view>
      <view class="right">
        <text class="value">{{condition}}</text>
        <text class="arrow">›</text>
      </view>
    </view>

    <picker
      mode="date"
      start="{{pickupStartMin}}"
      end="{{pickupStartMax}}"
      value="{{pickupStartDate}}"
      bindchange="onPickupStartDateChange"
    >
      <view class="row">
        <view class="label">可取开始</view>
        <view class="right">
          <text class="value">{{pickupStartDate}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </picker>

    <picker
      mode="date"
      start="{{pickupEndMin}}"
      end="{{pickupEndMax}}"
      value="{{pickupEndDate}}"
      bindchange="onPickupEndDateChange"
    >
      <view class="row">
        <view class="label">可取结束</view>
        <view class="right">
          <text class="value">{{pickupEndDate}}</text>
          <text class="arrow">›</text>
        </view>
      </view>
    </picker>

    <view class="row location-row no-border" bindtap="onTapProfileLocation">
      <view class="label">所在位置</view>
      <view class="right location-right">
        <text class="location-value {{locationInput ? '' : 'is-placeholder'}}">{{locationInput || '请到个人资料填写地址'}}</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>
</view>

<view class="bottom-space"></view>
</view>
</scroll-view>

<view class="bottom-fixed">
  <view class="bottom-bar">
    <view
      class="submit {{submitting ? 'submit--disabled' : ''}}"
      bindtap="onSubmit"
      hover-class="{{submitting ? '' : 'submit--hover'}}"
    >
      {{submitting ? (isEdit ? '保存中…' : '发布中…') : (isEdit ? '保存修改' : '发布')}}
    </view>
  </view>
</view>

<canvas canvas-id="mainCompressCanvas" style="position:fixed;left:-9999px;top:-9999px;width:1280px;height:1280px;"></canvas>
<canvas canvas-id="thumbCanvas" style="position:fixed;left:-9999px;top:-9999px;width:300px;height:300px;"></canvas>

</view>
