<!-- 顶部自定义导航（保留结构；颜色可按你需求再统一） -->
<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content">
    <image class="back-icon" src="/images/back.png" bindtap="goBack" />
    <text class="nav-title">{{pageTitle}}</text>
  </view>
</view>

<!-- 中间内容可滚动：改为 scroll-view，匹配二手交易页面 -->
<view class="ui-page">
  <!-- <scroll-view class="ui-scroll" scroll-y> -->

    <!-- 顶部：出发地/目的地 + 日期时间 + 载客数（套同款卡片） -->
    <view class="ui-card">
      <!-- 第一行：出发地 / 目的地 -->
      <view class="route-row">
        <view class="route-item">
          <picker
            mode="selector"
            range="{{departureAddresses}}"
            data-type="departure"
            bindchange="onAddressSelect"
            disabled="{{loadingDepartureAddrs}}"
          >
            <view class="route-line">
              <text class="route-line-text {{ departureAddress ? 'route-filled' : 'route-placeholder' }}">
                {{ loadingDepartureAddrs ? '出发地加载中…' : (departureAddress || '选择出发地') }}
              </text>
            </view>
          </picker>
        </view>

        <view class="route-arrow">
          <text class="route-arrow-icon">➔</text>
        </view>

        <view class="route-item">
          <picker
            mode="selector"
            range="{{arrivalAddresses}}"
            data-type="destination"
            bindchange="onAddressSelect"
            disabled="{{loadingArrivalAddrs}}"
          >
            <view class="route-line">
              <text class="route-line-text {{ destinationAddress ? 'route-filled' : 'route-placeholder' }}">
                {{ loadingArrivalAddrs ? '目的地加载中…' : (destinationAddress || '选择到达') }}
              </text>
            </view>
          </picker>
        </view>
      </view>

      <!-- 第二行：日期 / 时间 -->
      <view class="datetime-row">
        <view class="route-item">
          <picker mode="date" bindchange="onDateChange">
            <view class="route-line">
              <text class="route-line-text {{ departureDate ? 'route-filled' : 'route-placeholder' }}">
                {{ departureDate || '选择日期' }}
              </text>
            </view>
          </picker>
        </view>

        <view class="route-arrow route-arrow-empty"></view>

        <view class="route-item">
          <picker mode="time" bindchange="onTimeChange">
            <view class="route-line">
              <text class="route-line-text {{ departureTime ? 'route-filled' : 'route-placeholder' }}">
                {{ departureTime || '选择时间' }}
              </text>
            </view>
          </picker>
        </view>
      </view>

      <!-- 第三行：载客数量 -->
      <view class="passenger-inline-row">
        <text class="passenger-label">载客数量</text>
          <input
            class="passenger-input"
            type="number"
            value="{{passengerCountInput}}"
            bindinput="onPassengerInput"
          />
      </view>
    </view>

    <!-- 中间：参考价格 + 车辆信息 + 备注（同款卡片） -->
    <view class="ui-card">

      <view class="field-row">
        <text class="field-label">参考价格</text>
        <input
          class="field-input"
          value="{{referencePrice}}"
          bindinput="onReferencePriceInput"
          placeholder="例如: 10🔪 / 11-13$ / 价格私议"
        />
      </view>

      <view class="field-row">
        <text class="field-label">车牌号</text>
        <input
          class="field-input"
          value="{{carNumber}}"
          bindinput="onCarNumberInput"
          placeholder="请输入车牌号"
        />
      </view>

      <view class="field-row">
        <text class="field-label">车辆品牌</text>
        <input
          class="field-input"
          value="{{carBrand}}"
          bindinput="onCarBrandInput"
          placeholder="例如：Toyota / Honda"
        />
      </view>

      <view class="field-row">
        <text class="field-label">车辆型号</text>
        <input
          class="field-input"
          value="{{carModel}}"
          bindinput="onCarModelInput"
          placeholder="例如：RAV4 / Civic"
        />
      </view>

      <view class="field-row field-textarea">
        <text class="field-label">备注</text>
        <textarea
          class="comment-textarea"
          value="{{comment}}"
          bindinput="onCommentInput"
          placeholder="选填（例如: 可等5分钟 / 可送到门口）"
          auto-height="true"
          maxlength="100"
        />
      </view>

    </view>

    <!-- 是否公开 Zelle 信息：放在卡片外也可以，但建议也套卡片/或轻量行 -->
    <view class="ui-card zelle-card">
      <checkbox-group bindchange="onZelleCheckboxChange">
        <label class="zelle-label">
          <checkbox value="showZelle" checked="{{showZelle}}" />
          <text class="zelle-text">公开 Zelle 信息给拼车成功的乘客</text>
        </label>
      </checkbox-group>
    </view>

  <!-- </scroll-view> -->

<!-- ✅ 常用模板（标题不包卡片） -->
<view class="tpl-title-row">
  <text class="tpl-title">常用模板</text>
</view>

<!-- 模板加载/空态 -->
<view wx:if="{{loadingTemplates}}" class="state-text tpl-state">模板加载中…</view>

<view wx:elif="{{templates.length === 0}}" class="state-text tpl-state">
  暂无模板（可在“个人中心-出行模板”中创建）
</view>

<!-- ✅ 模板卡片列表：一行展示 -->
<view wx:else class="tpl-list">
  <view
    class="trip-card tpl-card"
    wx:for="{{templates}}"
    wx:key="_id"
    bindtap="onTemplateTap"
    data-id="{{item._id}}"
  >
    <view class="tpl-one-row">
      <text class="tpl-week">{{item.weekdayText}}</text>
      <text class="tpl-time">{{item.departureTime}}</text>
      <text class="tpl-from">{{item.departureAddress}}</text>
      <text class="tpl-arrow">➔</text>
      <text class="tpl-to">{{item.destinationAddress}}</text>
    </view>
  </view>
</view>

<!-- 给底部固定按钮留空 -->
<view class="ui-bottom-space"></view>

  <!-- 底部固定：同款白色底框 + 同款按钮 -->
  <view class="ui-bottom-fixed">
    <view class="ui-bottom-bar">
      <view
        class="ui-primary-btn {{submitting ? 'ui-primary-btn--disabled' : ''}}"
        bindtap="confirmTrip"
      >
        {{ submitting ? '提交中…' : '新建出行计划' }}
      </view>
    </view>
  </view>
</view>
