{$COLLECTOR_DOMAIN:collect.linkx.ink} {
    @health {
        method GET
        path /healthz
    }
    @batch {
        method POST
        path /v1/batches /v1/place-suggestions /v1/followups/query
    }
    @analyticsBridge {
        method POST
        # TEMPORARY COMPATIBILITY: the final path serves older cloud bridges.
        path /internal/v1/analytics/accounts /internal/v1/places/business-events /internal/v1/research/participation
    }
    @publicStats {
        method GET
        path /v1/public-stats
    }
    @statsSync {
        method POST
        path /internal/v1/public-stats/sync
    }
    @business {
        path /api/v1/* /internal/v1/auth/cloudbase /internal/v1/compat/cloudbase
    }
    @images {
        method POST
        path /api/v1/files/images /api/v1/admin/files/images
    }
    @standardBody {
        not {
            method POST
            path /api/v1/files/images /api/v1/admin/files/images
        }
    }
    request_body @standardBody {
        max_size 131072
    }
    request_body @images {
        max_size 2097152
    }
    # PostgreSQL is the business authority after the completed writer handoff.
    handle @business {
        reverse_proxy linkx-business:3100
    }
    handle @health {
        reverse_proxy collector:3000
    }
    handle @batch {
        reverse_proxy collector:3000
    }
    handle @analyticsBridge {
        reverse_proxy collector:3000
    }
    handle @publicStats {
        rewrite * /api/v1/statistics/legacy
        reverse_proxy linkx-business:3100
    }
    # The legacy CloudBase snapshot publisher is retired after writer handoff.
    handle @statsSync {
        respond "" 410
    }
    handle {
        respond 404
    }
}
