<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content">
    <text class="nav-title">{{pageTitle}}</text>
  </view>
</view>

<view class="container">

  <!-- 顶部头像：圆形 + 点击选择微信头像 -->
  <view class="avatar-section">
    <button
      class="avatar-wrapper"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar"
    >
      <!-- 这层专门用来画外框 -->
      <view class="avatar-border">
        <image class="avatar" src="{{avatarUrl}}" mode="aspectFill"/>
      </view>
    </button>
    <text class="avatar-tip">点击可更换头像</text>
  </view>

  <!-- 白色信息卡片 -->
  <view class="form-card">

    <!-- 昵称：type="nickname" 使用微信默认昵称 -->
    <view class="form-item">
      <text class="label">昵称</text>
      <view class="field-column">
        <input
          class="input"
          type="nickname"
          placeholder="选填"
          data-field="name"
          bindinput="onInput"
          value="{{name}}"
        />
      </view>
    </view>

    <!-- 微信号 + 住址（选填） -->
    <view class="form-item">
      <text class="label">微信号</text>
      <view class="field-column">
        <!-- 只保留一次微信号输入 -->
        <input
          class="input"
          placeholder="请输入微信号"
          data-field="wechat"
          bindinput="onInput"
          value="{{wechat}}"
        />        
      </view>
    </view>

    <!-- 填写住址（选填） -->
    <!-- <view class="form-item">
      <text class="label">公寓地址</text>
      <view class="field-column">
        <input
          class="input"
          placeholder="选填，用于二手交易"
          data-field="address"
          bindinput="onInput"
          value="{{address}}"
        />
      </view>
    </view> -->

    <!-- 手机号（地区 + 手机号 同一行） -->
    <view class="form-item">
      <text class="label">手机号</text>
      <view class="field-row">
        <picker
          class="picker"
          mode="selector"
          range="{{regions}}"
          value="{{regionIndex}}"
          bindchange="onRegionChange"
        >
          <view class="picker-inner">
            {{ regions[regionIndex] }}
          </view>
        </picker>
        <input
          class="input"
          placeholder="选填，建议填美国号码"
          data-field="phone"
          bindinput="onInput"
          value="{{phone}}"
        />
      </view>
    </view>

    <!-- Zelle 名字 -->
    <view class="form-item">
      <text class="label">Zelle名字</text>
      <view class="field-column">
        <input
          class="input"
          placeholder="选填，用于收款姓名"
          data-field="zelleName"
          bindinput="onInput"
          value="{{zelleName}}"
        />
      </view>
    </view>

    <!-- Zelle 账号 -->
    <view class="form-item">
      <text class="label">Zelle账号</text>
      <view class="field-column">
        <input
          class="input"
          placeholder="选填，邮箱或手机号"
          data-field="zelleAccount"
          bindinput="onInput"
          value="{{zelleAccount}}"
        />
      </view>
    </view>

  </view>

  <!-- 底部按钮 -->
  <view class="buttons">
    <button class="btn main-btn" type="primary" bindtap="onComplete">
      完成信息
    </button>
  </view>
</view>
