<view class="page">

<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content">
    <image class="back-icon" src="/images/back.png" bindtap="goBack" />
    <text class="nav-title">{{pageTitle}}</text>
  </view>
</view>

<view class="ui-page">

  <view wx:if="{{loading}}" class="state-text">正在加载...</view>

  <view wx:elif="{{loadError}}" class="state-card">
    <text class="state-title">{{loadError}}</text>
    <button class="state-action-btn" bindtap="goBack">返回</button>
  </view>

  <scroll-view
  wx:else
  class="ui-scroll"
  scroll-y
  enhanced="true"
  show-scrollbar="false"
>


    <view class="ui-card ui-trip-top-card">

      <view class="route-row">
        <text class="route-text-left">{{fromText || '出发地未设置'}}</text>
        <text class="route-arrow">→</text>
        <text class="route-text-right">{{toText || '目的地未设置'}}</text>
      </view>

      <view class="time-seat-row">
        <view class="time-text">
          <text>{{dateText}} {{weekdayText}} {{timeText}}</text>
        </view>

        <view wx:if="{{sourceType === 'carpool'}}" class="seat-text">
          <text>余位 {{trip.availSeatNum || 0}}</text>
        </view>

        <view wx:else class="seat-text">
          <text>已加入 {{trip.passengerCount || 0}} 人</text>
        </view>
      </view>


      <view wx:if="{{trip.referencePrice || sourceType === 'carpool'}}" class="price-row">
        <text class="price-text-combined">
          出行价格：{{trip.referencePrice || '价格以司机最终确认为准'}}
        </text>
      </view>
    </view>

    <view class="ui-card ui-card-left-green">
      <text class="card-title">司机信息</text>

      <view wx:if="{{driverInfo}}">

        <view class="dprofile">
          <image class="dprofile-avatar" src="{{driverInfo.avatarUrl || defaultAvatarUrl}}" />
          <text class="dprofile-name">{{driverInfo.name || '未设置昵称'}}</text>
        </view>

        <view wx:if="{{driverInfo.carNumber}}" class="pgrid">
          <text class="pgrid-label">车牌：</text>
          <text class="pgrid-value">{{driverInfo.carNumber}}</text>
          <view class="pgrid-btn-placeholder"></view>
        </view>

        <view class="pgrid">
          <text class="pgrid-label">微信：</text>
          <text class="pgrid-value">{{driverInfo.wechatID || '未填写'}}</text>

          <view
            wx:if="{{driverInfo.wechatID}}"
            class="copy-pill"
            data-text="{{driverInfo.wechatID}}"
            bindtap="onCopyText"
          >
            复制
          </view>
          <view wx:else class="pgrid-btn-placeholder"></view>
        </view>

        <view class="pgrid">
          <text class="pgrid-label">手机：</text>
          <text class="pgrid-value">{{driverInfo.phone || '未填写'}}</text>

          <view
            wx:if="{{driverInfo.phone}}"
            class="copy-pill"
            data-text="{{driverInfo.phone}}"
            bindtap="onCopyText"
          >
            复制
          </view>
          <view wx:else class="pgrid-btn-placeholder"></view>
        </view>

        <view wx:if="{{driverInfo.zelleName}}" class="pgrid">
          <text class="pgrid-label">Zelle：</text>
          <text class="pgrid-value">{{driverInfo.zelleName}}</text>
          <view class="pgrid-btn-placeholder"></view>
        </view>

        <view wx:if="{{driverInfo.zelleAccount}}" class="pgrid">
          <text class="pgrid-label">账号：</text>
          <text class="pgrid-value">{{driverInfo.zelleAccount}}</text>

          <view
            class="copy-pill"
            data-text="{{driverInfo.zelleAccount}}"
            bindtap="onCopyText"
          >
            复制
          </view>
        </view>

      </view>

      <view wx:else class="empty-text">
        暂未获取到司机信息
      </view>
    </view>

    <view wx:if="{{sourceType === 'request'}}" class="ui-card ui-card-accent">
      <text class="card-title">已加入乘客</text>

      <view wx:if="{{!passengerList || passengerList.length === 0}}" class="empty-tip">
        暂无其他乘客加入
      </view>

      <block wx:else>
        <block wx:for="{{passengerList}}" wx:key="_openid" wx:for-item="p">
          <view class="passenger-item">

            <view class="passenger-left">
              <image class="passenger-avatar" src="{{p.avatarUrl || defaultAvatarUrl}}" />
              <text class="passenger-name">{{p.name || p.nickName || '未设置昵称'}}</text>
            </view>

            <view class="passenger-right">

              <view class="pgrid pgrid--addr">
                <text class="pgrid-label">地址：</text>
                <text class="pgrid-value pgrid-value--addr">{{p.address || '未填写'}}</text>
                <view class="pgrid-btn-placeholder"></view>
              </view>

              <view class="pgrid">
                <text class="pgrid-label">微信：</text>
                <text class="pgrid-value">{{p.wechatID || '未填写'}}</text>

                <view
                  wx:if="{{p.wechatID}}"
                  class="copy-pill"
                  data-text="{{p.wechatID}}"
                  bindtap="onCopyText"
                >
                  复制
                </view>
                <view wx:else class="pgrid-btn-placeholder"></view>
              </view>

              <view class="pgrid">
                <text class="pgrid-label">手机：</text>
                <text class="pgrid-value">{{p.phone || '未填写'}}</text>

                <view
                  wx:if="{{p.phone}}"
                  class="copy-pill"
                  data-text="{{p.phone}}"
                  bindtap="onCopyText"
                >
                  复制
                </view>
                <view wx:else class="pgrid-btn-placeholder"></view>
              </view>

            </view>
          </view>
        </block>

      </block>
    </view>

    <view wx:if="{{showFortLeeCoreTip}}" class="ui-card ui-notice">
      <text class="notice-title">提示</text>
      <text class="notice-text">
        Fort Lee 核心区域仅包含 Fiat House、Modern、2050 和 Hudson Lights 四个公寓。
      </text>
    </view>

    <view class="ui-bottom-space"></view>
  </scroll-view>

  <view wx:if="{{!loading && !loadError}}" class="ui-bottom-fixed">
    <view class="ui-bottom-bar">
      <button class="ui-submit-btn ui-primary-btn" bindtap="onDeleteOrQuit">
        退出路线
      </button>

    </view>
  </view>

</view>
</view>

