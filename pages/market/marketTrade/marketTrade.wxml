<view class="page">

<view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-content">

    <image
      class="back-icon"
      src="/images/back.png"
      bindtap="onBack"
    />

    <text class="nav-title">我发布的</text>

    <view class="nav-right"></view>
  </view>
</view>

<scroll-view class="content" scroll-y="true">

  <view class="filter-row">
    <text class="filter-all">全部</text>
  </view>

  <view wx:if="{{list.length === 0}}" class="empty">
    暂无记录
  </view>

  <view
    class="row-card"
    wx:for="{{list}}"
    wx:key="id"
    bindtap="onOpenDetail"
    data-id="{{item.id}}"
  >
    <image wx:if="{{item.hasImage}}"
           class="thumb"
           src="{{item.thumbUrl || item.thumbFileID || item.imageFileID || '/images/market.png'}}"
           mode="aspectFill"
           lazy-load="true" />
    <view wx:else class="thumb text-thumb">
      <text>{{item.title}}</text>
    </view>

    <view class="mid">
      <view class="title">{{item.title}}</view>
    </view>

    <view class="right">
      <view class="price">¥{{item.price}}</view>

      <view class="contact-btn"
            catchtap="onCopyWechat"
            data-wx="{{item.contactWechat}}">
        {{type === 'sold' ? '联系买家' : '联系卖家'}}
      </view>
    </view>
  </view>

  <view class="bottom-space"></view>
</scroll-view>

</view>
