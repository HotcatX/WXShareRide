.page {
  min-height: 100vh;
  background-color: #f7f7f7;
  display: flex;
  flex-direction: column;
}

.nav-bar {
  width: 100%;
  background-color: #ffffff;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}

.container {
  padding: 20rpx 32rpx 80rpx;
  box-sizing: border-box;
}

.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.header {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin: 26rpx 0 18rpx;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 55rpx;
  background-color: #eee;
}

.header-mid {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.header-actions {
  display: flex;
  gap: 18rpx;
}

.action {
  width: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.action-icon {
  font-size: 38rpx;
  line-height: 1;
}

.action-text {
  font-size: 22rpx;
  color: #333;
}

.info-card {
  padding: 16rpx 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.info-label {
  font-size: 28rpx;
  color: #444;
}

.info-value {
  font-size: 28rpx;
  color: #222;
  max-width: 60%;
  text-align: right;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.divider {
  height: 1rpx;
  background-color: #f0f0f0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 18rpx;
}

.grid {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.grid-item {
  flex: 1;
  border-radius: 18rpx;
  background-color: #f3f3f3;
  padding: 18rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.grid-icon-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.grid-icon {
  font-size: 44rpx;
  line-height: 1;
}

.grid-text {
  font-size: 26rpx;
  color: #222;
}

.badge-container {
  position: relative;
}

.badge-dot {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background-color: #ff4d4f;
  display: flex;
  align-items: center;
  justify-content: center;
}

.badge-number {
  font-size: 20rpx;
  color: #fff;
  line-height: 1;
}

.action-icon-img{
  width: 40rpx;
  height: 40rpx;
  display: block;
  margin: 0 auto 8rpx;
}

.grid-icon-img{
  width: 44rpx;
  height: 44rpx;
  display: block;
  margin: 0 auto;
}

.privacy-link-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0 8rpx;
}

.privacy-link-text {
  font-size: 24rpx;
  color: #7a7a7a;
  text-decoration: underline;
}
