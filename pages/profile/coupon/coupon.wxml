<view class="page">
  <!-- custom nav -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="onBack">
        <image class="nav-back" src="/images/back.png" mode="aspectFit" />
      </view>
      <text class="nav-title">优惠券</text>
      <view class="nav-right"></view>
    </view>
  </view>

  <!-- tabs -->
  <view class="tabs">
    <view class="tab {{activeTab==='all' ? 'active' : ''}}" bindtap="setTab" data-tab="all">全部</view>
    <view class="tab {{activeTab==='food' ? 'active' : ''}}" bindtap="setTab" data-tab="food">餐厅</view>
    <view class="tab {{activeTab==='fun' ? 'active' : ''}}" bindtap="setTab" data-tab="fun">娱乐</view>
  </view>

  <scroll-view class="content" scroll-y="true">
    <view wx:if="{{displayList.length === 0}}" class="empty">暂无可用优惠券</view>

    <view class="coupon-card" wx:for="{{displayList}}" wx:key="id">
      <view class="left">
        <view class="tags">
          <view class="tag red">{{item.tag1}}</view>
          <view class="tag yellow">{{item.tag2}}</view>
        </view>
        <view class="title">{{item.title}}</view>
        <view class="expire">{{item.expireText}}</view>
      </view>

      <view class="right">
        <view class="discount">{{item.discountText}}</view>
        <view class="note">{{item.note}}</view>
        <view class="use-btn" bindtap="onUse" data-id="{{item.id}}">去使用</view>
      </view>
    </view>

    <view class="bottom-space"></view>
  </scroll-view>
</view>
