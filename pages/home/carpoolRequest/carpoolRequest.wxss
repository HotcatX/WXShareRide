/* pages/home/carpoolRequest/carpoolRequest.wxss */
/* 顶部导航栏 */
.nav-bar {
  width: 100%;
  background-color: #ffffff;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
}

.back-icon {
  width: 50rpx;
  height: 50rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}

.container {
  min-height: 100vh;
  background: #f5f5f5;
}



/* 顶部筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  border-bottom: 1px solid #f5f5f5;
  font-size: 24rpx;
}

.filter-item {
  flex: 1;
}

.filter-spacer {
  width: 24rpx;
}

.filter-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background-color: #f5f5f5;
  text-align: center;
}

/* 重置按钮：加粗 + 阴影（与其他页面一致） */
.filter-reset {
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 800; /* ✅ 加粗 */
  color: #ff0000;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.25); /* ✅ 阴影 */
}


.state-text {
  padding: 40rpx 24rpx;
  color: #666;
  font-size: 28rpx;
  text-align: center;
}

/* 日期小标题 */
.date-header {
  padding: 24rpx 24rpx 8rpx;
}

.date-header-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* 行程卡片 */
.trip-card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
  padding: 20rpx 24rpx;
  margin: 8rpx 20rpx 20rpx;
}

.trip-main-row {
  display: flex;
  align-items: center;
}

.place-text-left,
.place-text-right {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #111;
}

.place-text-left { text-align: left; }
.place-text-right { text-align: right; }

.arrow-text {
  width: 80rpx;
  text-align: center;
  font-size: 32rpx;
  margin: 0;
}

.trip-sub-row {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
}

.trip-sub-row2 {
  margin-top: 8rpx;
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
}

.seat-text {
  color: #ff8c00;
}

.price-text {
  color: #333;
}

.status-text {
  color: #999;
}

/* ========= 横排 Toast ========= */
.toast-bar {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  max-width: 80%;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.85);
  color: #fff;
  display: flex;
  align-items: center;
  z-index: 999;
  font-size: 26rpx;
  line-height: 1.4;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.toast-icon {
  margin-right: 12rpx;
  font-size: 30rpx;
}

.toast-text {
  flex: 1;
  word-break: break-all;
}

/* ========== 底部占位（同款） ========== */
.ui-bottom-space{
  height: calc(140rpx + env(safe-area-inset-bottom));
}

/* ========== 底部固定容器（同款） ========== */
.ui-bottom-fixed{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
}

/* ========== 底部白色框（同款） ========== */
.ui-bottom-bar{
  background: #fff;
  height: 160rpx;
  box-sizing: border-box;
  border-top: 2rpx solid rgba(0,0,0,0.10);
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 底部按钮（同款） ========== */
.ui-primary-btn{
  width: 93%;
  height: 96rpx;
  border-radius: 999rpx;
  background: #9CB06A;
  color: #fff;
  font-size: 36rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 3rpx 6rpx 2rpx 0 rgba(0,0,0,0.25);
}

/* 可选：如果你后续也要 submitting 灰化，提前放着 */
.ui-primary-btn--disabled{
  opacity: 0.55;
}

