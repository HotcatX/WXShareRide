<view class="market-my-page">
  <view class="my-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="my-nav">
      <view
        class="nav-back pressable"
        bindtap="onBack"
        hover-class="is-pressed"
        hover-stay-time="80"
      >‹</view>

      <view class="nav-copy">
        <text class="nav-title">{{navTitle}}</text>
        <text class="nav-subtitle">{{navSubtitle}}</text>
      </view>

      <view class="nav-spacer"></view>
    </view>
  </view>

  <view class="listing-segment-bar">
    <view class="listing-segment">
      <view
        wx:for="{{listingTypeTabs}}"
        wx:key="type"
        class="listing-segment-item {{item.selectedClass}} pressable"
        data-type="{{item.type}}"
        bindtap="onSelectListingType"
        hover-class="is-pressed"
        hover-stay-time="80"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <scroll-view
    class="my-scroll"
    scroll-y="{{true}}"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
    enable-flex="{{true}}"
  >
    <view wx:if="{{goodsEmpty}}" class="empty-state">
      <view class="empty-mark">+</view>
      <text class="empty-title">{{goodsEmptyTitle}}</text>
      <text class="empty-subtitle">{{goodsEmptySubtitle}}</text>
      <view
        class="empty-action pressable"
        bindtap="onAddGood"
        hover-class="is-pressed"
        hover-stay-time="80"
      >
        {{addButtonText}}
      </view>
    </view>

    <view wx:else class="goods-grid">
      <view
        wx:for="{{goods}}"
        wx:key="id"
        class="goods-card pressable"
        data-id="{{item.id}}"
        bindtap="onOpenGood"
        hover-class="card-pressed"
        hover-stay-time="80"
      >
        <view class="photo-wrap">
          <image
            wx:if="{{item.hasImage}}"
            class="thumb"
            src="{{item.imageSrc}}"
            mode="aspectFill"
          />

          <view wx:else class="thumb text-thumb">
            <text>{{item.title}}</text>
          </view>

          <view
            wx:if="{{manageMode}}"
            class="select-box {{item.selectedClass}}"
            data-id="{{item.id}}"
            catchtap="onToggleSelect"
          >
            <text wx:if="{{item.selected}}" class="check">✓</text>
          </view>
        </view>

        <view class="goods-body">
          <text class="goods-title">{{item.title}}</text>
          <text class="goods-price">${{item.priceDisplay}}</text>
          <text class="goods-meta">{{item.metaText}}</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="manage-dock {{dockVisibleClass}}">
    <view wx:if="{{!manageMode}}" class="dock-card dock-card-two">
      <view
        class="dock-btn secondary pressable"
        bindtap="onToggleManage"
        hover-class="dock-pressed"
        hover-stay-time="80"
      >
        {{manageButtonText}}
      </view>

      <view
        class="dock-btn primary pressable"
        bindtap="onAddGood"
        hover-class="dock-pressed"
        hover-stay-time="80"
      >
        {{addButtonText}}
      </view>
    </view>

    <view wx:else class="dock-card manage-actions">
      <view
        class="dock-btn secondary pressable"
        bindtap="onToggleSelectAll"
        hover-class="dock-pressed"
        hover-stay-time="80"
      >
        {{allSelectedText}}
      </view>

      <view
        class="dock-btn danger {{deleteDisabledClass}} pressable"
        bindtap="onDeleteSelected"
        hover-class="dock-pressed"
        hover-stay-time="80"
      >
        删除 {{selectedCount}}
      </view>

      <view
        class="dock-btn primary pressable"
        bindtap="onToggleManage"
        hover-class="dock-pressed"
        hover-stay-time="80"
      >
        完成
      </view>
    </view>
  </view>
</view>