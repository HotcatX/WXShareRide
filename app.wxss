/* 全局基础样式 */
page {
  background-color: #f8f8f8;
}

/* ===== 全局卡片标题规范 ===== */
.card-title{
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.75);
  margin-bottom: 16rpx;
  line-height: 1.2;
}


button {
  font-size: 28rpx;
}

/* ===== Modern ride UI primitives ===== */
.ride-page{
  min-height: 100vh;
  background: #f4f6f8;
  color: #111418;
  box-sizing: border-box;
}

.ride-shell{
  height: 100vh;
  overflow: hidden;
  background: #f4f6f8;
  color: #111418;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.ride-top{
  background: #f4f6f8;
  border-bottom: 1rpx solid rgba(20,23,26,0.06);
  box-shadow: 0 10rpx 30rpx rgba(20,23,26,0.04);
  z-index: 5;
}

.ride-topbar{
  min-height: 96rpx;
  padding: 16rpx 28rpx 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  box-sizing: border-box;
}

.ride-topbar--center{
  position: relative;
  min-height: 88rpx;
  justify-content: center;
}

.ride-brand{
  min-width: 0;
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.ride-kicker{
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 800;
  color: #0f9b95;
  letter-spacing: 0;
  text-transform: uppercase;
}

.ride-title{
  font-size: 42rpx;
  line-height: 50rpx;
  font-weight: 900;
  color: #111418;
  letter-spacing: 0;
}

.ride-nav-title{
  max-width: 520rpx;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 900;
  color: #111418;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ride-back{
  position: absolute;
  left: 20rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ride-back-icon{
  width: 34rpx;
  height: 34rpx;
}

.ride-actions{
  flex: none;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ride-action{
  min-width: 84rpx;
  height: 64rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 22rpx rgba(20,23,26,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.ride-action--dark,
.ride-primary{
  background: #111418;
  color: #ffffff;
}

.ride-action--light,
.ride-secondary{
  background: #ffffff;
  color: #111418;
}

.ride-pressed,
.ride-card-pressed{
  opacity: 0.72;
  transform: scale(0.99);
}

.ride-scroll{
  flex: 1;
  min-height: 0;
  padding: 16rpx 20rpx 0;
  box-sizing: border-box;
}

.ride-content{
  padding: 16rpx 20rpx calc(env(safe-area-inset-bottom) + 140rpx);
  box-sizing: border-box;
}

.ride-card{
  background: #ffffff;
  border-radius: 16rpx;
  border: 1rpx solid rgba(20,23,26,0.05);
  box-shadow: 0 8rpx 24rpx rgba(20,23,26,0.07);
  box-sizing: border-box;
  overflow: hidden;
}

.ride-card-pad{
  padding: 22rpx;
}

.ride-card + .ride-card,
.ride-section + .ride-section{
  margin-top: 16rpx;
}

.ride-section-title{
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
  color: #111418;
}

.ride-section-subtitle{
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 800;
  color: #69727d;
}

.ride-row{
  display: flex;
  align-items: center;
  min-width: 0;
}

.ride-row-between{
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
  min-width: 0;
}

.ride-muted{
  color: #69727d;
}

.ride-chip{
  min-width: 0;
  height: 52rpx;
  padding: 0 16rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  color: #111418;
  border: 1rpx solid rgba(20,23,26,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ride-chip--accent{
  background: rgba(15,155,149,0.12);
  border-color: rgba(15,155,149,0.22);
  color: #0f746f;
}

.ride-chip--dark{
  background: #111418;
  border-color: #111418;
  color: #ffffff;
}

.ride-chip--warn{
  background: rgba(230,76,60,0.10);
  border-color: rgba(230,76,60,0.16);
  color: #cf3d2f;
}

.ride-route{
  display: grid;
  grid-template-columns: 34rpx minmax(0,1fr);
  column-gap: 16rpx;
  min-width: 0;
}

.ride-route-rail{
  width: 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 8rpx;
  box-sizing: border-box;
}

.ride-dot{
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #111418;
  flex: none;
}

.ride-dot--accent{
  background: #0f9b95;
}

.ride-line{
  width: 3rpx;
  height: 54rpx;
  background: #d8dde3;
  margin: 6rpx 0;
  border-radius: 999rpx;
}

.ride-route-body{
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.ride-route-point{
  min-width: 0;
}

.ride-route-label{
  font-size: 21rpx;
  line-height: 28rpx;
  font-weight: 800;
  color: #69727d;
}

.ride-route-name{
  margin-top: 2rpx;
  font-size: 34rpx;
  line-height: 42rpx;
  font-weight: 900;
  color: #111418;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ride-meta{
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.ride-list-card{
  margin-bottom: 14rpx;
  padding: 20rpx;
}

.ride-list-head{
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.ride-list-kind{
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 900;
  color: #0f9b95;
}

.ride-list-time{
  flex: none;
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 900;
  color: #111418;
}

.ride-form-grid{
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 12rpx;
}

.ride-field{
  min-height: 78rpx;
  border-radius: 14rpx;
  background: #f4f6f8;
  border: 1rpx solid rgba(20,23,26,0.06);
  padding: 10rpx 14rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.ride-field--full{
  grid-column: 1 / -1;
}

.ride-field-label{
  font-size: 20rpx;
  line-height: 26rpx;
  font-weight: 800;
  color: #69727d;
}

.ride-field-value,
.ride-input,
.ride-textarea{
  margin-top: 4rpx;
  width: 100%;
  min-width: 0;
  color: #111418;
  font-size: 27rpx;
  line-height: 34rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.ride-placeholder{
  color: #9aa3ad;
  font-weight: 700;
}

.ride-input{
  height: 42rpx;
}

.ride-textarea{
  min-height: 96rpx;
}

.ride-segment{
  margin: 0 20rpx 14rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(20,23,26,0.07);
  display: flex;
  box-sizing: border-box;
}

.ride-segment-item{
  flex: 1;
  height: 62rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 900;
  color: #69727d;
}

.ride-segment-item.active{
  background: #111418;
  color: #ffffff;
}

.ride-bottom-space{
  height: calc(150rpx + env(safe-area-inset-bottom));
}

.ride-bottom-space--double{
  height: calc(260rpx + env(safe-area-inset-bottom));
}

.ride-bottom{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 30;
  background: rgba(255,255,255,0.98);
  border-top: 1rpx solid rgba(20,23,26,0.08);
  box-shadow: 0 -10rpx 30rpx rgba(20,23,26,0.08);
  padding: 18rpx 22rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-sizing: border-box;
}

.ride-bottom--stack{
  flex-direction: column;
}

.ride-btn{
  flex: 1;
  min-width: 0;
  height: 92rpx;
  line-height: 92rpx;
  padding: 0 18rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
  overflow: hidden;
}

.ride-btn::after{
  border: none;
}

.ride-btn--primary{
  background: #111418;
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(20,23,26,0.18);
}

.ride-btn--secondary{
  background: #eef1f4;
  color: #111418;
}

.ride-btn--accent{
  background: #0f9b95;
  color: #ffffff;
}

.ride-btn--danger{
  background: #e64c3c;
  color: #ffffff;
}

.ride-btn--disabled{
  background: #e8ebef !important;
  color: #9aa3ad !important;
  box-shadow: none !important;
}

.ride-state{
  margin: 48rpx 20rpx 0;
  padding: 38rpx 24rpx;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(20,23,26,0.06);
  color: #69727d;
  text-align: center;
  font-size: 27rpx;
  line-height: 36rpx;
  font-weight: 800;
}

.ride-state-title{
  display: block;
  color: #111418;
  font-size: 30rpx;
  line-height: 38rpx;
  font-weight: 900;
}

.ride-state-action{
  margin: 24rpx auto 0;
  width: 220rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 16rpx;
  background: #111418;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
}

.ride-state-action::after{
  border: none;
}

.ride-notice{
  padding: 18rpx 20rpx;
  background: rgba(15,155,149,0.10);
  border: 1rpx solid rgba(15,155,149,0.18);
  box-shadow: none;
}

.ride-notice-title{
  display: block;
  font-size: 26rpx;
  line-height: 34rpx;
  font-weight: 900;
  color: #0f746f;
}

.ride-notice-text{
  margin-top: 6rpx;
  display: block;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 700;
  color: #59636f;
}

.ride-copy{
  flex: none;
  min-width: 76rpx;
  height: 44rpx;
  padding: 0 12rpx;
  border-radius: 12rpx;
  background: #111418;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.ride-avatar{
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #e9edf1;
  flex: none;
}

.ride-person{
  padding: 18rpx 0;
  border-top: 1rpx solid rgba(20,23,26,0.06);
  display: flex;
  gap: 16rpx;
  min-width: 0;
}

.ride-person:first-child{
  border-top: none;
  padding-top: 0;
}

.ride-person-main{
  flex: 1;
  min-width: 0;
}

.ride-person-name{
  font-size: 28rpx;
  line-height: 36rpx;
  font-weight: 900;
  color: #111418;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ride-info-grid{
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.ride-info-row{
  display: grid;
  grid-template-columns: 98rpx minmax(0,1fr) auto;
  align-items: center;
  column-gap: 8rpx;
  min-width: 0;
}

.ride-info-label{
  font-size: 23rpx;
  line-height: 30rpx;
  font-weight: 800;
  color: #69727d;
}

.ride-info-value{
  min-width: 0;
  font-size: 24rpx;
  line-height: 32rpx;
  font-weight: 800;
  color: #111418;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
