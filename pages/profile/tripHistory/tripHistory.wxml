<timeline-preview wx:if="{{isTimelinePreview}}" id="timeline-preview" context="{{timelineContext}}" />
<block wx:elif="{{timelinePageReady}}">
<view class="ride-shell history-ride">
  <view class="ride-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar ride-topbar--center">
      <view
        class="ride-back ride-back-text"
        bindtap="goBack"
        hover-class="ride-pressed"
        hover-stay-time="80"
      >
        <text>‹</text>
      </view>
      <text class="ride-nav-title">{{pageTitle}}</text>
    </view>
  </view>

  <scroll-view class="ride-scroll history-scroll" scroll-y enhanced="true" show-scrollbar="{{false}}" scroll-into-view="{{scrollIntoTrip}}" scroll-with-animation>
    <view wx:if="{{loading}}" class="ride-state">
      正在加载历史行程
    </view>

    <view wx:elif="{{!historyTrips || historyTrips.length === 0}}" class="ride-state">
      暂无历史行程
    </view>

    <block wx:else>
      <view
        class="ride-card ride-list-card history-card"
        wx:for="{{historyTrips}}"
        wx:for-item="trip"
        wx:for-index="index"
        wx:key="_id"
        id="history-trip-{{index}}"
        data-id="{{trip._id}}"
        data-index="{{index}}"
        bindtap="goTripDetail"
        hover-class="ride-card-pressed"
        hover-stay-time="80"
      >
        <view class="history-card-head">
          <view class="history-card-caption">
            <text class="history-kind">历史行程</text>
            <text wx:if="{{trip._feedbackStatus}}" class="history-status history-status--{{trip._feedbackTone}}">{{trip._feedbackStatus}}</text>
          </view>
          <text class="history-role history-role--{{trip._roleKind}}">{{trip._roleLabel}}</text>
        </view>
        <view class="history-route" aria-label="{{trip._fromAddress}} 到 {{trip._toAddress}}">
          <text class="history-route-name">{{trip._fromAddress}}</text>
          <text class="history-route-arrow">→</text>
          <text class="history-route-name">{{trip._toAddress}}</text>
        </view>
        <view class="history-meta">
          <text class="history-time">{{trip._timeLabel || '时间待定'}}</text>
          <text class="ride-publisher-name">{{trip.name || '无用户名'}}</text>
        </view>

        <view wx:if="{{trip._feedbackEligible}}" class="history-feedback">
          <trip-feedback trip="{{trip}}" bind:answer="onHistoryAnswer" bind:rate="onHistoryRate" bind:retry="retryFeedback" />
        </view>
      </view>
    </block>

    <view class="ride-bottom-space"></view>
  </scroll-view>
  <view wx:if="{{feedbackThanks}}" class="history-thanks" style="top: {{statusBarHeight + 52}}px;">谢谢您的反馈</view>

</view>
</block>
