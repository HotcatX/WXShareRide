[Unit]
Description=LinkX research collector (loopback only by default)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/linkx-collector
ExecStart=/usr/bin/docker compose --env-file /etc/linkx-collector/compose.env up -d --no-build collector
ExecStop=/usr/bin/docker compose --env-file /etc/linkx-collector/compose.env stop collector
TimeoutStartSec=120
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
