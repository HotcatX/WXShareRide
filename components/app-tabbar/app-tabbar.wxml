<view class="app-tabbar-wrap">
  <view class="app-tabbar">
    <view
      class="tab-item {{displayActive === 'home' ? 'active' : ''}}"
      data-key="home"
      data-url="/pages/home/home"
      bindtap="onTapTab"
      hover-class="tab-pressed"
      hover-stay-time="80"
    >
      <image class="tab-icon" src="{{displayActive === 'home' ? '/images/home_press.png' : '/images/home.png'}}" mode="aspectFit" />
      <text class="tab-text">主页</text>
    </view>

    <view
      class="tab-item market-tab {{displayActive === 'market' ? 'active' : ''}}"
      catchtap="onToggleMarketType"
      hover-class="tab-pressed"
      hover-stay-time="80"
    >
      <view class="market-tab-indicator {{displayActive === 'market' ? 'visible' : ''}} {{displayMarketType === 'sublet' ? 'is-sublet' : 'is-goods'}}"></view>
      <view class="market-tab-half {{displayActive === 'market' && displayMarketType === 'goods' ? 'selected' : ''}}">
        <image class="market-tab-icon" src="{{displayActive === 'market' && displayMarketType === 'goods' ? '/images/market_press.png' : '/images/market.png'}}" mode="aspectFit" />
        <text class="market-tab-text">二手</text>
      </view>
      <view class="market-tab-half {{displayActive === 'market' && displayMarketType === 'sublet' ? 'selected' : ''}}">
        <image class="market-tab-icon" src="/images/sublease.png" mode="aspectFit" />
        <text class="market-tab-text">转租</text>
      </view>
      <view wx:if="{{marketBadgeText}}" class="tab-badge market-badge">{{marketBadgeText}}</view>
    </view>

    <view
      class="tab-item {{displayActive === 'profile' ? 'active' : ''}}"
      data-key="profile"
      data-url="/pages/profile/profile"
      bindtap="onTapTab"
      hover-class="tab-pressed"
      hover-stay-time="80"
    >
      <view class="tab-icon-wrap">
        <image class="tab-icon" src="{{displayActive === 'profile' ? '/images/profile_press.png' : '/images/profile.png'}}" mode="aspectFit" />
        <view wx:if="{{profileBadgeText}}" class="tab-badge">{{profileBadgeText}}</view>
      </view>
      <text class="tab-text">我的</text>
    </view>
  </view>
</view>
