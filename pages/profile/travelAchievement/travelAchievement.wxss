.page {
  padding: 16px;
}

/* 顶部导航栏 */
.nav-bar {
  width: 100%;
  background-color: #ffffff;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
}

.back-icon {
  width: 50rpx;
  height: 50rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}

/* Cards */
.header-card,
.stats-card {
  background: #fff;
  border-radius: 14px;
  padding: 14px;
  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.06);
  margin-bottom: 14px;
}

.header-card {
  display: flex;
  gap: 12px;
  align-items: flex-start;
}

.avatar-wrap {
  width: 64px;
  height: 64px;
  border-radius: 999px;
  overflow: hidden;
  background: #f3f3f3;
  flex: 0 0 auto;
}
.avatar {
  width: 100%;
  height: 100%;
}

.user-meta {
  flex: 1;
}

.nickname {
  font-size: 18px;
  font-weight: 700;
  line-height: 22px;
}
.sub-title {
  margin-top: 6px;
  display: inline-block;
  font-size: 12px;
  color: #666;
}

.role-row {
  margin-top: 10px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.role-label {
  font-size: 12px;
  color: #666;
}
.role-switch {
  display: inline-flex;
  border: 1px solid #ddd;
  border-radius: 8px;
  overflow: hidden;
}
.role-btn {
  padding: 6px 10px;
  font-size: 12px;
  background: #fff;
  color: #333;
}
.role-btn.active {
  background: #111;
  color: #fff;
}

.stats-title {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 10px;
  display: block;
}

.stats-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.stats-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.k {
  font-size: 13px;
  color: #222;
}
.v {
  font-size: 13px;
  font-weight: 700;
}

.hint {
  margin-top: 12px;
  font-size: 12px;
  color: #888;
}
.hint.error {
  color: #d33;
}
