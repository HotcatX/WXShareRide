.login-container {
  min-height: 100vh;
  background: #f4f6f8;
  box-sizing: border-box;
}

.login-shell {
  min-height: 100vh;
  padding: 120rpx 40rpx calc(52rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;

  display: flex;
  flex-direction: column;
}

.login-card {
  flex: 1;
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 0;

  background: transparent;
  border-radius: 0;
  box-shadow: none;
  border: none;

  display: flex;
  flex-direction: column;
}

.login-head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
  gap: 22rpx;
}

.login-chip {
  height: 64rpx;
  padding: 0 26rpx;

  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;

  border-radius: 32rpx;
}

.login-title {
  margin-top: 26rpx;
  color: #111418;
  font-size: 62rpx;
  line-height: 74rpx;
  font-weight: 900;
}

.login-subtitle {
  color: #69727d;
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 700;
}

.login-actions {
  margin-top: 260rpx;

  display: flex;
  flex-direction: column;
  gap: 72rpx;
}

.login-button {
  width: 100%;
  height: 180rpx;      /* 更高 */
  margin: 0;

  font-size: 36rpx;    /* 字更大 */
  font-weight: 700;

  border-radius: 60rpx;
}

.login-button[disabled] {
  opacity: 1;
}

.login-button[disabled]::after {
  border: none;
}

.privacy-footer {
  margin-top: auto;
  padding-top: 48rpx;

  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8rpx;

  color: #69727d;
  font-size: 24rpx;
  line-height: 34rpx;
  font-weight: 700;
  text-align: center;
}

.privacy-link {
  color: #111418;
  font-weight: 900;
}