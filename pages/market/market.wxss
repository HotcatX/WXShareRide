.page{
  height: 100vh;
  overflow: hidden;
  background: #f7efe9; display: flex;
  flex-direction: column;
}

.nav-bar{
  background: #f2a073; border-bottom: none;
}
.nav-content{
  height: 44px;
  display:flex;
  align-items:center;
  justify-content:center;
  position:relative;
}
.nav-title{
  font-size: 34rpx;
  font-weight: 600;
  color:#111;
}
.nav-left,.nav-right{
  position:absolute;
  top:0;
  height:44px;
  display:flex;
  align-items:center;
  width:90rpx;
}
.nav-left{
  left: 22rpx;
  font-size: 44rpx;
  font-weight: 800;
}
.nav-right{ right:22rpx; }

.search-row{
  padding: 18rpx 22rpx 16rpx 22rpx;
  background: #f7efe9; }
.search-box{
  height: 70rpx;
  border: 3rpx solid #f2a073; border-radius: 999rpx;
  display:flex;
  align-items:center;
  padding: 0 10rpx 0 18rpx;
  box-sizing:border-box;
  background: transparent;   }
.search-input{ flex:1; height:70rpx; font-size:26rpx; }
.ph{ color: rgba(0,0,0,0.35); }
.search-btn{
  height:52rpx;
  padding:0 22rpx;
  border-radius:999rpx;
  background:#f2a073;
  color:#111;
  font-weight:800;
  font-size:26rpx;
  display:flex;
  align-items:center;
  justify-content:center;
}

.filter-row{
  display:flex;
  align-items:center;
  justify-content: space-between;
  padding: 14rpx 22rpx;
  border-bottom: 2rpx solid rgba(0,0,0,0.10);
  background:#f7efe9;
}

.filter-left-group{
  display:flex;
  align-items:center;
  gap: 14rpx;
  min-width: 0;
  flex: 1;
}

.filter-left{
  font-size: 34rpx;
  font-weight: 900;
  color:#111;
}

.filter-arrow{
  font-size: 28rpx;
  color: rgba(0,0,0,0.55);
}

.filter-region{
  display:flex;
  align-items:center;
  gap: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 14rpx;
  background: rgba(0,0,0,0.06);
}

.region-text{
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.70);
}
.region-caret{
  font-size: 26rpx;
  color: rgba(0,0,0,0.35);
}

.my-btn{
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 205, 120, 0.9);
  color:#111;
  font-size: 26rpx;
  font-weight: 900;
}

.main{
  flex:1;
  display:flex;
  min-height:0;
}

.left{
  width: 170rpx;
  border-right: 2rpx solid rgba(0,0,0,0.10);
  min-height:0;
  background: #f3e9e1;
}
.cat-scroll{
  height:100%;
  padding: 10rpx 10rpx 0 10rpx;
  box-sizing:border-box;
}
.cat-item{
  height: 78rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  margin: 0;
  border-bottom: 2rpx solid rgba(0,0,0,0.10);
  font-size: 30rpx;
  font-weight: 800;
  color:#111;
  text-align:center;
}
.cat-item.active{
  color: #f2a073;
}
.cat-item:first-child{
  border-top: 2rpx solid rgba(0,0,0,0.10);
}
.line-placeholder{
  height: 36rpx;
  margin: 14rpx 0;
  border-bottom: 2rpx solid rgba(0,0,0,0.08);
}

.right{
  flex:1;
  min-height:0;
}
.goods-scroll{
  height:100%;
  padding: 16rpx 18rpx 0 18rpx;
  box-sizing:border-box;
  background: #f7efe9;
}

.grid{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.card-img{
  border: 2rpx solid rgba(0,0,0,0.08);
  border-radius: 22rpx;
  overflow: hidden;
  background: #fff;
  display:flex;
  flex-direction: column;
}
.goods-label{
  padding: 12rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #111;
  background: #fbeee7;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-height: 72rpx;
  box-sizing: border-box;
}
.goods-distance{
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(0,0,0,0.48);
}
.thumb{
  width: 100%;
  height: 180rpx;
  background: #f6f6f6;
}
.text-thumb{
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx;
  box-sizing: border-box;
  background: #eef3e5;
  color: #111;
  text-align: center;
}
.text-thumb text{
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
  word-break: break-all;
}

.view-more{
  text-align:center;
  margin: 16rpx 0 10rpx 0;
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(0,0,0,0.35);
}
.caret{ font-size: 26rpx; }

.bottom-spacer{
  height: 200rpx;
}


.bottom-fixed{
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(10rpx); background: transparent;
  border-top: none;
  padding: 0 22rpx;
  box-sizing:border-box;
  z-index: 9999;
}

.sell-btn{
  margin: 0;
  width:100%;
  height: 96rpx;
  border-radius: 999rpx;
  background:#f2a073;
  display:flex;
  align-items:center;
  justify-content:center;
  color:#fff;
  font-size: 34rpx;
  font-weight: 900;
  box-shadow: 3rpx 6rpx 2rpx 0 rgba(0,0,0,0.25);
}

.left{
  width: 170rpx;
  border-right: 2rpx solid rgba(0,0,0,0.10);
  background: #f3e9e1;

  display: flex;           flex-direction: column;  min-height: 0;           }

.cat-scroll{
  flex: 1;                 min-height: 0;
  padding: 10rpx 10rpx 0 10rpx;
  box-sizing:border-box;
}

.right{
  flex:1;
  display:flex;            flex-direction:column;   min-height:0;            }

.goods-scroll{
  flex:1;                  min-height:0;
  padding: 16rpx 18rpx 0 18rpx;
  box-sizing:border-box;
  background: #f7efe9;
}

.rp-mask{
  position: fixed;
  left:0; right:0; top:0; bottom:0;
  background: rgba(0,0,0,0.35);
  z-index: 10000;
}

.rp-panel{
  position: fixed;
  left:0; right:0;
  bottom: 0;
  background: #fff;
  border-top-left-radius: 22rpx;
  border-top-right-radius: 22rpx;
  z-index: 10001;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
}

.rp-header{
  height: 96rpx;
  display:flex;
  align-items:center;
  justify-content: space-between;
  padding: 0 24rpx;
  border-bottom: 2rpx solid rgba(0,0,0,0.06);
}

.rp-title{
  font-size: 30rpx;
  font-weight: 900;
  color:#111;
}

.rp-btn{
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.55);
  padding: 18rpx 8rpx;
}

.rp-btn.ok{
  color:#f2a073;
}

.rp-picker{
  height: 520rpx;
}

.rp-item{
  height: 88rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size: 32rpx;
  font-weight: 800;
  color:#111;
}
.sort-btn{
  display:flex;
  align-items:center;
  margin-left:10rpx;
  padding:6rpx 12rpx;
  border-radius:16rpx;
  background:#f3f3f3;
  font-size:26rpx;
  color:#333;
}
.sort-icon{
  margin-left:6rpx;
  font-size:24rpx;
  opacity:0.8;
}
.filter-left-group{
  display:flex;
  align-items:center;
  gap: 10rpx;              min-width: 0;
  flex: 1;
}

.filter-pill{
  display:flex;
  align-items:center;
  gap: 8rpx;
  padding: 6rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(0,0,0,0.06);
}

.filter-pill.active{
  background: rgba(242,160,115,0.22);
}

.pill-text{
  font-size: 28rpx;
  font-weight: 900;
  color: rgba(0,0,0,0.70);
}

.pill-caret{
  font-size: 26rpx;
  color: rgba(0,0,0,0.35);
}
.filter-left-group{
  flex-wrap: nowrap;
}

.filter-region{
  height: 56rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  flex-wrap: nowrap;
}

.region-text{
  white-space: nowrap;
  line-height: 56rpx;     }

.region-caret{
  line-height: 56rpx;     }
.filter-pill{
  display: inline-flex;
  align-items: center;
  height: 56rpx;
  padding: 0 12rpx;
  box-sizing: border-box;
}

.pill-text{
  white-space: nowrap;
  line-height: 56rpx;
}
