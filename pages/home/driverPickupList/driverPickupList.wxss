/* pages/home/driverPickupList/driverPickupList.wxss */

/* ✅ 页面底色：米色（不影响 nav-bar / filter-bar 的白色） */
page {
  background: #F6F1ED;
}

/* 顶部导航栏（背景色保持不变） */
.nav-bar {
  width: 100%;
  background-color: #ffffff;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
}

.back-icon {
  width: 50rpx;
  height: 50rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}

/* ✅ 页面主体容器背景：米色（原来是 #f5f5f5） */
.container {
  min-height: 100vh;
  background: #F6F1ED;
}

/* 顶部筛选栏（背景色保持不变） */
.filter-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #ffffff; /* ✅ 保持白色 */
  border-bottom: 1px solid #f5f5f5;
  font-size: 24rpx;
}

.filter-item {
  flex: 1;
}

.filter-spacer {
  width: 24rpx;
}

.filter-pill {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background-color: #f5f5f5;
  text-align: center;
}

/* ✅ 重置按钮：加粗 + 文字阴影（背景不改） */
.filter-reset {
  margin-left: 16rpx;
  font-size: 26rpx;
  font-weight: 800; /* ✅ 加粗 */
  color: #ff0000;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.25); /* ✅ 字体阴影 */
}

.state-text {
  padding: 40rpx 24rpx;
  color: #666;
  font-size: 28rpx;
  text-align: center;
}

/* 日期小标题 */
.date-header {
  padding: 24rpx 24rpx 8rpx;
}

.date-header-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}

/* 行程卡片 */
.trip-card {
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.05);
  padding: 20rpx 24rpx;
  margin: 8rpx 20rpx 20rpx;
}

.trip-main-row {
  display: flex;
  align-items: center;
}

.place-text-left,
.place-text-right {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #111;
}

.place-text-left {
  text-align: left;
}
.place-text-right {
  text-align: right;
}

.arrow-text {
  width: 80rpx;
  text-align: center;
  font-size: 32rpx;
  margin: 0;
}

.trip-sub-row {
  margin-top: 12rpx;
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
}

.trip-sub-row2 {
  margin-top: 8rpx;
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  color: #666;
}

.seat-text {
  color: #ff8c00;
}

.price-text {
  color: #333;
}

.status-text {
  color: #999;
}

/* 备注行 */
.comment-row {
  margin-top: 10rpx;
}

.comment-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.4;
}

/* ========= 横排 Toast ========= */
.toast-bar {
  position: fixed;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  max-width: 80%;
  padding: 16rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.85);
  color: #fff;
  display: flex;
  align-items: center;
  z-index: 999;
  font-size: 26rpx;
  line-height: 1.4;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.toast-icon {
  margin-right: 12rpx;
  font-size: 30rpx;
}

.toast-text {
  flex: 1;
  word-break: break-all;
}
