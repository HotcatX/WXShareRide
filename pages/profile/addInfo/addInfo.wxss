.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

.form-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 60rpx; }

.form-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin-bottom: 40rpx;  }

.label {
  width: 150rpx;
  font-size: 28rpx;
  color: #555;
  line-height: 80rpx;   }

.field-row {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 20rpx;
}

.field-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.input {
  flex: 1;
  height: 80rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  border: 1rpx solid #dddddd;
  font-size: 28rpx;
  background-color: #fafafa;
  box-sizing: border-box;
}

.picker {
  width: 150rpx;
}

.picker-inner {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  border: 1rpx solid #dddddd;
  font-size: 28rpx;
  background-color: #ffffff;
  box-sizing: border-box;
}

.buttons {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 10rpx;
}

.btn {
  width: 90%;
  max-width: 650rpx;
  padding: 14rpx 0;      border-radius: 999rpx; font-size: 30rpx;
}

.main-btn {
  background-color: #07c160;
  color: white;
}

.header {
  display:flex;
  align-items:center;
  height:80rpx;
  padding:0 20rpx;
}

.title {
  flex:1;
  text-align:center;
  font-size:40rpx;
  font-weight:bold;
}

.nav-bar {
  width: 100%;
  background-color: #ffffff;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
}

.avatar-section {
  margin-top: 40rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-wrapper {
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  box-shadow: none;
  display: inline-block;
}

.avatar-wrapper::after {
  border: none;
}

.avatar-border {
  width: 180rpx;          height: 180rpx;
  border-radius: 16rpx;   border: 2rpx solid #dddddd;   overflow: hidden;       box-sizing: border-box; }

.avatar {
  width: 100%;
  height: 100%;
  display: block;         border: none;
  background-color: transparent;
}


.avatar-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #888;
}

.header {
  display:flex;
  align-items:center;
  height:80rpx;
  padding:0 20rpx;
}

.title {
  flex:1;
  text-align:center;
  font-size:40rpx;
  font-weight:bold;
}

.nav-bar {
  width: 100%;
  background-color: #ffffff;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}

