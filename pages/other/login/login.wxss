.login-container {
  min-height: 100vh;
  background: #f4f6f8;
  box-sizing: border-box;
}

.login-shell {
  height: auto;
  min-height: 100vh;
  overflow: visible;
  padding: 64rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  justify-content: center;
  box-sizing: border-box;
}

.login-card {
  width: 100%;
  max-width: 640rpx;
  margin: 0 auto;
  padding: 32rpx 28rpx 26rpx;
}

.login-head {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}

.login-chip {
  height: 46rpx;
  padding: 0 14rpx;
  font-size: 22rpx;
  line-height: 28rpx;
}

.login-title {
  margin-top: 2rpx;
  color: #111418;
  font-size: 40rpx;
  line-height: 48rpx;
  font-weight: 900;
  letter-spacing: 0;
}

.login-subtitle {
  color: #69727d;
  font-size: 25rpx;
  line-height: 34rpx;
  font-weight: 700;
}

.login-actions {
  margin-top: 34rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.login-button {
  flex: none;
  width: 100%;
  margin: 0;
}

.login-button[disabled] {
  opacity: 1;
}

.login-button[disabled]::after {
  border: none;
}

.login-meta {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.login-mini-chip {
  flex: none;
  height: 46rpx;
  padding: 0 14rpx;
  color: #59636f;
  font-size: 22rpx;
  line-height: 28rpx;
  font-weight: 800;
}

.privacy-footer {
  margin-top: 28rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(20,23,26,0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 6rpx;
  color: #69727d;
  font-size: 23rpx;
  line-height: 32rpx;
  font-weight: 700;
  text-align: center;
}

.privacy-link {
  color: #111418;
  font-weight: 900;
}
