page {
  background: #f4f6f8;
}

.privacy-page {
  background: #f4f6f8;
  padding: 34rpx 24rpx calc(env(safe-area-inset-bottom) + 52rpx);
}

.privacy-container {
  width: 100%;
  max-width: 690rpx;
  margin: 0 auto;
  box-sizing: border-box;
}

.privacy-header {
  padding: 4rpx 4rpx 22rpx;
  box-sizing: border-box;
}

.privacy-title {
  display: block;
}

.privacy-meta {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.privacy-updated {
  height: 48rpx;
  padding: 0 18rpx;
}

.privacy-intro {
  display: block;
  margin-top: 22rpx;
  font-size: 28rpx;
  line-height: 48rpx;
  font-weight: 600;
  color: #3d4650;
}

.privacy-contract {
  flex: none;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 28rpx 0 0;
  border-radius: 18rpx;
  font-size: 29rpx;
}

.privacy-content {
  margin-top: 10rpx;
}

.privacy-section {
  padding: 24rpx 24rpx 22rpx;
}

.privacy-section + .privacy-section {
  margin-top: 16rpx;
}

.privacy-section-head {
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(20,23,26,0.06);
}

.privacy-section-title {
  display: block;
}

.privacy-lines {
  padding-top: 4rpx;
}

.privacy-line {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-top: 18rpx;
}

.privacy-marker {
  flex: none;
  width: 12rpx;
  height: 12rpx;
  margin-top: 18rpx;
  border-radius: 50%;
  background: #0f9b95;
  box-shadow: 0 0 0 6rpx rgba(15,155,149,0.10);
}

.privacy-line-text {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  line-height: 48rpx;
  font-weight: 500;
  color: #34404a;
  word-break: break-word;
}
