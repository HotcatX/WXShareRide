page{
  background: #f4f6f8;
}

.history-ride{
  background: #f4f6f8;
}

.history-scroll{
  padding-top: 14rpx;
}

.history-card{
  margin-bottom: 14rpx;
  padding: 24rpx;
}
.history-card-head,.history-card-caption,.history-question-row,.history-answer-actions,.history-stars{display:flex;align-items:center;}
.history-card-head,.history-question-row{justify-content:space-between;gap:16rpx;}
.history-card-caption{gap:12rpx;min-width:0;flex-wrap:wrap;}
.history-kind,.history-time{font-size:23rpx;color:#7b8794;line-height:1.5;}
.history-role{flex-shrink:0;font-size:22rpx;line-height:34rpx;padding:2rpx 12rpx;border-radius:9rpx;font-weight:600;}
.history-role--driver{background:#e0f2f1;color:#087f7b;}
.history-role--passenger{background:#e9edff;color:#5465b6;}
.history-role--unknown{background:#edf0f3;color:#687484;}
.history-status{font-size:21rpx;line-height:30rpx;}
.history-status--pending{color:#b87815;}
.history-status--rating{color:#5270bb;}
.history-status--done{color:#16837a;}
.history-route{display:flex;align-items:center;gap:14rpx;margin:18rpx 0 5rpx;min-width:0;}
.history-route-name{min-width:0;flex:1;font-size:30rpx;font-weight:600;line-height:1.5;color:#25313d;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.history-route-arrow{flex-shrink:0;color:#0b9993;font-size:30rpx;}
.history-time{display:block;}
.history-feedback{border-top:1rpx solid #edf0f3;margin-top:18rpx;padding-top:17rpx;}
.history-question-copy{min-width:0;flex:1;}
.history-question{display:block;font-size:26rpx;font-weight:600;line-height:1.5;color:#354551;}
.history-hint{display:block;margin-top:4rpx;font-size:21rpx;color:#88939d;line-height:1.5;}
.history-answer-actions{gap:10rpx;flex-shrink:0;}
.history-answer{margin:0;padding:0;width:76rpx;min-width:76rpx;line-height:62rpx;border-radius:13rpx;background:#f0f3f5;color:#687784;font-size:26rpx;font-weight:600;}
.history-answer--yes{background:#e7f5f3;color:#087f79;}
.history-answer.history-answer--selected{background:#0c9189;color:#fff;}
.history-answer::after,.history-star::after{border:none;}
.history-answer[disabled]{opacity:.55;}
.history-rating{display:flex;justify-content:space-between;align-items:center;gap:12rpx;margin-top:16rpx;animation:history-reveal .22s ease-out;}
.history-rating-title{font-size:24rpx;color:#647481;line-height:1.5;}
.history-stars{flex-shrink:0;gap:2rpx;}
.history-star{margin:0;padding:0;width:46rpx;line-height:58rpx;background:transparent!important;color:#e0ae4b;font-size:42rpx;font-weight:400;}
.history-star--selected,.history-star[disabled]{color:#e0ae4b;}
.history-feedback-error{display:block;margin-top:10rpx;font-size:23rpx;line-height:1.5;color:#b45a36;}
.history-retry{margin:8rpx 0 0;padding:0;background:transparent;color:#087f79;line-height:48rpx;font-size:24rpx;text-align:left;}
.history-retry::after{border:none;}
.history-thanks{position:fixed;left:50%;transform:translateX(-50%);z-index:100;pointer-events:none;padding:12rpx 28rpx;background:#e0f4ec;border-radius:24rpx;color:#16785c;font-size:24rpx;box-shadow:0 4rpx 16rpx rgba(15,70,55,.08);}
.history-card--saved{animation:history-saved .45s ease-out;}
@keyframes history-reveal{from{opacity:0;transform:translateY(6rpx);}to{opacity:1;transform:translateY(0);}}
@keyframes history-saved{0%{box-shadow:0 0 0 2rpx rgba(12,145,137,.3);}100%{box-shadow:0 0 0 8rpx rgba(12,145,137,0);}}
