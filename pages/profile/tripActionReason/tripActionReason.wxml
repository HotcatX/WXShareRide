<view class="ride-shell reason-page">
  <view class="ride-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar ride-topbar--center">
      <view class="ride-back" bindtap="goBack" hover-class="ride-pressed" hover-stay-time="80">
        <image class="ride-back-icon" src="/images/back.png" mode="aspectFit" />
      </view>
      <text class="ride-nav-title">{{pageTitle}}</text>
    </view>
  </view>

  <scroll-view class="reason-scroll" scroll-y enhanced="true" show-scrollbar="{{false}}">

    <view class="ride-card reason-card">
      <view class="reason-section-head">
        <text class="ride-section-title">选择原因</text>
        <text class="ride-section-subtitle">单选</text>
      </view>

      <view class="reason-list">
        <view
          wx:for="{{reasons}}"
          wx:key="index"
          class="reason-option {{selectedReason === item ? 'reason-option--active' : ''}}"
          data-reason="{{item}}"
          bindtap="onSelectReason"
        >
          <view class="reason-radio">
            <view wx:if="{{selectedReason === item}}" class="reason-radio-dot"></view>
          </view>
          <text class="reason-option-text">{{item}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{selectedReason === '其他'}}" class="ride-card reason-card">
      <view class="reason-section-head">
        <text class="ride-section-title">补充说明</text>
        <text class="ride-section-subtitle">必填</text>
      </view>

      <textarea
        class="reason-textarea"
        value="{{otherReason}}"
        placeholder="请填写具体原因"
        maxlength="120"
        auto-height="{{false}}"
        bindinput="onOtherReasonInput"
      />

      <view class="reason-count">
        {{otherReason.length || 0}} / 120
      </view>
    </view>

    <view class="reason-bottom-space"></view>
  </scroll-view>

  <view class="ride-bottom reason-bottom">
    <button class="ride-btn ride-btn--secondary" bindtap="goBack">
      取消
    </button>
    <button
      class="ride-btn {{submitting ? 'ride-btn--disabled' : 'ride-btn--danger'}}"
      disabled="{{submitting}}"
      bindtap="onSubmit"
    >
      {{submitting ? '提交中...' : confirmText}}
    </button>
  </view>
</view>