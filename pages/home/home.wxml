<view class="ride-shell home-ride">
  <view class="ride-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar" style="{{homeTopbarStyle}}">
      <!-- <view
        class="home-city-entry"
        bindtap="onTapCity"
        hover-class="ride-pressed"
        hover-stay-time="80"
      >
        <text class="home-city-text">{{activeCityLabel}}</text>
        <text class="home-city-caret">⌄</text>
      </view> -->
      <view class="ride-brand">
        <text class="ride-kicker">Campus rides</text>
        <text class="ride-title">{{pageTitle}}</text>
      </view>

      <!-- <view class="ride-actions">
        <view
          class="ride-action {{isLoggedIn ? 'ride-action--light home-login-done' : 'ride-action--dark'}}"
          hover-class="ride-pressed"
          hover-stay-time="80"
          bindtap="onTapLoginBtn"
        >{{isLoggedIn ? '已登录' : '登录'}}</view>
      </view> -->
    </view>
  </view>

  <scroll-view
    class="ride-scroll home-scroll"
    scroll-y
    enhanced="true"
    show-scrollbar="{{false}}"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refresherTriggered}}"
    refresher-background="#f4f6f8"
    bindrefresherrefresh="onHomeRefresherRefresh"
  >
    <block wx:if="{{isRideServiceAvailable}}">
    <view class="home-service-grid">
      <view class="home-service ride-card" bindtap="goNewTrip" hover-class="ride-card-pressed" hover-stay-time="80">
        <view class="home-service-icon-slot">
          <image class="home-service-icon-img" src="/images/post_trip.png" mode="aspectFit" />
        </view>
        <view class="home-service-title-slot">
          <text class="home-service-title">发起路线</text>
        </view>
        <!-- <view class="home-service-desc-slot">
          <text class="home-service-desc">司机发车/乘客求车</text>
        </view> -->
      </view>

      <view class="home-service ride-card" bindtap="goCarpoolList" hover-class="ride-card-pressed" hover-stay-time="80">
        <view class="home-service-icon-slot">
          <image
            class="home-service-icon-img home-service-icon-share"
            src="/images/share_ride.png"
            mode="aspectFit"
          />
        </view>
        <view class="home-service-title-slot">
          <text class="home-service-title">加入路线</text>
        </view>
        <!-- <view class="home-service-desc-slot">
          <text class="home-service-desc">加入已有路线</text>
        </view> -->
      </view>
    </view>

    <view class="home-section">
      <view class="ride-row-between home-section-head">
        <view>
          <text class="ride-section-title">我的创建</text>
        </view>
          <view
            wx:if="{{createTrips.length > 0}}"
            class="ride-chip home-toggle-chip {{expandedSection === 'create' ? 'home-toggle-chip--close' : 'home-toggle-chip--open'}}"
            bindtap="onToggleSection"
            data-key="create"
            hover-class="ride-pressed"
            hover-stay-time="80"
          >{{expandedSection === 'create' ? '收起' : '展开'}}</view>
      </view>

      <view class="home-trip-list {{expandedSection === 'create' ? 'home-trip-list--open' : ''}}">
        <view wx:if="{{createTrips.length === 0}}" class="ride-state home-inline-state">
          {{loading ? '正在同步' : '暂无创建的路线'}}
        </view>

        <block wx:else>
          <view
            wx:for="{{createShow}}"
            wx:key="_id"
            class="ride-card ride-list-card home-trip-card"
            bindtap="goUnifiedTripDetail"
            data-tripid="{{item._id}}"
            data-role="{{item.role}}"
            data-from="{{item.from}}"
            hover-class="ride-card-pressed"
            hover-stay-time="80"
          >
            <view class="ride-list-head">
              <view class="home-kind-row">
                <text class="ride-list-kind">{{item.from === 'request' ? '求车请求' : '发车路线'}}</text>
                <text wx:if="{{item._priceText}}" class="ride-chip home-price-chip">{{item._priceText}}</text>
              </view>
              <text class="ride-list-time"> {{item._timeLabel || '待定'}}</text>
            </view>
            <view class="home-route-inline">
              <view class="home-route-main">
                <view class="home-route-place">
                  <!-- <text class="ride-route-label">出发</text> -->
                  <text class="ride-route-name">{{item._fromAddress}}</text>
                </view>
                <text class="home-route-arrow">→</text>
                <view class="home-route-place">
                  <!-- <text class="ride-route-label">到达</text> -->
                  <text class="ride-route-name">{{item._toAddress}}</text>
                </view>
              </view>
              <view class="home-route-side">
                <text class="ride-chip ride-chip--accent home-seat-chip">{{item._seatText}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="home-section">
      <view class="ride-row-between home-section-head">
        <view>
          <text class="ride-section-title">我的加入</text>
        </view>
          <view
            wx:if="{{joinTrips.length > 0}}"
            class="ride-chip home-toggle-chip {{expandedSection === 'join' ? 'home-toggle-chip--close' : 'home-toggle-chip--open'}}"
            bindtap="onToggleSection"
            data-key="join"
            hover-class="ride-pressed"
            hover-stay-time="80"
          >{{expandedSection === 'join' ? '收起' : '展开'}}</view>
      </view>

      <view class="home-trip-list {{expandedSection === 'join' ? 'home-trip-list--open' : ''}}">
        <view wx:if="{{joinTrips.length === 0}}" class="ride-state home-inline-state">
          {{loading ? '正在同步' : '暂无加入行程计划'}}
        </view>

        <block wx:else>
          <view
            wx:for="{{joinShow}}"
            wx:key="_id"
            class="ride-card ride-list-card home-trip-card"
            bindtap="goUnifiedTripDetail"
            data-tripid="{{item._id}}"
            data-role="{{item.role}}"
            data-from="{{item.from}}"
            hover-class="ride-card-pressed"
            hover-stay-time="80"
          >
            <view class="ride-list-head">
              <view class="home-kind-row">
                <text class="ride-list-kind">{{item.from === 'request' ? '乘客路线' : '司机路线'}}</text>
                <text wx:if="{{item._priceText}}" class="ride-chip home-price-chip">{{item._priceText}}</text>
              </view>
              <text class="ride-list-time"> {{item._timeLabel || '待定'}}</text>
            </view>
            <view class="home-route-inline">
              <view class="home-route-main">
                <view class="home-route-place">
                  <!-- <text class="ride-route-label">出发</text> -->
                  <text class="ride-route-name">{{item._fromAddress}}</text>
                </view>
                <text class="home-route-arrow">→</text>
                <view class="home-route-place">
                  <!-- <text class="ride-route-label">到达</text> -->
                  <text class="ride-route-name">{{item._toAddress}}</text>
                </view>
              </view>
              <view class="home-route-side">
                <text class="ride-chip ride-chip--accent home-seat-chip">{{item._seatText}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="home-section">
      <view class="ride-row-between home-section-head">
        <text class="ride-section-title">社区数据</text>
        <text class="ride-section-subtitle">实时同步</text>
      </view>
      <view class="home-stats ride-card ride-card-pad">
        <view class="home-stat-main">
          <text class="home-stat-label">累计已服务</text>
          <view class="home-stat-number-row">
            <text class="home-stat-number">{{publicStats.servedTripsText}}</text>
            <text wx:if="{{publicStats.hasServedTrips}}" class="home-stat-unit">人次</text>
          </view>
          <text class="home-stat-subtitle">成功加入</text>
        </view>
        <view class="home-stat-side">
          <view class="ride-chip ride-chip--accent">{{publicStats.coverageText}}</view>
          <view class="ride-chip">{{publicStats.lastSyncText}}</view>
        </view>
      </view>
    </view>

    <text class="home-refresh-tip">下拉刷新</text>
    </block>

    <view wx:else class="ride-card ride-card-pad ride-unavailable-card">
      <text class="ride-unavailable-title">{{activeCityLabel}} 暂无服务</text>
      <text class="ride-unavailable-desc">目前只服务纽约/新泽西区域。你可以提交区域需求，我们会按请求量优先评估开通。</text>
      <view
        class="ride-unavailable-button {{rideDemandRequested ? 'is-done' : ''}}"
        bindtap="onRequestRideCityService"
        hover-class="ride-pressed"
        hover-stay-time="80"
      >
        {{rideDemandRequested ? '已收到请求' : (rideDemandSubmitting ? '提交中...' : '请求增加该区域')}}
      </view>
    </view>

    <view class="ride-bottom-space"></view>
  </scroll-view>
  <view wx:if="{{cityPickerVisible}}">
    <view class="city-mask" bindtap="onCityPickerCancel"></view>

    <view class="city-panel" catchtouchmove="stopTouchMove">
      <view class="city-header">
        <text class="city-title">选择城市</text>
        <text class="city-close" bindtap="onCityPickerCancel" hover-class="ride-pressed" hover-stay-time="80">关闭</text>
      </view>

      <view class="city-search-wrap">
        <input
          class="city-search-input"
          placeholder="搜索城市名称"
          placeholder-class="city-search-placeholder"
          value="{{citySearchKeyword}}"
          bindinput="onCitySearchInput"
          confirm-type="search"
        />
      </view>

      <view class="city-body">
        <scroll-view class="city-country-tabs" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
          <view
            class="city-country {{item.className}}"
            wx:for="{{cityCountryTabs}}"
            wx:key="code"
            data-code="{{item.code}}"
            bindtap="onSelectCityCountry"
            hover-class="ride-pressed"
            hover-stay-time="80"
          >
            {{item.label}}
          </view>
        </scroll-view>

        <scroll-view class="city-group-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
          <view class="city-group" wx:for="{{cityPickerGroups}}" wx:key="title">
            <view class="city-group-title">
              <text wx:if="{{item.badge}}" class="city-hot-badge">{{item.badge}}</text>
              <text>{{item.title}}</text>
            </view>
            <view class="city-grid">
              <view
                class="city-option {{city.className}}"
                wx:for="{{item.cities}}"
                wx:for-item="city"
                wx:key="key"
                data-key="{{city.key}}"
                bindtap="onSelectCity"
                hover-class="ride-pressed"
                hover-stay-time="80"
              >
                {{city.label}}
              </view>
            </view>
          </view>
          <view wx:if="{{!cityPickerHasResults}}" class="city-empty">{{cityPickerEmptyText}}</view>
          <view class="city-picker-hint">{{cityPickerHintText}}</view>
        </scroll-view>
      </view>
    </view>
  </view>
  <app-tabbar active="home" market-badge="{{customTabMarketBadge}}" profile-badge="{{customTabProfileBadge}}"></app-tabbar>
</view>
