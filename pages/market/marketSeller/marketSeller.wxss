.page{
  height: 100vh;
  background: #fff;
}

.header {
  display:flex;
  align-items:center;
  height:80rpx;
  padding:0 20rpx;
}
.back-icon {
  width: 50rpx;
  height: 50rpx;
}
.title {
  flex:1;
  text-align:center;
  font-size:40rpx;
  font-weight:bold;
}

.nav-bar {
  width: 100%;
  background-color: #ffffff;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  position: relative;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 600;
  color: #111;
}

.content{
  height: calc(100vh - 44px);
  padding: 18rpx 22rpx 0 22rpx;
  box-sizing: border-box;
}

.seller-card{
  display:flex;
  gap: 18rpx;
  padding: 18rpx;
  border: 2rpx solid rgba(0,0,0,0.12);
  border-radius: 14rpx;
  background:#fff;
}

.avatar-wrap{
  width: 140rpx;
  height: 140rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(0,0,0,0.12);
  display:flex;
  align-items:center;
  justify-content:center;
  overflow: hidden;
}

.avatar-img{
  width: 100%;
  height: 100%;
  border-radius: 999rpx;
}

.avatar-fallback{
  font-size: 60rpx;
}

.seller-info .row{
  font-size: 28rpx;
  line-height: 1.6;
}
.k{
  font-weight: 800;
  color:#111;
}
.v{
  color:#111;
}

.bio{
  margin-top: 14rpx;
  color: rgba(0,0,0,0.55);
  font-size: 26rpx;
  font-weight: 700;
}

.divider{
  margin: 18rpx 0;
  height: 2rpx;
  background: rgba(0,0,0,0.10);
}

.section-title{
  font-size: 28rpx;
  font-weight: 900;
  color:#111;
  margin-bottom: 12rpx;
}

.goods-grid{
  display:grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.goods-card{
  border: 2rpx solid rgba(0,0,0,0.10);
  border-radius: 12rpx;
  overflow:hidden;
  background:#fff;
}
.thumb{
  width: 100%;
  height: 180rpx;
  background:#f6f6f6;
}
.text-thumb{
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx;
  box-sizing: border-box;
  background: #eef3e5;
  color: #111;
  text-align: center;
}
.text-thumb text{
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.2;
  word-break: break-all;
}
.goods-label{
  padding: 12rpx;
  font-size: 26rpx;
  font-weight: 900;
  color:#111;
}

.empty{
  margin-top: 30rpx;
  text-align:center;
  color: rgba(0,0,0,0.45);
  font-size: 26rpx;
  font-weight: 700;
}

.bottom-space{ height: 140rpx; }

.bottom-fixed{
  position: fixed;
  left:0;
  right:0;
  bottom: 0;
  padding: 12rpx 22rpx 16rpx 22rpx;
  background:#fff;
  border-top: 2rpx solid rgba(0,0,0,0.10);
  box-sizing: border-box;
}
.contact-btn{
  width: 100%;
  height: 96rpx;
  border-radius: 18rpx;
  background: #EE9C73;
  color:#fff;
  font-size: 36rpx;
  font-weight: 900;
  display:flex;
  align-items:center;
  justify-content:center;
}
.page{
  height: 100vh;
  background: #F6EFE8; }

.nav-bar {
  width: 100%;
  background-color: #EE9C73; }

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: 900; color: #111;
}
.bottom-space{
  height: calc(130rpx + env(safe-area-inset-bottom));
}

.bottom-fixed{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;

  background: #ffffff; border-top: 2rpx solid rgba(0,0,0,0.08);
  box-sizing: border-box;
}

.bottom-bar{
  height: 130rpx;
  box-sizing: border-box;

  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-btn{
  width: 100%;
  height: 96rpx;
  border-radius: 999rpx;
  background: #EE9C73;
  color: #fff;

  font-size: 36rpx;
  font-weight: 900;

  display: flex;
  align-items: center;
  justify-content: center;

  box-shadow: 3rpx 6rpx 2rpx 0 rgba(0,0,0,0.25);
}
