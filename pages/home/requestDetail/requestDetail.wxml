<view class="ride-shell request-ride">
  <view class="ride-top" style="padding-top: {{statusBarHeight}}px;">
    <view class="ride-topbar ride-topbar--center">
      <view class="ride-back" bindtap="goBack" hover-class="ride-pressed" hover-stay-time="80">
        <image class="ride-back-icon" src="/images/back.png" mode="aspectFit" />
      </view>
      <text class="ride-nav-title">{{pageTitle}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="ride-state">正在加载路线</view>

  <view wx:elif="{{loadError}}" class="ride-state">
    <text class="ride-state-title">{{loadError}}</text>
    <button class="ride-state-action" bindtap="goBack">返回</button>
  </view>

  <scroll-view wx:else class="ride-scroll request-scroll" scroll-y enhanced="true" show-scrollbar="{{false}}">
    <view wx:if="{{toastVisible}}" class="request-toast {{toastType}}">
      <text class="request-toast-icon">{{toastIcon}}</text>
      <text class="request-toast-text">{{toastText}}</text>
    </view>

    <view class="ride-card ride-card-pad request-hero">
      <view class="ride-row-between request-hero-head">
        <text class="ride-list-kind">乘客求车</text>
        <text class="ride-chip ride-chip--accent">余位 {{seatLeft}}</text>
      </view>

      <view class="ride-route">
        <view class="ride-route-rail">
          <view class="ride-dot"></view>
          <view class="ride-line"></view>
          <view class="ride-dot ride-dot--accent"></view>
        </view>
        <view class="ride-route-body">
          <view class="ride-route-point">
            <text class="ride-route-label">出发</text>
            <text class="ride-route-name">{{departAddress || '出发地未设置'}}</text>
          </view>
          <view class="ride-route-point">
            <text class="ride-route-label">到达</text>
            <text class="ride-route-name">{{destAddress || '目的地未设置'}}</text>
          </view>
        </view>
      </view>

      <view class="ride-meta">
        <text class="ride-chip ride-chip--dark">{{formattedDepartTime || '时间待定'}}</text>
        <text class="ride-chip ride-chip--warn">{{trip.referencePrice || trip.price || '价格待定'}}</text>
      </view>
    </view>

    <view class="ride-card ride-notice">
      <text class="ride-notice-title">拼车费用</text>
      <text class="ride-notice-text">拼车失败时一人支付全部费用；拼车成功后按同行人数共同平摊。</text>
    </view>

    <view class="ride-card ride-notice request-notice-muted">
      <text class="ride-notice-title">发布建议</text>
      <text class="ride-notice-text">优先查看拼车列表是否有合适路线。短距离可自行打车，长距离求车等待司机接单。</text>
    </view>

    <view class="ride-bottom-space ride-bottom-space--double"></view>
  </scroll-view>

  <view wx:if="{{!loading && !loadError}}" class="ride-bottom ride-bottom--stack">
    <button wx:if="{{isOwner}}" disabled="true" class="ride-btn ride-btn--disabled">
      无法接自己的求车
    </button>
    <button wx:elif="{{isAccepted && !acceptedByMe}}" disabled="true" class="ride-btn ride-btn--disabled">
      已被其他司机接单
    </button>
    <button wx:elif="{{acceptedByMe}}" disabled="true" class="ride-btn ride-btn--disabled">
      你已成为该路线司机
    </button>
    <button wx:elif="{{joinedByMe}}" disabled="true" class="ride-btn ride-btn--disabled">
      已作为乘客加入
    </button>
    <button
      wx:else
      class="ride-btn ride-btn--primary {{submittingDriver ? 'ride-btn--disabled' : ''}}"
      bindtap="acceptAsDriver"
      disabled="{{submittingDriver}}"
      loading="{{submittingDriver}}"
    >
      {{ submittingDriver ? '接单中' : '司机接单' }}
    </button>

    <button wx:if="{{isOwner}}" disabled="true" class="ride-btn ride-btn--disabled">
      无法加入自己创建的路线
    </button>
    <button wx:elif="{{acceptedByMe}}" disabled="true" class="ride-btn ride-btn--disabled">
      你已是该路线司机
    </button>
    <button wx:elif="{{isClosed}}" disabled="true" class="ride-btn ride-btn--disabled">
      该路线已结束
    </button>
    <button wx:elif="{{isFull && !joinedByMe}}" disabled="true" class="ride-btn ride-btn--disabled">
      该路线已满员
    </button>
    <button wx:elif="{{joinedByMe}}" disabled="true" class="ride-btn ride-btn--disabled">
      你已加入该路线
    </button>
    <button
      wx:else
      class="ride-btn ride-btn--accent {{submittingPassenger ? 'ride-btn--disabled' : ''}}"
      bindtap="joinAsPassenger"
      disabled="{{submittingPassenger}}"
      loading="{{submittingPassenger}}"
    >
      {{ submittingPassenger ? '加入中' : '乘客加入' }}
    </button>
  </view>
</view>
